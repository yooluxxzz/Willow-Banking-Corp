<%- include('partials/header') %>
<body class="account-overview-page wealth-page">
<div class="app-layout"><%- include('partials/sidebar') %><main class="main-content wealth-main goals-main">
    <header class="wealth-heading"><div><p class="wealth-kicker">WILLOW / PLANNING</p><h1>Give your next step a name.</h1><p>Keep personal targets in one place and update progress when you choose.</p></div><span class="wealth-demo-label">PLANNING TRACKER</span></header>
    <div class="wealth-disclosure" role="note">Goal targets and progress are planning notes you enter. They are not bank balances, are not verified against transactions, and do not move or reserve money.</div>
    <div class="goals-layout">
        <section class="wealth-panel goals-form-panel" aria-labelledby="goalFormTitle"><p class="wealth-kicker">START A PLAN</p><h2 id="goalFormTitle">Create a goal</h2>
            <form id="goalForm"><label for="goalName">Goal name</label><input id="goalName" name="name" maxlength="60" minlength="2" required placeholder="For example, a home deposit"><label for="goalCategory">Category</label><select id="goalCategory" name="category"><option value="savings">Build savings</option><option value="home">Buy a home</option><option value="travel">Travel</option><option value="business">Start a business</option><option value="investing">Investing</option><option value="other">Other</option></select><label for="goalTarget">Target amount · USD</label><input id="goalTarget" name="targetAmount" type="number" min="0.01" max="1000000000" step="0.01" required inputmode="decimal"><label for="goalCurrent">Current progress · USD</label><input id="goalCurrent" name="currentAmount" type="number" min="0" max="1000000000" step="0.01" value="0" inputmode="decimal"><button class="wealth-submit" type="submit">Save planning goal</button><p id="goalFormStatus" class="wealth-trade-message" role="status" aria-live="polite"></p></form>
        </section>
        <section class="wealth-panel goals-list-panel" aria-labelledby="goalsTitle"><div class="wealth-panel-heading"><div><p class="wealth-kicker">YOUR PLANS</p><h2 id="goalsTitle">Saved goals</h2></div><span id="goalCount" class="wealth-cash-label">Loading…</span></div><div id="goalList" class="goal-list" aria-live="polite"><p class="wealth-loading">Loading saved goals…</p></div></section>
    </div>
    <p class="wealth-footnote">Progress is self-reported and exists only in this demo. Connect a savings account separately if you want to review actual simulated account balances.</p>
</main></div><script src="/js/goals.js" defer></script><%- include('partials/footer') %>