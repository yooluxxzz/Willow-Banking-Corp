<%- include('partials/header') %>
<body class="banking-workspace">
<div class="app-layout">
    <%- include('partials/sidebar') %>
    <main class="main-content workspace-main"><p class="workspace-eyebrow">YOUR WILLOW / MOVE MONEY</p>
        <div class="page-header"><h1>Move money</h1><p>Between your accounts, or to another Willow demo customer.</p></div>
        <div class="money-workspace"><div class="card money-form-card"><div class="card-body">
            <p class="demo-notice">Demo transfer · Updates the simulated ledger only. No real money moves.</p>
            <div id="transferAlert" class="hidden" role="status" aria-live="polite"></div>
            <form id="transferForm">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="form-group"><label for="fromAccountId">From account</label><select id="fromAccountId" class="form-control" required>
                    <% accounts.filter(a => a.status === 'active').forEach(a => { %><option value="<%= a.id %>"><%= a.displayName %> (<%= a.maskedNumber %>) — available <%= a.availableBalanceFormatted %></option><% }) %>
                </select></div>
                <div class="form-group"><label for="transferKind">Destination</label><select id="transferKind" class="form-control"><option value="own">My other account</option><option value="customer">Another Willow customer</option></select></div>
                <div class="form-group" id="ownDestination"><label for="toAccountId">To account</label><select id="toAccountId" class="form-control" required>
                    <% accounts.filter(a => a.status === 'active').forEach(a => { %><option value="<%= a.id %>"><%= a.displayName %> (<%= a.maskedNumber %>)</option><% }) %>
                </select></div>
                <div class="form-group" id="customerDestination" hidden><label for="recipientEmail">Recipient email</label><input type="email" id="recipientEmail" class="form-control" placeholder="customer@example.com" maxlength="255" disabled></div>
                <div class="form-group"><label for="amount">Amount (USD)</label><input type="number" id="amount" class="form-control" placeholder="0.00" min="0.01" max="1000000000" step="0.01" required></div>
                <div class="form-group"><label for="description">Description (optional)</label><input type="text" id="description" class="form-control" maxlength="200"></div>
                <button type="submit" class="btn btn-primary btn-lg w-full">Review transfer</button>
            </form>
            <section id="transferReview" hidden aria-labelledby="reviewTitle" tabindex="-1">
                <h2 id="reviewTitle">Review your demo transfer</h2>
                <dl class="transfer-summary"><div><dt>From</dt><dd id="reviewFrom"></dd></div><div><dt>To</dt><dd id="reviewTo"></dd></div><div><dt>Amount</dt><dd id="reviewAmount"></dd></div><div><dt>Description</dt><dd id="reviewDescription"></dd></div></dl>
                <p class="form-help">Check the details before confirming. The server will validate funds and account access.</p>
                <div class="transfer-actions"><button id="editTransfer" type="button" class="btn btn-secondary">Edit details</button><button id="confirmTransfer" type="button" class="btn btn-primary">Confirm demo transfer</button></div>
            </section>
        </div></div>
    <aside class="money-guide"><p class="workspace-eyebrow">EVERYDAY BANKING, SIMPLIFIED</p><h2>A clear path from here to there.</h2><p>Choose your destination, check the amount, then review the details before confirming.</p><div class="money-guide-note"><span aria-hidden="true">◎</span><p>Transfers update your demo accounts only. No real money is sent.</p></div><a href="/accounts">Check your accounts <span aria-hidden="true">↗</span></a><a href="/transactions">See recent activity <span aria-hidden="true">↗</span></a></aside></div></main>
</div>
<script src="/js/transfers.js"></script>
<%- include('partials/footer') %>
