<%- include('../partials/app-start', { css: [] }) %>

<header class="page-head">
    <div class="page-head-copy">
        <p class="label">Administration</p>
        <h1 class="page-head-title">Admin overview</h1>
        <p class="page-head-sub">Customers, balances and the audit trail for this Willow demo instance. Every action here is logged.</p>
    </div>
</header>

<div class="stat-row mb-6" data-admin-stats>
    <div class="stat-tile"><span class="label"><%- icon('users', 'icon-sm') %> Customers</span><span class="figure" data-stat="totalCustomers">—</span><small data-stat-sub="suspendedAccounts">Registered profiles</small></div>
    <div class="stat-tile"><span class="label"><%- icon('wallet', 'icon-sm') %> Accounts</span><span class="figure" data-stat="totalAccounts">—</span><small>All currencies</small></div>
    <div class="stat-tile"><span class="label"><%- icon('banknote', 'icon-sm') %> Simulated balances</span><span class="figure" data-stat="totalBalanceFormatted">—</span><small>Active accounts, mixed currencies at face value</small></div>
    <div class="stat-tile"><span class="label"><%- icon('activity', 'icon-sm') %> Transactions</span><span class="figure" data-stat="totalTransactions">—</span><small data-stat-sub="failedTransactions">All time</small></div>
</div>

<div class="layout-main-aside">
    <div class="col-stack">
        <section class="panel" aria-labelledby="usersTitle">
            <div class="panel-head">
                <h2 id="usersTitle">Customers</h2>
                <form class="admin-search" data-user-search role="search">
                    <label class="visually-hidden" for="userSearch">Search customers</label>
                    <input class="input input-sm" id="userSearch" type="search" placeholder="Name, email or customer ID" maxlength="100">
                    <select class="select select-sm" id="userStatus" aria-label="Status"><option value="">Any status</option><option value="active">Active</option><option value="suspended">Suspended</option><option value="deleted">Deleted</option></select>
                </form>
            </div>
            <div data-users aria-live="polite"></div>
            <nav class="pagination" data-users-pages aria-label="Customer pages"></nav>
        </section>

        <section class="panel" aria-labelledby="auditTitle">
            <div class="panel-head">
                <h2 id="auditTitle">Audit log</h2>
                <select class="select select-sm" id="auditAction" aria-label="Filter by action">
                    <option value="">All actions</option>
                    <option value="login">Sign-ins</option>
                    <option value="register">Registrations</option>
                    <option value="transfer">Transfers</option>
                    <option value="balance_adjustment">Balance adjustments</option>
                    <option value="user_activated,user_suspended,user_deleted,user_deletion_scheduled,user_auto_deleted">Status changes</option>
                    <option value="password_changed,password_recovered">Password changes</option>
                    <option value="two_factor_enabled,two_factor_disabled">Two-step verification</option>
                    <option value="daily_checks_run">Daily checks run</option>
                    <option value="data_exported">Data exports</option>
                </select>
            </div>
            <div data-audit aria-live="polite"></div>
        </section>
    </div>

    <aside class="col-stack">
        <section class="panel" aria-labelledby="systemTitle">
            <div class="panel-head"><h2 id="systemTitle">System</h2><button type="button" class="btn btn-ghost btn-sm" data-system-refresh><%- icon('refresh', 'icon-sm') %> Refresh</button></div>
            <ul class="system-list" role="list" data-system aria-live="polite">
                <li><span class="icon-tile icon-tile-sm"><%- icon('chart') %></span><div><strong>Market data</strong><small data-system-market>Checking…</small></div></li>
                <li><span class="icon-tile icon-tile-sm"><%- icon('sparkle') %></span><div><strong>Ask Willow (Ollama)</strong><small data-system-assistant>Checking…</small></div></li>
                <li><span class="icon-tile icon-tile-sm"><%- icon('calendar') %></span><div><strong>Daily budget check</strong><small data-system-daily>Checking…</small></div></li>
            </ul>
            <div class="form-actions mt-4"><button type="button" class="btn btn-secondary btn-sm" data-run-daily><%- icon('refresh', 'icon-sm') %> Run daily checks now</button></div>
            <p class="form-status mt-3" data-daily-status role="status" hidden></p>
        </section>

        <form class="panel" id="adjustForm" novalidate>
            <div class="panel-head"><h2>Adjust a balance</h2><span class="sim-tag">Simulated</span></div>
            <div class="field"><label for="adjAccountId">Account ID or number</label><input class="input" id="adjAccountId" name="accountId" required placeholder="e.g. 12 or 4200…"></div>
            <div class="field-grid">
                <div class="field"><label for="adjAmount">Amount</label><input class="input num" id="adjAmount" name="amount" inputmode="decimal" required placeholder="0.00"></div>
                <div class="field"><label for="adjType">Action</label><select class="select" id="adjType" name="type"><option value="credit">Credit</option><option value="debit">Debit</option></select></div>
            </div>
            <div class="field"><label for="adjReason">Reason</label><input class="input" id="adjReason" name="reason" required maxlength="200" placeholder="Shown in the audit log"></div>
            <p class="form-status mt-3" data-adjust-status role="status" hidden></p>
            <div class="form-actions"><button type="submit" class="btn btn-primary">Review adjustment</button></div>
        </form>

        <section class="panel" aria-labelledby="recentTitle">
            <div class="panel-head"><h2 id="recentTitle">Latest transactions</h2></div>
            <div data-recent></div>
        </section>
    </aside>
</div>

<dialog class="modal is-wide" id="userDialog" aria-labelledby="userDialogTitle">
    <div class="modal-head"><h2 id="userDialogTitle">Customer</h2><button type="button" class="btn btn-ghost btn-icon" data-dialog-close aria-label="Close"><%- icon('x', 'icon-md') %></button></div>
    <div class="modal-body" data-user-body></div>
</dialog>

<%- include('../partials/app-end', { js: ['admin'] }) %>
