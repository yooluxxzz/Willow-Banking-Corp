<%- include('partials/header') %>

    <body class="public-page">
        <%- include('partials/public-nav') %>

            <main class="info-page">
                <div class="info-inner">
                    <h1>Transfers</h1>
                    <p class="info-sub">Send money to anyone with a Willow account instantly — no routing numbers, no
                        waiting, no fees.</p>

                    <section class="info-section">
                        <h2>How Willow Transfers Work</h2>
                        <p>Willow-to-Willow transfers are instant. All you need is the recipient's email address. Money
                            leaves your account and arrives in theirs in real time — whether it's splitting a bill,
                            paying a friend back, or moving funds between your own accounts.</p>
                    </section>

                    <section class="info-section">
                        <h2>Features &amp; Benefits</h2>
                        <div class="info-grid">
                            <div class="info-card">
                                <h3>Instant Settlement</h3>
                                <p>Transfers between Willow accounts settle immediately, 24 hours a day, 7 days a week.
                                </p>
                            </div>
                            <div class="info-card">
                                <h3>No Transfer Fees</h3>
                                <p>Every transfer between Willow accounts is completely free — no flat fee, no
                                    percentage taken.</p>
                            </div>
                            <div class="info-card">
                                <h3>Email-Based</h3>
                                <p>No need to know account numbers. Send to any Willow customer using just their email
                                    address.</p>
                            </div>
                            <div class="info-card">
                                <h3>Daily Limit of $25,000</h3>
                                <p>A generous $25,000 per day transfer limit to keep your account secure while remaining
                                    flexible.</p>
                            </div>
                            <div class="info-card">
                                <h3>Full Audit Trail</h3>
                                <p>Every transfer is logged with a unique reference number, visible in your transaction
                                    history.</p>
                            </div>
                            <div class="info-card">
                                <h3>Between Your Own Accounts</h3>
                                <p>Move money between your checking and savings accounts in seconds — all within the
                                    same dashboard.</p>
                            </div>
                        </div>
                    </section>

                    <section class="info-section">
                        <h2>Sending a Transfer</h2>
                        <div class="timeline">
                            <div class="timeline-item">
                                <span class="timeline-year">Step 1</span>
                                <div>
                                    <h4>Choose your account</h4>
                                    <p>Select which of your accounts to send from — checking or savings.</p>
                                </div>
                            </div>
                            <div class="timeline-item">
                                <span class="timeline-year">Step 2</span>
                                <div>
                                    <h4>Enter recipient &amp; amount</h4>
                                    <p>Type the recipient's Willow email address and the amount you'd like to send.</p>
                                </div>
                            </div>
                            <div class="timeline-item">
                                <span class="timeline-year">Step 3</span>
                                <div>
                                    <h4>Confirm &amp; done</h4>
                                    <p>Review the details and confirm. The money arrives instantly in the recipient's
                                        account.</p>
                                </div>
                            </div>
                        </div>
                    </section>

                    <section class="info-cta">
                        <h2>Start sending money instantly</h2>
                        <p>Create a free Willow account to make your first transfer today.</p>
                        <a href="/register" class="btn btn-primary btn-lg">Create a Free Account</a>
                    </section>
                </div>
            </main>

            <%- include('partials/public-footer') %>
    </body>

    </html>