<%- include('partials/header') %>

    <body>
        <div class="app-layout">
            <%- include('partials/sidebar') %>
                <main class="main-content">
                    <div class="page-header">
                        <h1>Withdraw Funds</h1>
                        <p>Withdraw from your account (demo/fictional withdrawal)</p>
                    </div>
                    <div class="card max-w-480">
                        <div class="card-body">
                            <div id="withdrawAlert" class="hidden"></div>
                            <form id="withdrawForm" onsubmit="handleWithdraw(event)">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <div class="form-group">
                                    <label for="accountId">Account</label>
                                    <select id="accountId" name="accountId" class="form-control" required>
                                        <% accounts.forEach(a=> { %>
                                            <option value="<%= a.id %>">
                                                <%= a.account_type %> (<%= a.maskedNumber %>) — <%=
                                                            a.availableBalanceFormatted %> available
                                            </option>
                                            <% }) %>
                                    </select>
                                </div>
                                <div class="form-group">
                                    <label for="amount">Amount (USD)</label>
                                    <input type="number" id="amount" name="amount" class="form-control"
                                        placeholder="0.00" min="0.01" step="0.01" required>
                                </div>
                                <div class="form-group">
                                    <label for="description">Description <span
                                            class="text-muted">(optional)</span></label>
                                    <input type="text" id="description" name="description" class="form-control"
                                        placeholder="e.g. ATM withdrawal" maxlength="200">
                                </div>
                                <button type="submit" class="btn btn-primary btn-lg w-full" id="withdrawBtn">Withdraw
                                    Funds</button>
                            </form>
                        </div>
                    </div>
                </main>
        </div>
        <script>
            const csrfToken = '<%= csrfToken %>';
            async function handleWithdraw(e) {
                e.preventDefault();
                const amount = document.getElementById('amount').value;
                const confirmed = await showConfirm('Are you sure you want to withdraw $' + amount + '?', 'Confirm Withdrawal');
                if (!confirmed) {
                    return;
                }
                const btn = document.getElementById('withdrawBtn');
                const alert = document.getElementById('withdrawAlert');
                btn.disabled = true; btn.innerHTML = '<span class="spinner"></span> Processing...'; alert.className = 'hidden';
                try {
                    const res = await fetch('/api/withdrawals', {
                        method: 'POST', headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken },
                        body: JSON.stringify({ accountId: document.getElementById('accountId').value, amount: document.getElementById('amount').value, description: document.getElementById('description').value }),
                    });
                    const data = await res.json();
                    if (!res.ok) throw new Error(data.error);
                    alert.className = 'alert alert-success';
                    alert.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg><span>Withdrawal successful! Reference: <strong>' + data.reference + '</strong></span>';
                    document.getElementById('withdrawForm').reset();
                } catch (err) {
                    alert.className = 'alert alert-danger';
                    alert.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" x2="12" y1="8" y2="12"/><line x1="12" x2="12.01" y1="16" y2="16"/></svg><span>' + (err.message || 'Withdrawal failed.') + '</span>';
                } finally { btn.disabled = false; btn.textContent = 'Withdraw Funds'; }
            }
        </script>
        <%- include('partials/footer') %>