<%- include('partials/header') %>
<body class="account-overview-page wealth-page">
<div class="app-layout"><%- include('partials/sidebar') %><main class="main-content wealth-main">
    <header class="wealth-heading"><div><p class="wealth-kicker">WILLOW / BORROW</p><h1>Plan with a clearer estimate.</h1><p>Adjust an illustrative loan amount and term to see an estimated monthly payment.</p></div><span class="wealth-demo-label">ILLUSTRATIVE ONLY</span></header>
    <div class="wealth-disclosure" role="note">This calculator is an educational estimate, not a loan offer, approval decision, or quote. Willow does not provide lending through this demo.</div>
    <section class="loan-estimator" aria-labelledby="loanTitle"><div class="loan-controls"><p class="wealth-kicker">PERSONAL LOAN EXAMPLE</p><h2 id="loanTitle">Shape an estimate</h2>
        <label for="loanAmount">Amount</label><div class="loan-input-wrap"><span aria-hidden="true">$</span><input id="loanAmount" type="number" min="1000" max="100000" step="500" value="25000" inputmode="decimal"></div>
        <label for="loanTerm">Term <span id="loanTermLabel">36 months</span></label><input id="loanTerm" type="range" min="12" max="84" step="12" value="36">
        <label for="loanRate">Illustrative annual rate</label><div class="loan-input-wrap"><input id="loanRate" type="number" min="0.1" max="35" step="0.1" value="8.9" inputmode="decimal"><span>%</span></div>
    </div><div class="loan-result"><p class="wealth-kicker">ESTIMATED MONTHLY PAYMENT</p><p class="loan-payment" id="loanPayment" aria-live="polite">$0.00</p><p id="loanSummary">Based on the amount, term and illustrative rate selected.</p><dl><div><dt>Estimated total repayment</dt><dd id="loanTotal">—</dd></div><div><dt>Estimated interest</dt><dd id="loanInterest">—</dd></div></dl><a class="wealth-secondary-link" href="/help">Questions about this demo? Visit Help <span aria-hidden="true">↗</span></a></div></section>
    <p class="wealth-footnote">Fixed-rate amortization estimate only; excludes fees, eligibility, taxes and other costs. No application or credit check is performed.</p>
</main></div>
<script src="/js/loan-calculator.js" defer></script>
<%- include('partials/footer') %>