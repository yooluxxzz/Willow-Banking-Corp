<%- include('partials/header') %>

    <body>
        <div class="auth-page">
            <div class="auth-panel">
                <div class="auth-form-wrapper">
                    <a href="/" class="auth-brand" style="text-decoration:none;">
                        <img src="/images/logo.svg" alt="Willow" class="nav-logo-img">
                        Willow Banking Corp.
                    </a>
                    <h1>Welcome back</h1>
                    <p class="auth-sub">Sign in to access your accounts and manage your finances.</p>

                    <div id="loginError" class="alert alert-danger hidden">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"
                            stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10" />
                            <line x1="12" x2="12" y1="8" y2="12" />
                            <line x1="12" x2="12.01" y1="16" y2="16" />
                        </svg>
                        <span id="loginErrorText"></span>
                    </div>

                    <form id="loginForm" onsubmit="handleLogin(event)">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <div class="form-group">
                            <label for="email">Email Address</label>
                            <input type="email" id="email" name="email" class="form-control"
                                placeholder="name@example.com" required autocomplete="email">
                        </div>
                        <div class="form-group">
                            <label for="password">Password</label>
                            <input type="password" id="password" name="password" class="form-control"
                                placeholder="Enter your password" required autocomplete="current-password">
                        </div>
                        <button type="submit" class="btn btn-primary w-full btn-lg" id="loginBtn">Sign In</button>
                    </form>

                    <script>
                        (function () {
                            const params = new URLSearchParams(window.location.search);
                            const err = params.get('error');
                            if (err === 'account_suspended') {
                                const el = document.getElementById('loginError');
                                const text = document.getElementById('loginErrorText');
                                text.textContent = 'Your account has been suspended or is no longer active. Please contact support.';
                                el.classList.remove('hidden');
                            }
                        })();
                    </script>

                    <p class="auth-footer">
                        Don't have an account? <a href="/register">Create one</a>
                    </p>
                    <a href="/" class="auth-back">← Back to Home</a>
                </div>
            </div>
            <div class="auth-image-panel">
                <img src="https://images.unsplash.com/photo-1560472355-536de3962603?w=1200&q=80"
                    alt="Modern banking office"
                    onerror="this.parentElement.style.background='linear-gradient(135deg,var(--green-600),var(--green-700,#15803d))';this.style.display='none';">
                <div class="image-overlay">
                    <h2>Secure. Simple. Smart.</h2>
                    <p>Manage your finances with confidence through our intuitive, security-first banking platform.</p>
                </div>
            </div>
        </div>
        <%- include('partials/footer') %>