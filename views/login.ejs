<%- include('partials/header') %>

<body class="auth-experience-page">
    <a class="skip-link" href="#authMain">Skip to sign in</a>
    <div class="auth-layout">
        <aside class="auth-visual" aria-label="Willow banking campaign">
            <img src="https://images.unsplash.com/photo-1556742049-0cfed4f6a45d?auto=format&amp;fit=crop&amp;w=1200&amp;q=80" alt="" aria-hidden="true" fetchpriority="high" decoding="async">
            <div class="auth-visual-shade" aria-hidden="true"></div>
            <a class="auth-campaign-brand" href="/"><img src="/images/logo.svg" alt=""><span>Willow<span>Banking Corp.</span></span></a><div class="auth-visual-copy">
                <p class="auth-visual-kicker">Willow Banking Corp. <span>Personal banking</span></p>
                <p class="auth-visual-slogan">Steady for what's next.</p>
                <p>A considered place for everyday money and the plans you're building.</p>
            </div>
        <div class="auth-visual-foot"><span>Clarity for today. Room for tomorrow.</span><span>Willow / Demo experience</span></div></aside>

        <main class="auth-main" id="authMain">
            <div class="auth-topline">
                <a href="/" class="auth-brand">
                    <img src="/images/logo.svg" alt="" class="nav-logo-img">
                    <span>Willow Banking Corp.</span>
                </a>
                <a href="/" class="auth-back-link">Back to Willow</a>
            </div>

            <section class="auth-form-wrapper" aria-labelledby="loginTitle">
                <p class="auth-eyebrow">Your everyday, connected</p>
                <h1 id="loginTitle">Welcome back</h1>
                <p class="auth-sub">Sign in to continue to your Willow account.</p>

                <div id="loginStatus" class="auth-message auth-message-success" role="status" aria-live="polite" hidden></div>
                <div id="loginError" class="auth-message auth-message-error" role="alert" aria-live="assertive" tabindex="-1" hidden>
                    <span id="loginErrorText"></span>
                </div>

                <form id="loginForm" onsubmit="handleLogin(event)">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <div class="auth-field">
                        <label for="email">Email address</label>
                        <input type="email" id="email" name="email" class="form-control" placeholder="you@example.com" required autocomplete="email" autocapitalize="none" spellcheck="false">
                    </div>
                    <div class="auth-field">
                        <label for="password">Password</label>
                        <div class="auth-password-field">
                            <input type="password" id="password" name="password" class="form-control" placeholder="Enter your password" required autocomplete="current-password">
                            <button class="auth-password-toggle" type="button" data-password-toggle aria-controls="password" aria-label="Show password" aria-pressed="false" title="Show password">
                                <svg class="password-show-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg>
                                <svg class="password-hide-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 3 18 18M10.6 10.6a2 2 0 0 0 2.8 2.8"/><path d="M9.9 5.2A10.9 10.9 0 0 1 12 5c6.5 0 10 7 10 7a14.7 14.7 0 0 1-3.2 4.1M6.2 6.2C3.5 8 2 12 2 12s3.5 7 10 7c1.3 0 2.5-.3 3.5-.7"/></svg>
                            </button>
                        </div>
                    </div>
                    <div class="auth-form-options">
                        <a href="/forgot-password">Forgot your password?</a>
                    </div>
                    <button type="submit" class="auth-submit" id="loginBtn">Sign in</button>
                </form>

                <p class="auth-demo-note">Willow is a demonstration platform. Do not use a password you use elsewhere.</p>
                <p class="auth-switch">New to Willow? <a href="/register">Open an account</a></p>
            </section>

            <footer class="auth-bottomline">
                <a href="/contact">Help and support</a>
                <a href="/privacy">Privacy</a>
                <a href="/terms">Terms</a>
            </footer>
        </main>
    </div>

    <script>
        (function () {
            const params = new URLSearchParams(window.location.search);
            if (params.get('reset') === 'success') {
                const status = document.getElementById('loginStatus');
                status.textContent = 'Password reset. Sign in with your new password.'; status.hidden = false;
            }
            if (params.get('error') === 'session_expired') {
                document.getElementById('loginErrorText').textContent = 'Your session ended. Please sign in again.';
                document.getElementById('loginError').hidden = false;
            }
            if (params.get('error') !== 'account_suspended') return;
            const errorBox = document.getElementById('loginError');
            document.getElementById('loginErrorText').textContent = 'We can’t sign you in right now. Please contact support.';
            errorBox.hidden = false;
        })();
    </script>
    <%- include('partials/footer') %>