<%- include('partials/header') %>
<body class="account-overview-page wealth-page">
<div class="app-layout">
    <%- include('partials/sidebar') %>
    <main class="main-content wealth-main" id="main-content">
        <header class="wealth-heading">
            <div><p class="wealth-kicker">WILLOW / WEALTH</p><h1>Markets, with perspective.</h1><p>Explore market data and track a portfolio funded only with simulated cash.</p></div>
            <span class="wealth-demo-label">DEMO · NOT A BROKERAGE</span>
        </header>
        <div class="wealth-disclosure" role="note">Market quotes are provided for demonstration and may be delayed. Orders are simulated only. No real securities or crypto are purchased.</div>
        <section class="wealth-market-strip" aria-label="Market indices" id="marketIndices"><div class="wealth-loading">Loading market data…</div></section>
        <div class="wealth-layout">
            <section class="wealth-primary">
                <section class="wealth-panel wealth-market-panel" aria-labelledby="marketTitle">
                    <div class="wealth-panel-heading"><div><p class="wealth-kicker">DISCOVER</p><h2 id="marketTitle">Markets</h2></div><label class="wealth-search"><span class="visually-hidden">Search assets</span><input type="search" id="assetSearch" placeholder="Search assets" autocomplete="off"></label></div>
                    <div class="wealth-controls"><div class="wealth-filter" role="group" aria-label="Asset category"><button type="button" class="is-active" data-filter="all" aria-pressed="true">All</button><button type="button" data-filter="stock" aria-pressed="false">Stocks</button><button type="button" data-filter="etf" aria-pressed="false">ETFs</button><button type="button" data-filter="crypto" aria-pressed="false">Crypto</button><button type="button" data-filter="watchlist" aria-pressed="false">Watchlist</button></div><label class="wealth-sort-label">Sort <select id="assetSort"><option value="popular">Popular</option><option value="change">Daily change</option><option value="price">Price</option><option value="name">Name</option></select></label></div>
                    <div class="wealth-table-wrap"><table class="wealth-table"><thead><tr><th scope="col">Asset</th><th scope="col">Price</th><th scope="col">Day</th><th scope="col"><span class="visually-hidden">Watchlist</span></th></tr></thead><tbody id="assetRows"><tr><td colspan="4" class="wealth-loading">Loading market data…</td></tr></tbody></table></div>
                    <p class="wealth-error" id="marketError" role="status" hidden>Market data temporarily unavailable. Try again shortly.</p>
                </section>
                <section class="wealth-panel wealth-portfolio-panel" aria-labelledby="portfolioTitle">
                    <div class="wealth-panel-heading"><div><p class="wealth-kicker">SIMULATED INVESTING</p><h2 id="portfolioTitle">Your portfolio</h2></div><span class="wealth-cash-label">Starting demo cash</span></div>
                    <div class="wealth-portfolio-summary"><div><span>Available to invest</span><strong id="cashBalance">$100,000.00</strong></div><div><span>Holdings value</span><strong id="holdingsValue">$0.00</strong></div><div><span>Portfolio total</span><strong id="portfolioValue">$100,000.00</strong></div></div>
                    <div class="wealth-holdings"><h3>Holdings</h3><div id="holdingRows" class="wealth-holding-list"><p class="wealth-empty">Your demo portfolio is ready. Explore an asset to place a simulated order.</p></div></div>
                    <div class="wealth-activity"><h3>Recent simulated orders</h3><div id="tradeRows"><p class="wealth-empty">Your simulated order activity will appear here.</p></div></div>
                </section>
            </section>
            <aside class="wealth-detail-column">
                <section class="wealth-panel wealth-detail" aria-labelledby="assetTitle">
                    <div class="wealth-detail-top"><div><p class="wealth-kicker" id="assetType">MARKET DATA</p><h2 id="assetTitle">Choose an asset</h2><p id="assetSymbol" class="wealth-symbol">Select a market to see details</p></div><button type="button" id="watchSelected" class="wealth-icon-button" aria-label="Add selected asset to watchlist" title="Add to watchlist" disabled>☆</button></div>
                    <p class="wealth-price" id="assetPrice">—</p><p class="wealth-change" id="assetChange">Market data will appear when available.</p>
                    <div class="wealth-chart-controls" role="group" aria-label="Chart period"><% [['1d','1D'],['1w','1W'],['1m','1M'],['6m','6M'],['1y','1Y'],['5y','5Y'],['max','MAX']].forEach(([value,label], index) => { %><button type="button" data-range="<%= value %>" class="<%= index === 4 ? 'is-active' : '' %>" aria-pressed="<%= index === 4 ? 'true' : 'false' %>"><%= label %></button><% }) %></div>
                    <div class="wealth-chart" id="priceChart" role="img" aria-label="Price history chart"><p class="wealth-empty">Choose an asset to load chart data.</p></div><p class="wealth-chart-summary" id="chartSummary">Historical prices are provided for demonstration.</p>
                    <dl class="wealth-stats"><div><dt>Market cap</dt><dd id="marketCap">Unavailable</dd></div><div><dt>P/E ratio</dt><dd id="peRatio">Unavailable</dd></div><div><dt>52-week high</dt><dd id="high52Week">Unavailable</dd></div><div><dt>52-week low</dt><dd id="low52Week">Unavailable</dd></div><div><dt>Volume</dt><dd id="marketVolume">Unavailable</dd></div><div><dt>Exchange</dt><dd id="exchangeName">Unavailable</dd></div></dl>
                    <p class="wealth-chart-summary" id="quoteFreshness">Quote timestamp unavailable.</p>
                    <form id="tradeForm" class="wealth-trade-form"><div class="wealth-trade-heading"><h3>Simulated order</h3><span>No real trade</span></div><label for="tradeSide">Action</label><select id="tradeSide" name="side"><option value="buy">Buy</option><option value="sell">Sell</option></select><label for="tradeQuantity">Quantity</label><input id="tradeQuantity" name="quantity" type="number" min="0.000001" max="1000000" step="any" inputmode="decimal" placeholder="0.00" required><p class="wealth-estimate">Estimated order value <strong id="orderEstimate">$0.00</strong></p><button class="wealth-submit" type="submit" disabled id="tradeSubmit">Review simulated order</button><p id="tradeMessage" class="wealth-trade-message" role="status" aria-live="polite"></p></form>
                    <p class="wealth-risk">Prices can move. This demonstration does not provide investment advice or execute trades.</p>
                </section>
            </aside>
        </div>
        <p class="wealth-footnote">Willow is a fictional financial experience. Demo portfolio data is stored separately from account balances and banking transactions.</p>
    </main>
</div>
<script src="/js/wealth.js" defer></script>
<%- include('partials/footer') %>