<%- include('partials/head', { css: ['site', 'product'], bodyClass: 'markets-page' }) %>
<%- include('partials/site-header') %>
<main id="main">
    <section class="page-hero">
        <div class="container">
            <nav aria-label="Breadcrumb"><ol class="breadcrumbs"><li><a href="/">Willow</a></li><li>Explore</li><li aria-current="page">Markets</li></ol></nav>
            <div class="section-intro is-split mt-6" style="margin-bottom:0">
                <div>
                    <p class="eyebrow">Markets today</p>
                    <h1 class="h1">The markets, at a calm glance.</h1>
                </div>
                <p class="lede">Major indices, well-known companies and crypto, with delayed data from public market sources. Sign in to follow assets and invest money from your Willow accounts in simulated orders.</p>
            </div>
        </div>
    </section>

    <section class="section-tight" aria-labelledby="indicesTitle">
        <div class="container">
            <div class="section-heading"><h2 id="indicesTitle">Major indices</h2><span class="data-source" data-markets-status><%- icon('clock') %> Loading delayed data</span></div>
            <div class="ticker-grid" data-index-grid>
                <% ['S&P 500', 'NASDAQ Composite', 'Dow Jones Industrial Average'].forEach(name => { %>
                <article class="ticker-card"><div class="ticker-card-head"><span class="ticker-card-name"><%= name %></span><span class="skeleton skeleton-line" style="width:60px"></span></div><span class="skeleton skeleton-line w-60" style="height:1.6em"></span><span class="skeleton skeleton-block" style="min-height:56px"></span></article>
                <% }) %>
            </div>
            <div class="global-strip" data-global-strip role="group" aria-label="Global indices"></div>
        </div>
    </section>

    <section class="section-tight">
        <div class="container markets-columns">
            <div class="live-card" aria-labelledby="popularTitle">
                <div class="live-card-head"><div><p class="label">Stocks</p><h2 class="h5" id="popularTitle">Popular companies</h2></div></div>
                <ul class="live-list" role="list" data-popular-list>
                    <% for (let i = 0; i < 7; i++) { %><li class="market-row"><span class="skeleton" style="width:40px;height:40px;border-radius:12px"></span><span class="market-row-main"><span class="skeleton skeleton-line w-60"></span><span class="skeleton skeleton-line w-40"></span></span><span class="skeleton skeleton-line" style="width:72px"></span></li><% } %>
                </ul>
            </div>
            <div class="col-stack">
                <div class="live-card" aria-labelledby="cryptoTitle">
                    <div class="live-card-head"><div><p class="label">Crypto</p><h2 class="h5" id="cryptoTitle">Digital assets</h2></div><span class="badge badge-warning">Higher risk</span></div>
                    <ul class="live-list" role="list" data-crypto-list>
                        <% for (let i = 0; i < 4; i++) { %><li class="market-row"><span class="skeleton skeleton-circle" style="width:40px;height:40px"></span><span class="market-row-main"><span class="skeleton skeleton-line w-60"></span><span class="skeleton skeleton-line w-40"></span></span><span class="skeleton skeleton-line" style="width:72px"></span></li><% } %>
                    </ul>
                </div>
                <div class="cta-band markets-cta">
                    <h2 class="h4">Invest the money you move in.</h2>
                    <p>Move cash from your Willow accounts into investing and build a portfolio of stocks, ETFs, funds and crypto at real, delayed prices. Orders are simulated.</p>
                    <div class="cta-band-actions">
                        <a class="btn btn-light" href="<%= user ? '/wealth/markets' : '/register' %>"><%= user ? 'Open Markets' : 'Open an account' %> <%- icon('arrow-right', 'icon-arrow') %></a>
                        <a class="btn btn-outline-light" href="/learn/stocks-etfs-and-funds">Learn the basics</a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="section-tight">
        <div class="container">
            <div class="disclosure-note"><%- icon('info') %><p>Market data is retrieved server-side from Yahoo Finance (via the open-source yfinance library where available) for prototyping. It may be delayed, incomplete or unavailable, and is not investment advice. When data can’t be retrieved, Willow shows that clearly rather than estimating a price.</p></div>
        </div>
    </section>
</main>
<%- include('partials/site-footer') %>
<%- include('partials/foot', { js: ['public-markets', 'charts', 'markets-public'] }) %>
