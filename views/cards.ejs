<%- include('partials/header') %>

    <body>
        <div class="app-layout">
            <%- include('partials/sidebar') %>
                <main class="main-content">
                    <div class="page-header">
                        <h1>Your Cards</h1>
                        <p>Manage your debit and credit cards</p>
                    </div>
                    <div id="cardsContainer" class="loading-overlay">
                        <div class="spinner"></div>
                    </div>
                </main>
        </div>
        <script>
            const csrfToken = '<%= csrfToken %>';
            async function loadCards() {
                const c = document.getElementById('cardsContainer');
                try {
                    const res = await fetch('/api/cards', { headers: { 'Accept': 'application/json' } });
                    const data = await res.json();
                    if (!res.ok) throw new Error(data.error);
                    if (!data.cards.length) { c.innerHTML = '<div class="empty-state"><h3>No cards</h3><p>You don\'t have any cards yet.</p></div>'; return; }
                    let html = '';
                    data.cards.forEach(card => {
                        html += '<div class="card mb-4 max-w-600">';
                        html += '<div class="card-body" style="display:flex;gap:var(--space-6);flex-wrap:wrap;align-items:flex-start;">';
                        html += '<div class="bank-card ' + (card.status === 'frozen' || card.status === 'cancelled' ? 'frozen' : '') + '">';
                        html += '<div class="card-brand">WILLOW BANKING</div>';
                        html += '<div class="card-number">' + card.maskedNumber + '</div>';
                        html += '<div class="card-bottom"><div><div class="card-label">Expires</div><div class="card-value">' + card.expiration_date + '</div></div><div><div class="card-label">Type</div><div class="card-value" style="text-transform:uppercase;">' + card.card_type + '</div></div></div>';
                        html += '</div>';
                        html += '<div style="flex:1;min-width:180px;">';
                        html += '<h4 class="mb-3">Card Details</h4>';
                        html += '<p class="text-sm text-muted mb-4">Status: <span class="badge badge-' + (card.status === 'active' ? 'success' : card.status === 'frozen' ? 'info' : 'danger') + '">' + card.statusLabel + '</span></p>';
                        html += '<p class="text-sm text-muted mb-4">Daily Limit: ' + card.dailyLimitFormatted + '</p>';
                        html += '<p class="text-sm text-muted mb-4">Account: ' + card.account_type + '</p>';
                        html += '<div class="flex gap-2" style="flex-wrap:wrap;">';
                        if (card.status === 'active') {
                            html += '<button class="btn btn-secondary btn-sm" onclick="updateCard(' + card.id + ',\'frozen\')"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg> Freeze</button>';
                            html += '<button class="btn btn-danger btn-sm" onclick="updateCard(' + card.id + ',\'reported\')">Report Lost</button>';
                        } else if (card.status === 'frozen') {
                            html += '<button class="btn btn-primary btn-sm" onclick="updateCard(' + card.id + ',\'active\')">Unfreeze</button>';
                            html += '<button class="btn btn-danger btn-sm" onclick="updateCard(' + card.id + ',\'reported\')">Report Lost</button>';
                        }
                        if (card.status !== 'active' && card.status !== 'cancelled') {
                            html += '<button class="btn btn-secondary btn-sm" onclick="replaceCard(' + card.id + ')">Request Replacement</button>';
                        }
                        html += '</div></div></div></div>';
                    });
                    c.innerHTML = html;
                } catch (e) { c.innerHTML = '<div class="alert alert-danger">' + (e.message || 'Failed to load.') + '</div>'; }
            }
            async function updateCard(id, status) {
                const actionName = status === 'frozen' ? 'freeze' : status === 'active' ? 'unfreeze' : 'report';
                const confirmed = await showConfirm('Are you sure you want to ' + actionName + ' this card?', 'Card Action');
                if (!confirmed) return;
                try {
                    const res = await fetch('/api/cards/' + id + '/status', {
                        method: 'POST', headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken },
                        body: JSON.stringify({ status }),
                    });
                    const data = await res.json();
                    if (!res.ok) throw new Error(data.error);
                    showToast('Card has been ' + actionName + 'd successfully.', 'success');
                    loadCards();
                } catch (e) { showToast(e.message || 'Failed.', 'error'); }
            }
            async function replaceCard(id) {
                const confirmed = await showConfirm('Request a replacement card? The current card will be cancelled.', 'Replace Card');
                if (!confirmed) return;
                try {
                    const res = await fetch('/api/cards/' + id + '/replace', {
                        method: 'POST', headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken },
                    });
                    const data = await res.json();
                    if (!res.ok) throw new Error(data.error);
                    showToast(data.message, 'success');
                    loadCards();
                } catch (e) { showToast(e.message || 'Failed.', 'error'); }
            }
            document.addEventListener('DOMContentLoaded', loadCards);
        </script>
        <%- include('partials/footer') %>