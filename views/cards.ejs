<%- include('partials/header') %>
<body class="banking-workspace"><div class="app-layout"><%- include('partials/sidebar') %><main class="main-content workspace-main"><p class="workspace-eyebrow">YOUR WILLOW / YOUR CARDS</p>
<div class="page-header"><h1>Your cards</h1><p>Freeze, report or replace your demo card. No live payments or physical cards are connected.</p></div>
<% if (notice) { %><p class="settings-feedback" role="status"><%= notice %></p><% } %>
<% if (!cards.length) { %><div class="empty-state"><h2>No demo cards yet</h2><p>Your cards will appear here when available.</p></div><% } %>
<div class="card-management-list">
<% cards.forEach(card => { %><section class="card mb-6"><div class="card-body card-management-row">
    <div class="bank-card <%= card.status !== 'active' ? 'frozen' : '' %>"><div class="card-brand">WILLOW / DEMO</div><div class="card-number"><%= card.maskedNumber %></div><div class="card-bottom"><div><div class="card-label">Expires</div><div class="card-value"><%= card.expiration_date %></div></div><div><div class="card-label">Type</div><div class="card-value"><%= card.card_type %></div></div></div></div>
    <div class="card-management-details"><h2><%= card.accountName %></h2><p class="mt-3">Card ending <%= card.last_four %> · <strong><%= card.statusLabel %></strong></p><p class="text-muted text-sm mt-3">Demo daily limit setting: <%= card.dailyLimitFormatted %>. Live card spending is unavailable.</p>
    <% if (card.status === 'reported') { %><p class="mt-3">Reported lost. This card cannot be reactivated.</p><% } %>
    <% if (card.status === 'cancelled') { %><p class="mt-3">This card is permanently inactive.</p><% } %>
    <% if (card.account_status !== 'active') { %><p class="mt-3">The linked account is <%= card.account_status %>. Unfreeze and replacement are unavailable.</p><% } %>
    <div class="settings-actions mt-4">
    <% if (card.status === 'active') { %><button type="button" class="btn btn-secondary" data-card-action="frozen" data-card-id="<%= card.id %>" data-last-four="<%= card.last_four %>">Freeze card</button><% } %>
    <% if (card.status === 'frozen' && card.account_status === 'active') { %><button type="button" class="btn btn-primary" data-card-action="active" data-card-id="<%= card.id %>" data-last-four="<%= card.last_four %>">Unfreeze card</button><% } %>
    <% if (['active','frozen'].includes(card.status)) { %><button type="button" class="btn btn-secondary" data-card-action="reported" data-card-id="<%= card.id %>" data-last-four="<%= card.last_four %>">Report lost</button><% } %>
    <% if (['frozen','reported'].includes(card.status) && card.account_status === 'active') { %><button type="button" class="btn btn-primary" data-card-action="replace" data-card-id="<%= card.id %>" data-last-four="<%= card.last_four %>">Replace demo card</button><% } %>
    </div><a class="home-inline-link mt-4" href="/accounts/<%= card.account_id %>">View linked account →</a></div>
</div></section><% }) %></div>
<dialog id="cardReview" class="card-review" aria-labelledby="cardReviewTitle" aria-describedby="cardReviewDescription"><h2 id="cardReviewTitle"></h2><p id="cardReviewDescription" class="mt-4"></p><p id="cardActionError" role="alert" class="settings-feedback" data-error="true" hidden></p><div class="settings-actions mt-4"><button type="button" id="cancelCardAction" class="btn btn-secondary" autofocus>Keep current card</button><button type="button" id="confirmCardAction" class="btn btn-primary">Confirm</button></div></dialog>
</main></div><script src="/js/cards.js" defer></script><%- include('partials/footer') %>
