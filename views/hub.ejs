<%- include('partials/header') %>
<body class="account-overview-page wealth-page">
<div class="app-layout"><%- include('partials/sidebar') %><main class="main-content wealth-main hub-main" id="main-content" aria-busy="true">
    <header class="wealth-heading"><div><p class="wealth-kicker">WILLOW / YOUR FINANCIAL PICTURE</p><h1>A clearer view of your money.</h1><p>Account and activity summaries drawn from your Willow demo data.</p></div><span class="wealth-demo-label">DEMO · SIMULATED DATA</span></header>
    <div id="hubError" class="wealth-disclosure" role="status" hidden>We couldn’t load your financial picture. Refresh to try again.</div>
    <section class="hub-overview" aria-label="Financial overview">
        <article class="hub-net-worth"><p class="wealth-kicker">ACTIVE BANK ACCOUNTS</p><strong id="hubBankBalance" class="hub-balance">—</strong><p>Simulated account balances · USD</p><a href="/accounts">View your accounts <span aria-hidden="true">↗</span></a></article>
        <div class="hub-metrics"><article><span>Demo savings</span><strong id="hubSavings">—</strong><small>Across savings accounts</small></article><article><span>Simulated investments</span><strong id="hubInvestments">—</strong><small>Recorded cost basis, excludes demo cash</small></article><article><span>Credit and debt</span><strong>Not connected</strong><small>No credit or loan account data in this demo</small></article></div>
    </section>
    <div class="hub-columns">
        <section class="wealth-panel" aria-labelledby="movementTitle"><div class="wealth-panel-heading"><div><p class="wealth-kicker">THIS MONTH</p><h2 id="movementTitle">Money movement</h2></div><a href="/transactions">Transactions ↗</a></div><div class="hub-movement"><div><span>Completed credits</span><strong id="hubIncome">—</strong><div class="hub-bar"><span id="incomeBar"></span></div></div><div><span>Completed debits</span><strong id="hubExpenses">—</strong><div class="hub-bar hub-bar-expense"><span id="expenseBar"></span></div></div></div><p class="wealth-footnote">Transfers between your accounts may appear as separate ledger entries. Only completed demo transactions are included.</p></section>
        <section class="wealth-panel" aria-labelledby="accountsTitle"><div class="wealth-panel-heading"><div><p class="wealth-kicker">CONNECTED IN WILLOW</p><h2 id="accountsTitle">Your accounts</h2></div><a href="/accounts">Manage ↗</a></div><div id="hubAccounts" class="hub-account-list"><p class="wealth-loading">Loading account data…</p></div></section>
    </div>
    <div class="hub-columns hub-lower">
        <section class="wealth-panel" aria-labelledby="expensesTitle"><div class="wealth-panel-heading"><div><p class="wealth-kicker">COMPLETED DEBITS</p><h2 id="expensesTitle">Largest expenses this month</h2></div></div><div id="hubExpenseList"><p class="wealth-loading">Loading transaction data…</p></div></section>
        <section class="wealth-panel hub-assistant" aria-labelledby="assistantTitle"><p class="wealth-kicker">WILLOW INTELLIGENCE</p><h2 id="assistantTitle">Ask about your demo data.</h2><p>Answers use only your Willow accounts, completed transactions, and simulated investment records.</p><div class="hub-prompts"><button type="button" data-question="How much did I spend this month?">Spending this month</button><button type="button" data-question="What are my biggest expenses?">Biggest expenses</button><button type="button" data-question="How much do I have in savings?">Savings balance</button><button type="button" data-question="Show me my investments.">My investments</button></div><form id="hubQuestionForm"><label for="hubQuestion">Ask a question</label><div><input id="hubQuestion" name="question" maxlength="200" placeholder="How much do I have in savings?" required><button type="submit">Ask</button></div></form><div class="hub-answer" id="hubAnswer" role="status" aria-live="polite">Your answers will appear here.</div></section>
    </div>
    <section class="wealth-panel hub-goal-section" aria-labelledby="hubGoalsTitle"><div class="wealth-panel-heading"><div><p class="wealth-kicker">YOUR SAVED PLANS</p><h2 id="hubGoalsTitle">Goals you’re tracking</h2></div><a href="/goals">Manage goals ↗</a></div><div id="hubGoals" class="hub-goal-list"><p class="wealth-loading">Loading saved goals…</p></div></section>
    <section class="hub-next-steps" aria-label="Explore Willow"><a href="/wealth"><span>01 / WEALTH</span><strong>Markets and simulated investing</strong><small>Explore market data · No real orders</small></a><a href="/goals"><span>02 / PLANNING</span><strong>Track a personal goal</strong><small>Progress only · No money movement</small></a><a href="/loans"><span>03 / BORROW</span><strong>Illustrative loan calculator</strong><small>Estimate only · No lending offer</small></a><a href="/security"><span>04 / SECURITY</span><strong>Review your account access</strong><small>Sessions and sign-in history</small></a></section>
    <p class="wealth-footnote">This is not a complete net-worth statement. External accounts, debts, scheduled payments, live investment valuation, and financial advice are not connected.</p>
</main></div>
<script src="/js/hub.js" defer></script>
<%- include('partials/footer') %>