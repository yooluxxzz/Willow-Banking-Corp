<%- include('partials/header') %>
<body class="public-page home-page">
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <%- include('partials/public-nav') %>
    <main id="main-content">
        <section class="banking-hero">
            <div class="section-inner banking-hero-grid">
                <div><p class="home-eyebrow"><%= business ? 'Business banking / Demo accounts' : 'Personal banking / Made for real life' %></p>
                    <h1><%= business ? 'For the work you believe in.' : 'Banking that fits around you.' %></h1>
                    <p><%= business ? 'Explore a considered approach to everyday business finances. Keep the working day clear, so you can focus on what you do best.' : 'Bring your everyday accounts, savings and card controls into one clear view. Less searching. More knowing where you stand.' %></p>
                    <a class="home-button home-button-primary" href="<%= business ? '/accounts/new?type=business' : '/register' %>"><%= business ? 'Open business checking' : 'Open a demo account' %></a>
                    <p class="banking-disclosure"><%= business ? 'Business checking is a single-owner demo account with simulated funds. Merchant payments, lending, payroll and company verification are not available. Sign in, then choose your account.' : 'Willow is a fictional banking demo. All balances and transactions are simulated; no real money moves.' %></p>
                </div>
                <div class="banking-hero-photo"><img src="<%= business ? 'https://images.unsplash.com/photo-1441986300917-64674bd600d8?auto=format&fit=crop&w=1100&q=85' : 'https://images.unsplash.com/photo-1556742049-0cfed4f6a45d?auto=format&fit=crop&w=1100&q=85' %>" alt="<%= business ? 'A thoughtfully arranged independent clothing shop' : 'A customer making an everyday payment' %>" width="1100" height="1000"></div>
            </div>
        </section>
        <section class="home-products">
            <div class="section-inner"><p class="home-eyebrow"><%= business ? 'Explore the existing demo tools' : 'Your everyday essentials' %></p><h2><%= business ? 'A clearer view of the working day.' : 'Simple tools. A connected picture.' %></h2>
                <div class="home-product-grid">
                    <a class="home-product-item" href="/products/checking"><span class="home-product-number">01</span><h3>Accounts</h3><p>View account details, total balance and available funds.</p><span class="home-product-link">Explore checking →</span></a>
                    <a class="home-product-item" href="/products/savings"><span class="home-product-number">02</span><h3>Savings</h3><p>Move demo funds between checking and savings as plans take shape.</p><span class="home-product-link">Explore savings →</span></a>
                    <a class="home-product-item" href="/products/debit-cards"><span class="home-product-number">03</span><h3>Card controls</h3><p>Review card status, freeze a demo card or report it missing.</p><span class="home-product-link">Explore cards →</span></a>
                    <a class="home-product-item" href="/products/transfers"><span class="home-product-number">04</span><h3>Transfers</h3><p>Review the details before recording a simulated transfer.</p><span class="home-product-link">Explore transfers →</span></a>
                </div>
            </div>
        </section>
        <section class="home-support"><div class="section-inner home-support-grid"><div><p class="home-eyebrow">Clear from the start</p><h2>Good questions deserve clear answers.</h2></div><div class="home-support-actions"><p>Learn how the demo handles account access and security, or explore our help page.</p><a href="/security-info" class="home-inline-link">Security and fraud protection →</a><a href="/contact" class="home-inline-link">Help and contact →</a></div></div></section>
    </main>
    <%- include('partials/public-footer') %>
    <%- include('partials/footer') %>
