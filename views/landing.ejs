<%- include('partials/header') %>

<body class="public-page home-page">
    <a class="skip-link" href="#main-content">Skip to main content</a>

    <div class="home-utility">
        <div class="home-utility-inner">
            <span>Personal banking from Willow</span>
            <a href="/contact">Help and support</a>
        </div>
    </div>

    <nav class="public-nav home-nav" aria-label="Main navigation">
        <div class="nav-inner">
            <a href="/" class="nav-brand">
                <img src="/images/logo.svg" alt="" class="nav-logo-img">
                Willow Banking Corp.
            </a>
            <div class="nav-links" id="homeNavLinks">
                <a href="#banking">Banking</a>
                <a href="#experience">Digital experience</a>
                <a href="#security">Trust and security</a>
                <a href="#resources">Help</a>
                <button class="nav-theme-toggle" onclick="toggleTheme()" title="Toggle dark mode" aria-label="Toggle theme">
                    <svg class="icon-sun" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="5" />
                        <line x1="12" x2="12" y1="1" y2="3" />
                        <line x1="12" x2="12" y1="21" y2="23" />
                        <line x1="4.22" x2="5.64" y1="4.22" y2="5.64" />
                        <line x1="18.36" x2="19.78" y1="18.36" y2="19.78" />
                        <line x1="1" x2="3" y1="12" y2="12" />
                        <line x1="21" x2="23" y1="12" y2="12" />
                        <line x1="4.22" x2="5.64" y1="19.78" y2="18.36" />
                        <line x1="18.36" x2="19.78" y1="5.64" y2="4.22" />
                    </svg>
                    <svg class="icon-moon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
                    </svg>
                </button>
                <a href="/login" class="home-nav-signin">Sign in</a>
                <a href="/register" class="home-nav-cta">Open an account</a>
            </div>
            <button class="home-menu-toggle" id="homeMenuToggle" type="button" aria-controls="homeNavLinks" aria-expanded="false" aria-label="Open navigation menu">
                <svg class="menu-open-icon" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
                    <path d="M4 7h16M4 12h16M4 17h16" />
                </svg>
                <svg class="menu-close-icon" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
                    <path d="m6 6 12 12M18 6 6 18" />
                </svg>
            </button>
        </div>
    </nav>

    <main id="main-content">
        <section class="home-hero" id="home" aria-labelledby="homeHeroTitle">
            <div class="home-hero-media" data-hero-stage role="img" aria-label="A customer reviewing a payment at home">
                <img class="home-hero-slide is-active" data-hero-slide src="https://images.unsplash.com/photo-1556742049-0cfed4f6a45d?auto=format&amp;fit=crop&amp;w=1600&amp;q=82" srcset="https://images.unsplash.com/photo-1556742049-0cfed4f6a45d?auto=format&amp;fit=crop&amp;w=720&amp;q=74 720w, https://images.unsplash.com/photo-1556742049-0cfed4f6a45d?auto=format&amp;fit=crop&amp;w=1200&amp;q=80 1200w, https://images.unsplash.com/photo-1556742049-0cfed4f6a45d?auto=format&amp;fit=crop&amp;w=1800&amp;q=82 1800w" sizes="100vw" alt="" aria-hidden="true" fetchpriority="high" decoding="async">
                <img class="home-hero-slide" data-hero-slide src="https://images.unsplash.com/photo-1556742502-ec7c0e9f34b1?auto=format&amp;fit=crop&amp;w=1600&amp;q=82" srcset="https://images.unsplash.com/photo-1556742502-ec7c0e9f34b1?auto=format&amp;fit=crop&amp;w=720&amp;q=74 720w, https://images.unsplash.com/photo-1556742502-ec7c0e9f34b1?auto=format&amp;fit=crop&amp;w=1200&amp;q=80 1200w, https://images.unsplash.com/photo-1556742502-ec7c0e9f34b1?auto=format&amp;fit=crop&amp;w=1800&amp;q=82 1800w" sizes="100vw" alt="" aria-hidden="true" loading="lazy" fetchpriority="low" decoding="async">
                <img class="home-hero-slide" data-hero-slide src="https://images.unsplash.com/photo-1579621970563-ebec7560ff3e?auto=format&amp;fit=crop&amp;w=1600&amp;q=82" srcset="https://images.unsplash.com/photo-1579621970563-ebec7560ff3e?auto=format&amp;fit=crop&amp;w=720&amp;q=74 720w, https://images.unsplash.com/photo-1579621970563-ebec7560ff3e?auto=format&amp;fit=crop&amp;w=1200&amp;q=80 1200w, https://images.unsplash.com/photo-1579621970563-ebec7560ff3e?auto=format&amp;fit=crop&amp;w=1800&amp;q=82 1800w" sizes="100vw" alt="" aria-hidden="true" loading="lazy" fetchpriority="low" decoding="async">
            </div>
            <div class="home-hero-shade" aria-hidden="true"></div>
            <div class="home-hero-content">
                <div class="home-hero-copy">
                    <p class="home-eyebrow">Willow Banking Corp. <span>Personal banking</span></p>
                    <h1 id="homeHeroTitle">Steady for what's next.</h1>
                    <p>Everyday accounts, cards, transfers and clear digital tools, brought together around the life you're building.</p>
                    <div class="home-hero-actions">
                        <a href="/register" class="home-button home-button-light">Open an account</a>
                        <a href="#banking" class="home-text-link">Explore banking <span aria-hidden="true">&#8594;</span></a>
                    </div>
                </div>
                <div class="home-carousel-controls" aria-label="Hero image controls">
                    <div class="home-carousel-dots" role="group" aria-label="Choose a campaign image">
                        <button class="is-active" type="button" data-slide-to="0" aria-label="Show everyday banking scene" aria-pressed="true"></button>
                        <button type="button" data-slide-to="1" aria-label="Show contactless payment scene" aria-pressed="false"></button>
                        <button type="button" data-slide-to="2" aria-label="Show long-term planning scene" aria-pressed="false"></button>
                    </div>
                    <button class="home-carousel-toggle" type="button" data-carousel-toggle aria-label="Pause image rotation" title="Pause image rotation" aria-pressed="false">
                        <svg class="pause-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M8 5v14M16 5v14" /></svg>
                        <svg class="play-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m7 4 13 8-13 8z" /></svg>
                    </button>
                </div>
            </div>
        </section>

        <section class="home-intro home-reveal" aria-labelledby="homeIntroTitle">
            <div class="section-inner home-intro-grid">
                <p class="home-eyebrow">Made for real life</p>
                <div>
                    <h2 id="homeIntroTitle">A clear place for money, through every kind of day.</h2>
                    <p>From the everyday essentials to plans that take time, Willow brings the parts of banking you use together in one considered digital experience.</p>
                </div>
                <div class="home-principles" aria-label="Willow principles">
                    <span>Everyday clarity</span>
                    <span>Room to grow</span>
                    <span>People first</span>
                </div>
            </div>
        </section>

        <section class="home-products home-reveal" id="banking" aria-labelledby="homeProductsTitle">
            <div class="section-inner">
                <div class="home-section-heading">
                    <div>
                        <p class="home-eyebrow">Banking for the whole picture</p>
                        <h2 id="homeProductsTitle">The essentials, thoughtfully connected.</h2>
                    </div>
                    <p>Choose what fits the way you manage money today. Your accounts and everyday tools stay close at hand.</p>
                </div>
                <div class="home-product-grid">
                    <a class="home-product-item" href="/products/checking">
                        <span class="home-product-number">01</span>
                        <span class="home-product-icon" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="25" height="25" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 10h18M7 15h3"/></svg></span>
                        <h3>Checking</h3>
                        <p>Keep day-to-day spending and account activity in view.</p>
                        <span class="home-product-link">Explore checking <span aria-hidden="true">&#8594;</span></span>
                    </a>
                    <a class="home-product-item" href="/products/savings">
                        <span class="home-product-number">02</span>
                        <span class="home-product-icon" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="25" height="25" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22V12M8 15.5 12 12l4 3.5M5 5.5C8.5 4 15.5 4 19 5.5c-1 5-4 7-7 7s-6-2-7-7Z"/></svg></span>
                        <h3>Savings</h3>
                        <p>Set money aside for the plans you're working toward.</p>
                        <span class="home-product-link">Explore savings <span aria-hidden="true">&#8594;</span></span>
                    </a>
                    <a class="home-product-item" href="/products/debit-cards">
                        <span class="home-product-number">03</span>
                        <span class="home-product-icon" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="25" height="25" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 10h18M7 15h2"/></svg></span>
                        <h3>Debit cards</h3>
                        <p>Review card activity and manage card controls in one place.</p>
                        <span class="home-product-link">Explore cards <span aria-hidden="true">&#8594;</span></span>
                    </a>
                    <a class="home-product-item" href="/products/transfers">
                        <span class="home-product-number">04</span>
                        <span class="home-product-icon" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="25" height="25" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M7 7h13l-3-3M17 17H4l3 3M20 7l-4 4M4 17l4-4"/></svg></span>
                        <h3>Transfers</h3>
                        <p>Move money between accounts with a clear activity history.</p>
                        <span class="home-product-link">Explore transfers <span aria-hidden="true">&#8594;</span></span>
                    </a>
                </div>
            </div>
        </section>

        <section class="home-experience home-reveal" id="experience" aria-labelledby="homeExperienceTitle">
            <div class="section-inner home-experience-grid">
                <div class="home-experience-copy">
                    <p class="home-eyebrow">A calmer digital experience</p>
                    <h2 id="homeExperienceTitle">See what's happening. Know what comes next.</h2>
                    <p>Balances, recent activity, transfers and card controls come together in a dashboard designed to make the next step easier to find.</p>
                    <ul class="home-check-list">
                        <li>Account and savings summaries</li>
                        <li>Searchable transaction history</li>
                        <li>Card controls and account alerts</li>
                    </ul>
                    <a href="/login" class="home-inline-link">Sign in to your account <span aria-hidden="true">&#8594;</span></a>
                </div>
                <div class="home-sample-window" aria-label="Illustrative Willow digital banking experience">
                    <div class="home-sample-topbar">
                        <span class="home-sample-brand"><span class="home-sample-mark" aria-hidden="true"></span> Willow</span>
                        <span class="home-sample-label">Illustrative account view</span>
                    </div>
                    <div class="home-sample-main">
                        <div class="home-sample-balance">
                            <span>Available balance <span class="home-sample-tag">Sample data</span></span>
                            <strong>$4,820.35</strong>
                            <span>Across your everyday accounts</span>
                        </div>
                        <div class="home-sample-accounts">
                            <div><span>Everyday account</span><strong>$3,240.35</strong></div>
                            <div><span>Savings account</span><strong>$1,580.00</strong></div>
                        </div>
                        <div class="home-sample-activity">
                            <div class="home-sample-activity-heading"><strong>Recent activity</strong><span>Example transactions</span></div>
                            <div><span class="home-activity-mark">M</span><span>Market Street Grocer<small>Today &middot; Debit card</small></span><strong>-$42.80</strong></div>
                            <div><span class="home-activity-mark home-activity-mark-alt">T</span><span>Transfer to savings<small>Yesterday &middot; Transfer</small></span><strong>-$100.00</strong></div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="home-growth home-reveal" aria-labelledby="homeGrowthTitle">
            <div class="section-inner home-growth-grid">
                <div>
                    <p class="home-eyebrow">Today, and what comes after</p>
                    <h2 id="homeGrowthTitle">Make the small decisions feel connected to the bigger ones.</h2>
                </div>
                <div class="home-growth-copy">
                    <p>See everyday spending beside the goals you're building toward. Willow gives routine money moments a little more context, without making them harder to manage.</p>
                    <a href="/products/savings" class="home-inline-link">Explore savings <span aria-hidden="true">&#8594;</span></a>
                </div>
                <div class="home-growth-rhythm" aria-label="A connected view of now, next, and later">
                    <div><span class="home-rhythm-point"></span><strong>Now</strong><small>Everyday spending</small></div>
                    <div><span class="home-rhythm-point"></span><strong>Next</strong><small>Plans taking shape</small></div>
                    <div><span class="home-rhythm-point"></span><strong>Later</strong><small>Goals in progress</small></div>
                </div>
            </div>
        </section>

        <section class="home-support home-reveal" id="resources" aria-labelledby="homeSupportTitle">
            <div class="section-inner home-support-grid">
                <div>
                    <p class="home-eyebrow">Here when you need us</p>
                    <h2 id="homeSupportTitle">Good banking leaves room for good questions.</h2>
                </div>
                <div class="home-support-actions">
                    <p>Find product information or get in touch with the Willow team about the experience.</p>
                    <a href="/contact" class="home-inline-link">Contact Willow <span aria-hidden="true">&#8594;</span></a>
                    <a href="/about" class="home-inline-link">About Willow <span aria-hidden="true">&#8594;</span></a>
                </div>
            </div>
        </section>

        <section class="home-trust home-reveal" id="security" aria-labelledby="homeTrustTitle">
            <div class="section-inner home-trust-grid">
                <div class="home-trust-copy">
                    <p class="home-eyebrow">Trust begins with transparency</p>
                    <h2 id="homeTrustTitle">Clear about what is known, and what still needs to be verified.</h2>
                    <p>Willow is a fictional demonstration platform. Before any real-world launch, regulatory status, deposit protection and independent security details must be confirmed and published.</p>
                </div>
                <dl class="home-disclosures">
                    <div><dt>Regulatory information</dt><dd>[To be confirmed before production use]</dd></div>
                    <div><dt>Deposit protection information</dt><dd>[To be confirmed before production use]</dd></div>
                    <div><dt>Privacy and data use</dt><dd>[To be confirmed before production use]</dd></div>
                    <div><dt>Security certification</dt><dd>[To be confirmed before production use]</dd></div>
                </dl>
            </div>
        </section>

        <section class="home-final-cta home-reveal" aria-labelledby="homeFinalTitle">
            <div class="section-inner home-final-inner">
                <div>
                    <p class="home-eyebrow">A thoughtful place to begin</p>
                    <h2 id="homeFinalTitle">Make your next money moment a little clearer.</h2>
                </div>
                <div class="home-final-actions">
                    <a href="/register" class="home-button home-button-primary">Open an account</a>
                    <a href="/contact" class="home-inline-link">Talk with Willow <span aria-hidden="true">&#8594;</span></a>
                </div>
            </div>
        </section>
    </main>

    <%- include('partials/public-footer') %>
</body>

</html>
