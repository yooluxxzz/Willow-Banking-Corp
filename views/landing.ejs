<%- include('partials/header') %>

<body class="public-page">
    <a class="skip-link" href="#main-content">Skip to main content</a>

    <nav class="public-nav" aria-label="Main navigation">
        <div class="nav-inner">
            <a href="/" class="nav-brand">
                <img src="/images/logo.svg" alt="Willow" class="nav-logo-img">
                Willow Banking Corp.
            </a>
            <div class="nav-links">
                <a href="#products" class="hide-mobile">Products</a>
                <a href="#experience" class="hide-mobile">Experience</a>
                <a href="#security" class="hide-mobile">Security</a>
                <a href="#resources">Resources</a>
                <button class="nav-theme-toggle" onclick="toggleTheme()" title="Toggle dark mode" aria-label="Toggle theme">
                    <svg class="icon-sun" xmlns="http://www.w3.org/2000/svg" width="18" height="18"
                        viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                        stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="5" />
                        <line x1="12" x2="12" y1="1" y2="3" />
                        <line x1="12" x2="12" y1="21" y2="23" />
                        <line x1="4.22" x2="5.64" y1="4.22" y2="5.64" />
                        <line x1="18.36" x2="19.78" y1="18.36" y2="19.78" />
                        <line x1="1" x2="3" y1="12" y2="12" />
                        <line x1="21" x2="23" y1="12" y2="12" />
                        <line x1="4.22" x2="5.64" y1="19.78" y2="18.36" />
                        <line x1="18.36" x2="19.78" y1="5.64" y2="4.22" />
                    </svg>
                    <svg class="icon-moon" xmlns="http://www.w3.org/2000/svg" width="18" height="18"
                        viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                        stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
                    </svg>
                </button>
                <a href="/login" class="btn btn-secondary btn-sm">Sign In</a>
                <a href="/register" class="btn btn-primary btn-sm">Open Account</a>
            </div>
        </div>
    </nav>

    <main id="main-content">
        <section class="hero">
            <div class="section-inner hero-inner">
                <div>
                    <div class="hero-badges">
                        <span>Trusted by 42k+ households</span>
                        <span>4.9/5 member rating</span>
                    </div>
                    <p class="eyebrow">Modern digital banking</p>
                    <h1>Banking built around your life.</h1>
                    <p>Willow Banking Corp. combines secure account management, instant transfers, and helpful financial tools in a clean, mobile-first experience designed around how people actually bank every day.</p>
                    <div class="hero-actions">
                        <a href="/register" class="btn btn-primary btn-lg">Get Started</a>
                        <a href="/login" class="btn btn-secondary btn-lg">Sign In</a>
                    </div>
                    <div class="hero-meta">
                        <div>
                            <strong>3 min</strong>
                            <span>setup</span>
                        </div>
                        <div>
                            <strong>24/7</strong>
                            <span>support</span>
                        </div>
                        <div>
                            <strong>$0</strong>
                            <span>monthly fee</span>
                        </div>
                    </div>
                </div>
                <div class="hero-visual" aria-label="Account overview preview">
                    <div class="balance-card">
                        <div class="balance-header">
                            <span class="balance-label">Available balance</span>
                            <span class="balance-pill">+8.2%</span>
                        </div>
                        <h3>$24,840.76</h3>
                        <div class="balance-row">
                            <span>Checking</span>
                            <strong>$12,640.57</strong>
                        </div>
                        <div class="balance-row">
                            <span>Savings</span>
                            <strong>$12,200.19</strong>
                        </div>
                    </div>
                    <div class="mini-card">
                        <span class="mini-label">Spending</span>
                        <strong>$3,460</strong>
                        <div class="mini-bars" aria-hidden="true">
                            <span style="--bar-height: 42%"></span>
                            <span style="--bar-height: 58%"></span>
                            <span style="--bar-height: 71%"></span>
                            <span style="--bar-height: 86%"></span>
                            <span style="--bar-height: 63%"></span>
                            <span style="--bar-height: 92%"></span>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="stats-strip" aria-label="Key banking highlights">
            <div class="section-inner stats-grid">
                <article class="stat-card">
                    <strong>99.99%</strong>
                    <span>secure uptime</span>
                </article>
                <article class="stat-card">
                    <strong>24/7</strong>
                    <span>digital support</span>
                </article>
                <article class="stat-card">
                    <strong>2.5M+</strong>
                    <span>transactions protected</span>
                </article>
                <article class="stat-card">
                    <strong>0.00%</strong>
                    <span>account opening fee</span>
                </article>
            </div>
        </section>

        <section class="features-section" id="products">
            <div class="section-inner">
                <p class="eyebrow eyebrow-centered">Everything in one place</p>
                <h2>Designed to help people manage money confidently</h2>
                <p class="section-sub">From day-to-day payments to long-term planning, every feature is built for clarity, speed, and trust.</p>
                <div class="features-grid">
                    <article class="feature-card">
                        <div class="feature-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10" />
                            </svg>
                        </div>
                        <h3>Bank-grade security</h3>
                        <p>Encrypted sessions, secure logins, and proactive protection for every account and payment.</p>
                    </article>
                    <article class="feature-card">
                        <div class="feature-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="m5 12 7-7 7 7" />
                                <path d="M12 19V5" />
                            </svg>
                        </div>
                        <h3>Instant transfers</h3>
                        <p>Move money across accounts or to other Willow customers in seconds with complete transparency.</p>
                    </article>
                    <article class="feature-card">
                        <div class="feature-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z" />
                                <path d="M14 2v6h6" />
                            </svg>
                        </div>
                        <h3>Detailed statements</h3>
                        <p>Track every payment, transfer, and deposit with searchable history and export-ready records.</p>
                    </article>
                    <article class="feature-card">
                        <div class="feature-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect width="20" height="14" x="2" y="5" rx="2" />
                                <line x1="2" x2="22" y1="10" y2="10" />
                            </svg>
                        </div>
                        <h3>Card controls</h3>
                        <p>Freeze, unfreeze, and review spending across your debit cards with one click from the dashboard.</p>
                    </article>
                    <article class="feature-card">
                        <div class="feature-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9" />
                                <path d="M10.3 21a1.94 1.94 0 0 0 3.4 0" />
                            </svg>
                        </div>
                        <h3>Real-time alerts</h3>
                        <p>Stay informed with timely updates about purchases, logins, transfers, and important account changes.</p>
                    </article>
                    <article class="feature-card">
                        <div class="feature-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="3" y="3" width="7" height="7" />
                                <rect x="14" y="3" width="7" height="7" />
                                <rect x="14" y="14" width="7" height="7" />
                                <rect x="3" y="14" width="7" height="7" />
                            </svg>
                        </div>
                        <h3>Personalized dashboard</h3>
                        <p>See balances, spending trends, upcoming bills, and account health in one easy-to-scan workspace.</p>
                    </article>
                </div>
            </div>
        </section>

        <section class="dashboard-showcase" id="experience">
            <div class="section-inner dashboard-layout">
                <div class="dashboard-copy">
                    <p class="eyebrow">Personalized customer experience</p>
                    <h2>Everything important, right where you need it.</h2>
                    <p>Our dashboards are designed to surface account health, spending insights, and secure actions without friction, making digital banking feel simple and confidence-building.</p>
                    <ul class="info-list">
                        <li>Smart account summaries with spending forecasts</li>
                        <li>Clear recommendations for saving, transfers, and card controls</li>
                        <li>Accessible layouts built for desktop, tablet, and mobile</li>
                    </ul>
                    <a href="/register" class="btn btn-primary btn-md">Open an account</a>
                </div>
                <div class="dashboard-preview" aria-label="Dashboard preview">
                    <div class="summary-topbar">
                        <span>Primary account</span>
                        <span class="summary-badge">+8.2%</span>
                    </div>
                    <h3>$24,840.76</h3>
                    <div class="summary-row">
                        <span>Income</span>
                        <strong>$7,450</strong>
                    </div>
                    <div class="summary-row">
                        <span>Expenses</span>
                        <strong>$4,180</strong>
                    </div>
                    <div class="mini-chart large" aria-hidden="true">
                        <span style="--bar-height: 45%"></span>
                        <span style="--bar-height: 62%"></span>
                        <span style="--bar-height: 52%"></span>
                        <span style="--bar-height: 79%"></span>
                        <span style="--bar-height: 70%"></span>
                        <span style="--bar-height: 88%"></span>
                        <span style="--bar-height: 94%"></span>
                    </div>
                    <div class="snapshot-grid">
                        <div>
                            <span>Savings goal</span>
                            <strong>$9,200</strong>
                        </div>
                        <div>
                            <span>Card status</span>
                            <strong>Active</strong>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="calculator-section" id="tools">
            <div class="section-inner calc-layout">
                <div class="calculator-copy">
                    <p class="eyebrow">Helpful financial tools</p>
                    <h2>See what a smarter plan could look like.</h2>
                    <p>Use a quick estimate to explore monthly loan costs, compare scenarios, and make faster, more confident decisions.</p>
                    <ul class="info-list">
                        <li>Mortgage and loan estimate planning</li>
                        <li>Simple cash-flow and savings insights</li>
                        <li>Transparent, accessible financial guidance</li>
                    </ul>
                </div>
                <div class="calculator-card" aria-live="polite">
                    <div class="calc-header">
                        <span class="calc-badge">Mortgage estimator</span>
                    </div>
                    <div class="calc-form">
                        <label>
                            Home value
                            <input id="loanAmount" type="number" value="420000" min="0" step="1000">
                        </label>
                        <label>
                            Down payment
                            <input id="downPayment" type="number" value="70000" min="0" step="1000">
                        </label>
                        <label>
                            APR
                            <input id="aprRate" type="number" value="6.5" min="0" step="0.1">
                        </label>
                        <label>
                            Term
                            <select id="loanTerm">
                                <option value="15">15 years</option>
                                <option value="30" selected>30 years</option>
                            </select>
                        </label>
                    </div>
                    <div class="calc-result">
                        <p>Estimated monthly payment</p>
                        <div class="result-number" id="monthlyPayment">$0</div>
                        <div class="result-grid">
                            <div>
                                <span>Loan amount</span>
                                <strong id="loanPrincipal">$0</strong>
                            </div>
                            <div>
                                <span>Total paid</span>
                                <strong id="loanTotal">$0</strong>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="support-section" id="resources">
            <div class="section-inner">
                <p class="eyebrow eyebrow-centered">Learning and support</p>
                <h2>Resources that help you feel informed and in control</h2>
                <p class="section-sub">Whether you are planning a purchase or checking your options, Willow makes financial decisions easier to understand.</p>
                <div class="resource-grid">
                    <article class="resource-card">
                        <div class="resource-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" />
                                <path d="M6.5 2H20v15H6.5A2.5 2.5 0 0 1 4 14.5v-10A2.5 2.5 0 0 1 6.5 2Z" />
                            </svg>
                        </div>
                        <h3>Guides & checklists</h3>
                        <p>Learn how to set goals, compare account types, and build financial habits that last.</p>
                    </article>
                    <article class="resource-card">
                        <div class="resource-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="10" />
                                <path d="M9.09 9a3 3 0 0 1 5.82 1c0 2-3 2.5-3 5" />
                                <path d="M12 17h.01" />
                            </svg>
                        </div>
                        <h3>FAQs & education</h3>
                        <p>Find answers to common banking questions, security guidance, and step-by-step tutorials.</p>
                    </article>
                    <article class="resource-card highlight">
                        <div class="resource-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
                            </svg>
                        </div>
                        <h3>Live support</h3>
                        <p>Talk to a Willow specialist for account setup, payment guidance, or security assistance.</p>
                        <a href="/contact" class="btn btn-primary btn-sm">Chat with us</a>
                    </article>
                </div>
            </div>
        </section>

        <section class="trust-section" id="security">
            <div class="section-inner">
                <div>
                    <p class="eyebrow eyebrow-light">Security-first design</p>
                    <h2>Your trust is our foundation.</h2>
                    <p>At Willow Banking Corp., security is built into every layer of the experience, from account access to payments, alerts, and user activity monitoring.</p>
                    <ul class="trust-list">
                        <li>
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="20 6 9 17 4 12" />
                            </svg>
                            Passwords are hashed and never stored in plain text
                        </li>
                        <li>
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="20 6 9 17 4 12" />
                            </svg>
                            Server-side validation protects every transaction
                        </li>
                        <li>
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="20 6 9 17 4 12" />
                            </svg>
                            Audit trails and rate limiting strengthen protection
                        </li>
                    </ul>
                    <div class="trust-badges" aria-label="security badges">
                        <span>SSL protected</span>
                        <span>2FA ready</span>
                        <span>Accessibility aware</span>
                    </div>
                </div>
                <div>
                    <img src="https://images.unsplash.com/photo-1556742049-0cfed4f6a45d?w=800&q=80" alt="Professional customer service interaction" class="trust-image">
                </div>
            </div>
        </section>

        <section class="cta-section">
            <div class="section-inner cta-inner">
                <div>
                    <p class="eyebrow eyebrow-centered">Ready when you are</p>
                    <h2>Take control of your financial future.</h2>
                </div>
                <div class="cta-actions">
                    <a href="/register" class="btn btn-primary btn-lg">Create Your Account</a>
                    <a href="/contact" class="btn btn-secondary btn-lg">Talk to Support</a>
                </div>
            </div>
        </section>
    </main>

    <%- include('partials/public-footer') %>
</body>

</html>