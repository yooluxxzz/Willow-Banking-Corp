<%- include('partials/header') %>

    <body>
        <div class="auth-page">
            <div class="auth-panel">
                <div class="auth-form-wrapper">
                    <a href="/" class="auth-brand" style="text-decoration:none;">
                        <img src="/images/logo.svg" alt="Willow" class="nav-logo-img">
                        Willow Banking Corp.
                    </a>
                    <h1>Open your account</h1>
                    <p class="auth-sub">Create a free Willow Banking account in under a minute.</p>

                    <div id="registerError" class="alert alert-danger hidden">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"
                            stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10" />
                            <line x1="12" x2="12" y1="8" y2="12" />
                            <line x1="12" x2="12.01" y1="16" y2="16" />
                        </svg>
                        <span id="registerErrorText"></span>
                    </div>

                    <form id="registerForm" onsubmit="handleRegister(event)">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <div class="form-group">
                            <label for="fullName">Full Name</label>
                            <input type="text" id="fullName" name="fullName" class="form-control" placeholder="John Doe"
                                required minlength="2" maxlength="100" autocomplete="name">
                        </div>
                        <div class="form-group">
                            <label for="email">Email Address</label>
                            <input type="email" id="email" name="email" class="form-control"
                                placeholder="name@example.com" required autocomplete="email">
                        </div>
                        <div class="form-group">
                            <label for="phone">Phone Number <span class="text-muted">(optional)</span></label>
                            <input type="tel" id="phone" name="phone" class="form-control" placeholder="+1-555-0100"
                                autocomplete="tel">
                        </div>
                        <div class="form-group">
                            <label for="password">Password</label>
                            <input type="password" id="password" name="password" class="form-control"
                                placeholder="Minimum 8 characters" required minlength="8" autocomplete="new-password">
                            <p class="form-help">Must be at least 8 characters</p>
                        </div>
                        <div class="form-group">
                            <label for="confirmPassword">Confirm Password</label>
                            <input type="password" id="confirmPassword" name="confirmPassword" class="form-control"
                                placeholder="Repeat your password" required autocomplete="new-password">
                        </div>
                        <button type="submit" class="btn btn-primary w-full btn-lg" id="registerBtn">Create
                            Account</button>
                    </form>

                    <p class="auth-footer">
                        Already have an account? <a href="/login">Sign in</a>
                    </p>
                    <a href="/" class="auth-back">← Back to Home</a>
                </div>
            </div>
            <div class="auth-image-panel">
                <img src="https://images.unsplash.com/photo-1551836022-d5d88e9218df?w=1200&q=80"
                    alt="Professional business environment">
                <div class="image-overlay">
                    <h2>Start your journey</h2>
                    <p>Join thousands who trust Willow Banking Corp. for their personal and business banking needs.</p>
                </div>
            </div>
        </div>
        <%- include('partials/footer') %>