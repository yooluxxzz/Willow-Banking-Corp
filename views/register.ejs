<%
  const countries = ['United States', 'United Kingdom', 'Portugal', 'Mozambique', 'South Africa', 'Brazil', 'Canada', 'France', 'Germany', 'India', 'Ireland', 'Kenya', 'Netherlands', 'Nigeria', 'Spain', 'Australia', 'Another country'];
  const steps = [['welcome', 'Welcome'], ['personal', 'About you'], ['account', 'Account'], ['security', 'Security'], ['verify', 'Verify'], ['done', 'Done']];
%><%- include('partials/head', { css: ['auth'], bodyClass: 'auth-page is-register' }) %>
<div class="auth-shell">
    <%- include('partials/auth-visual', { scenes: ['wealth', 'business', 'global'] }) %>

    <main class="auth-main" id="main">
        <header class="auth-top">
            <span class="auth-top-brand"><%- include('partials/brand') %></span>
            <span class="demo-badge" title="Willow is a fictional bank. No real money moves.">Demo</span>
            <a class="auth-top-link" href="/login">Sign in</a>
        </header>

        <div class="auth-panel is-wide" data-register>
            <div class="signup-progress" data-signup-progress>
                <div class="signup-progress-head">
                    <p class="label" data-step-label aria-live="polite">Step 1 of 6 · Welcome</p>
                    <button type="button" class="auth-back" data-step-back hidden><%- icon('arrow-left', 'icon-sm') %> Back</button>
                </div>
                <ol class="stepper" aria-hidden="true"><% steps.forEach(([key], index) => { %><li class="<%= index === 0 ? 'is-current' : '' %>" data-step-dot="<%= key %>"></li><% }) %></ol>
                <ol class="signup-step-names" aria-hidden="true"><% steps.forEach(([key, label], index) => { %><li data-step-name="<%= key %>"<%- index === 0 ? ' class="is-current"' : '' %>><%= label %></li><% }) %></ol>
            </div>

            <form id="registerForm" class="auth-form" novalidate>
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                <!-- 1 · Welcome -->
                <section class="signup-step is-active" data-step="welcome" aria-labelledby="stepWelcome">
                    <h1 class="auth-title" id="stepWelcome" tabindex="-1">Open your Willow account.</h1>
                    <p class="auth-sub">It takes about three minutes. Your account starts at $0 — add money, open savings, order cards, set budgets and invest when you’re ready.</p>
                    <ul class="signup-perks" role="list">
                        <li><span class="icon-tile icon-tile-sm"><%- icon('wallet') %></span><div><strong>Checking, savings and currencies</strong><span>Open savings and EUR, GBP, MZN or ZAR accounts when you need them.</span></div></li>
                        <li><span class="icon-tile icon-tile-sm"><%- icon('card') %></span><div><strong>Physical and virtual cards</strong><span>Freeze, limit and control them instantly.</span></div></li>
                        <li><span class="icon-tile icon-tile-sm"><%- icon('chart') %></span><div><strong>Investing</strong><span>Stocks, ETFs and crypto at delayed market prices, funded from your own accounts.</span></div></li>
                    </ul>
                    <div class="notice notice-demo"><%- icon('info') %><div><strong>This is a demonstration.</strong> No real account is opened and no money moves. Please use fictional details and a password you don’t use anywhere else.</div></div>
                    <div class="signup-actions">
                        <button type="button" class="btn btn-primary btn-lg btn-block" data-step-next>Let’s begin <%- icon('arrow-right', 'icon-arrow') %></button>
                    </div>
                    <p class="auth-switch">Already with Willow? <a class="text-link" href="/login">Sign in</a></p>
                </section>

                <!-- 2 · Personal information -->
                <section class="signup-step" data-step="personal" aria-labelledby="stepPersonal" hidden>
                    <h1 class="auth-title" id="stepPersonal" tabindex="-1">Tell us about you.</h1>
                    <p class="auth-sub">We use this to set up your profile. Fictional details are perfect.</p>
                    <div class="field">
                        <label for="fullName">Full name</label>
                        <input class="input input-lg" id="fullName" name="fullName" required minlength="2" maxlength="100" autocomplete="name" aria-describedby="fullNameError">
                        <p class="field-error" id="fullNameError" hidden></p>
                    </div>
                    <div class="field">
                        <label for="email">Email</label>
                        <input class="input input-lg" id="email" name="email" type="email" required maxlength="255" autocomplete="email" autocapitalize="none" spellcheck="false" aria-describedby="emailHelp emailError">
                        <p class="field-help" id="emailHelp">You’ll use this to sign in. Willow doesn’t send email.</p>
                        <p class="field-error" id="emailError" hidden></p>
                    </div>
                    <div class="field-grid">
                        <div class="field">
                            <label for="phone">Phone <span class="optional">· optional</span></label>
                            <input class="input input-lg" id="phone" name="phone" type="tel" maxlength="40" autocomplete="tel" aria-describedby="phoneError">
                            <p class="field-error" id="phoneError" hidden></p>
                        </div>
                        <div class="field">
                            <label for="country">Country of residence</label>
                            <select class="select input-lg" id="country" name="country" required autocomplete="country-name" aria-describedby="countryError">
                                <option value="">Choose…</option>
                                <% countries.forEach(name => { %><option value="<%= name %>"><%= name %></option><% }) %>
                            </select>
                            <p class="field-error" id="countryError" hidden></p>
                        </div>
                    </div>
                    <div class="signup-actions">
                        <button type="button" class="btn btn-primary btn-lg btn-block" data-step-next>Continue</button>
                    </div>
                </section>

                <!-- 3 · Account type -->
                <section class="signup-step" data-step="account" aria-labelledby="stepAccount" hidden>
                    <h1 class="auth-title" id="stepAccount" tabindex="-1">How will you use Willow?</h1>
                    <p class="auth-sub">You can add more accounts — including currency accounts — any time.</p>
                    <fieldset class="option-stack">
                        <legend class="visually-hidden">Account type</legend>
                        <label class="option-card">
                            <input type="radio" name="accountType" value="personal"<%- accountType === 'personal' ? ' checked' : '' %>>
                            <span class="icon-tile"><%- icon('user') %></span>
                            <span><strong>Personal</strong><span class="option-desc">Opens a checking account. Add savings, cards, budgets and investing whenever you like.</span></span>
                            <span class="option-card-check" aria-hidden="true"></span>
                        </label>
                        <label class="option-card">
                            <input type="radio" name="accountType" value="business"<%- accountType === 'business' ? ' checked' : '' %>>
                            <span class="icon-tile"><%- icon('briefcase') %></span>
                            <span><strong>Personal + business</strong><span class="option-desc">Opens personal and business checking, with invoices, an expense log, budgets and a cash-flow dashboard.</span></span>
                            <span class="option-card-check" aria-hidden="true"></span>
                        </label>
                    </fieldset>
                    <div class="signup-actions">
                        <button type="button" class="btn btn-primary btn-lg btn-block" data-step-next>Continue</button>
                    </div>
                </section>

                <!-- 4 · Security -->
                <section class="signup-step" data-step="security" aria-labelledby="stepSecurity" hidden>
                    <h1 class="auth-title" id="stepSecurity" tabindex="-1">Secure your account.</h1>
                    <p class="auth-sub">Choose a password you don’t use anywhere else. You can add two-step verification once you’re in.</p>
                    <div class="field">
                        <label for="password">Password</label>
                        <div class="input-group">
                            <input class="input input-lg" id="password" name="password" type="password" required minlength="8" maxlength="72" autocomplete="new-password" aria-describedby="passwordRules passwordError">
                            <button class="input-action pw-toggle" type="button" data-password-toggle aria-controls="password" aria-label="Show password" aria-pressed="false"><%- icon('eye', 'pw-show') %><%- icon('eye-off', 'pw-hide') %></button>
                        </div>
                        <div class="strength" data-strength aria-hidden="true"><span></span><span></span><span></span><span></span></div>
                        <ul class="password-rules" id="passwordRules" role="list">
                            <li data-rule="length"><%- icon('check', 'icon-sm') %> At least 8 characters</li>
                            <li data-rule="upper"><%- icon('check', 'icon-sm') %> An uppercase letter</li>
                            <li data-rule="lower"><%- icon('check', 'icon-sm') %> A lowercase letter</li>
                            <li data-rule="number"><%- icon('check', 'icon-sm') %> A number</li>
                        </ul>
                        <p class="field-error" id="passwordError" hidden></p>
                    </div>
                    <div class="field">
                        <label for="confirmPassword">Confirm password</label>
                        <input class="input input-lg" id="confirmPassword" name="confirmPassword" type="password" required maxlength="72" autocomplete="new-password" aria-describedby="confirmError">
                        <p class="field-error" id="confirmError" hidden></p>
                    </div>
                    <label class="check-row">
                        <input type="checkbox" name="terms" required aria-describedby="termsError">
                        <span>I understand Willow is a fictional demonstration with simulated money, and I agree to the <a class="text-link" href="/terms" target="_blank" rel="noopener">Terms of use</a> and <a class="text-link" href="/privacy" target="_blank" rel="noopener">Privacy notice</a>.</span>
                    </label>
                    <p class="field-error" id="termsError" hidden></p>
                    <div class="signup-actions">
                        <button type="button" class="btn btn-primary btn-lg btn-block" data-step-next>Continue</button>
                    </div>
                </section>

                <!-- 5 · Verification (simulated) -->
                <section class="signup-step" data-step="verify" aria-labelledby="stepVerify" hidden>
                    <div class="cluster" style="justify-content:space-between;align-items:center">
                        <h1 class="auth-title" id="stepVerify" tabindex="-1">Verify your identity.</h1>
                    </div>
                    <p class="auth-sub">A real bank would check your ID here. <span class="sim-tag">Simulated</span> Willow runs a pretend check instead — no documents, no credit search and nothing leaves this app.</p>
                    <dl class="signup-review" data-review>
                        <div><dt>Name</dt><dd data-review-field="fullName"></dd></div>
                        <div><dt>Email</dt><dd data-review-field="email"></dd></div>
                        <div><dt>Country</dt><dd data-review-field="country"></dd></div>
                        <div><dt>Account</dt><dd data-review-field="accountType"></dd></div>
                    </dl>
                    <button type="button" class="text-link text-sm" data-step-go="personal">Edit details</button>
                    <ol class="kyc-checks" role="list" data-kyc>
                        <li data-kyc-check><span class="kyc-state" aria-hidden="true"></span><div><strong>Identity details</strong><span>Name, email and country look complete.</span></div></li>
                        <li data-kyc-check><span class="kyc-state" aria-hidden="true"></span><div><strong>Watchlist screening</strong><span>Simulated — no real screening database is queried.</span></div></li>
                        <li data-kyc-check><span class="kyc-state" aria-hidden="true"></span><div><strong>Device and session</strong><span>This browser session is set up securely.</span></div></li>
                    </ol>
                    <p class="visually-hidden" data-kyc-status aria-live="polite"></p>
                    <div class="notice notice-error auth-notice" data-register-alert role="alert" tabindex="-1" hidden><%- icon('alert') %><div data-register-alert-text></div></div>
                    <div class="signup-actions">
                        <button type="submit" class="btn btn-primary btn-lg btn-block auth-submit"><span class="btn-label">Verify and open my account</span></button>
                    </div>
                </section>

                <!-- 6 · Confirmation -->
                <section class="signup-step auth-success" data-step="done" aria-labelledby="stepDone" hidden>
                    <div class="success-mark"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg></div>
                    <h1 class="auth-title" id="stepDone" tabindex="-1">Welcome to Willow<span data-done-name></span>.</h1>
                    <p class="auth-sub">Your demo account is open and you’re signed in.</p>
                    <div class="customer-id-card">
                        <span class="label">Your customer ID</span>
                        <strong data-done-customer-id></strong>
                        <span class="text-sm secondary">Sign in with this or your email.</span>
                    </div>
                    <ul class="signup-next" role="list">
                        <li><%- icon('key', 'icon-sm') %> Save recovery codes in Settings so you can reset your password.</li>
                        <li><%- icon('shield-check', 'icon-sm') %> Turn on two-step verification in the Security center.</li>
                        <li><%- icon('plus', 'icon-sm') %> Add money to your checking account to get started — it opens at $0.</li>
                    </ul>
                    <div class="signup-actions">
                        <a class="btn btn-primary btn-lg btn-block" href="/dashboard?welcome=1" data-done-continue>Go to my dashboard <%- icon('arrow-right', 'icon-arrow') %></a>
                    </div>
                </section>
            </form>
        </div>

        <footer class="auth-foot">
            <p class="auth-safety"><%- icon('lock', 'icon-sm') %> Passwords are hashed and never stored in readable form.</p>
            <nav aria-label="Legal"><a href="/demo">About the demo</a><a href="/privacy">Privacy</a><a href="/terms">Terms</a></nav>
        </footer>
    </main>
</div>
<%- include('partials/foot', { js: ['auth'] }) %>
