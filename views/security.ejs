<%- include('partials/header') %>

    <body>
        <div class="app-layout">
            <%- include('partials/sidebar') %>
                <main class="main-content">
                    <div class="page-header">
                        <h1>Security</h1>
                        <p>Manage your account security settings</p>
                    </div>
                    <div class="card mb-6" style="max-width:600px;">
                        <div class="card-header">
                            <h3>Account Security</h3>
                        </div>
                        <div class="card-body">
                            <div
                                style="margin-bottom:var(--space-5);padding-bottom:var(--space-5);border-bottom:1px solid var(--gray-200);">
                                <div class="flex-between">
                                    <div>
                                        <h4 style="margin-bottom:var(--space-1);">Password</h4>
                                        <p class="text-sm text-muted">Your password is securely hashed and stored</p>
                                    </div>
                                    <span class="badge badge-success">Protected</span>
                                </div>
                            </div>
                            <div
                                style="margin-bottom:var(--space-5);padding-bottom:var(--space-5);border-bottom:1px solid var(--gray-200);">
                                <div class="flex-between">
                                    <div>
                                        <h4 style="margin-bottom:var(--space-1);">Session Management</h4>
                                        <p class="text-sm text-muted">Sessions expire after 24 hours of inactivity</p>
                                    </div>
                                    <span class="badge badge-success">Active</span>
                                </div>
                            </div>
                            <div
                                style="margin-bottom:var(--space-5);padding-bottom:var(--space-5);border-bottom:1px solid var(--gray-200);">
                                <div class="flex-between">
                                    <div>
                                        <h4 style="margin-bottom:var(--space-1);">CSRF Protection</h4>
                                        <p class="text-sm text-muted">All state-changing requests are CSRF-protected</p>
                                    </div>
                                    <span class="badge badge-success">Enabled</span>
                                </div>
                            </div>
                            <div>
                                <div class="flex-between">
                                    <div>
                                        <h4 style="margin-bottom:var(--space-1);">Rate Limiting</h4>
                                        <p class="text-sm text-muted">Authentication endpoints are rate-limited</p>
                                    </div>
                                    <span class="badge badge-success">Active</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="card" style="max-width:600px;">
                        <div class="card-header">
                            <h3>Security Practices</h3>
                        </div>
                        <div class="card-body">
                            <ul style="list-style:none;padding:0;">
                                <li class="flex gap-3" style="margin-bottom:var(--space-3);"><svg
                                        xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                                        fill="none" stroke="var(--green-700)" stroke-width="2" stroke-linecap="round"
                                        stroke-linejoin="round">
                                        <polyline points="20 6 9 17 4 12" />
                                    </svg> <span class="text-sm">Passwords are hashed with bcrypt (12 rounds)</span>
                                </li>
                                <li class="flex gap-3" style="margin-bottom:var(--space-3);"><svg
                                        xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                                        fill="none" stroke="var(--green-700)" stroke-width="2" stroke-linecap="round"
                                        stroke-linejoin="round">
                                        <polyline points="20 6 9 17 4 12" />
                                    </svg> <span class="text-sm">All transactions are validated server-side</span></li>
                                <li class="flex gap-3" style="margin-bottom:var(--space-3);"><svg
                                        xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                                        fill="none" stroke="var(--green-700)" stroke-width="2" stroke-linecap="round"
                                        stroke-linejoin="round">
                                        <polyline points="20 6 9 17 4 12" />
                                    </svg> <span class="text-sm">Security headers protect against XSS and
                                        clickjacking</span></li>
                                <li class="flex gap-3" style="margin-bottom:var(--space-3);"><svg
                                        xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                                        fill="none" stroke="var(--green-700)" stroke-width="2" stroke-linecap="round"
                                        stroke-linejoin="round">
                                        <polyline points="20 6 9 17 4 12" />
                                    </svg> <span class="text-sm">Session cookies use httpOnly and sameSite
                                        attributes</span></li>
                                <li class="flex gap-3"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18"
                                        viewBox="0 0 24 24" fill="none" stroke="var(--green-700)" stroke-width="2"
                                        stroke-linecap="round" stroke-linejoin="round">
                                        <polyline points="20 6 9 17 4 12" />
                                    </svg> <span class="text-sm">Administrative actions are fully audited</span></li>
                            </ul>
                        </div>
                    </div>
                </main>
        </div>
        <%- include('partials/footer') %>