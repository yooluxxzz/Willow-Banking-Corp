<%- include('partials/header') %>
<body class="banking-workspace"><div class="app-layout"><%- include('partials/sidebar') %>
<main class="main-content workspace-main"><p class="workspace-eyebrow">YOUR WILLOW / YOUR SECURITY</p>
    <div class="page-header"><h1>Security</h1><p>See where you're signed in and keep control of your account.</p></div>
    <div class="settings-grid mb-6">
        <section class="card"><div class="card-header"><h2>Password and recovery</h2></div><div class="card-body">
            <p>Change your password, save one-time recovery codes, or sign out all other sessions in Settings.</p>
            <a class="btn btn-primary mt-4" href="/settings">Open security settings</a>
        </div></section>
        <section class="card"><div class="card-header"><h2>Recognize your sessions</h2></div><div class="card-body">
            <p>Browser and device names are approximate. A signed-in session does not mean the browser is currently online.</p>
            <p class="mt-3">If you don't recognize a session, sign it out and change your password.</p>
        </div></section>
    </div>
    <section class="card mb-6"><div class="card-header"><h2>Signed-in sessions</h2><a href="/security">Refresh list</a></div><div class="card-body">
        <p id="sessionFeedback" class="settings-feedback" role="status" tabindex="-1" hidden></p>
        <% if (sessionsUnavailable) { %><p role="alert">Sessions could not be loaded. Please refresh to try again.</p>
        <% } else if (!activeSessions.length) { %><p>No saved sessions found. Refresh to check again.</p>
        <% } else { %><ul class="list-none" id="sessionList">
        <% activeSessions.forEach(item => { %><li class="session-row" data-session-id="<%= item.id %>">
            <div><h3><%= item.device %></h3><p class="text-sm text-muted"><% if (item.signedInAt) { %>Signed in <time datetime="<%= item.signedInAt %>"><%= item.signedInAt.replace('T', ' ').slice(0,19) %> UTC</time><% } else { %>Sign-in details unavailable for this older session.<% } %></p></div>
            <% if (item.current) { %><span class="badge badge-success">This session</span><% } else { %><button class="btn btn-secondary" type="button" data-revoke-session="<%= item.id %>" aria-label="Sign out <%= item.device %>">Sign out session</button><% } %>
        </li><% }) %></ul><% } %>
    </div></section>
    <section class="card"><div class="card-header"><h2>Recent sign-ins</h2></div><div class="card-body">
        <% if (!loginHistory.length) { %><p>No sign-ins recorded yet. New sign-ins will appear here.</p><% } else { %><ul class="list-none">
        <% loginHistory.forEach(log => { %><li class="session-row"><div><h3><%= log.device %></h3><p class="text-sm text-muted"><%= log.created_at %> UTC</p></div><span class="badge badge-success">Successful sign-in</span></li><% }) %>
        </ul><% } %>
    </div></section>
</main></div><script src="/js/security-sessions.js" defer></script><%- include('partials/footer') %>
