<%- include('partials/header') %>
<body class="account-overview-page wealth-page">
<div class="app-layout"><%- include('partials/sidebar') %><main class="main-content wealth-main">
    <header class="wealth-heading"><div><p class="wealth-kicker">WILLOW / BUSINESS DEMO</p><h1>Keep the working day in view.</h1><p>Business checking activity and available funds in your Willow demo account.</p></div><span class="wealth-demo-label">SINGLE-OWNER DEMO</span></header>
    <div class="wealth-disclosure" role="note">This workspace is based only on business accounts you own in the demo. It is not a multi-user business banking service; team access, invoices, payroll, lending, scheduled payments and merchant processing are unavailable.</div>
    <% if (!accounts.length) { %>
        <section class="wealth-panel business-empty"><p class="wealth-kicker">NO BUSINESS ACCOUNT</p><h2>Start with business checking.</h2><p>Open a separate zero-balance demo account to view business activity here.</p><a class="wealth-submit business-open-link" href="/accounts/new?type=business">Open business checking</a></section>
    <% } else { %>
        <section class="hub-overview business-overview"><article class="hub-net-worth"><p class="wealth-kicker">AVAILABLE BUSINESS FUNDS</p><strong class="hub-balance"><%= formatCurrency(available) %></strong><p>Across <%= accounts.length %> business demo account<%= accounts.length === 1 ? '' : 's' %> · USD</p><a href="/transfers">Make a demo transfer ↗</a></article><div class="hub-metrics"><article><span>Total balance</span><strong><%= formatCurrency(balance) %></strong><small>Business accounts only</small></article><article><span>Credits this month</span><strong><%= formatCurrency(totals.credits) %></strong><small>Completed ledger entries</small></article><article><span>Debits this month</span><strong><%= formatCurrency(totals.debits) %></strong><small>Completed ledger entries</small></article></div></section>
        <section class="wealth-panel business-accounts"><div class="wealth-panel-heading"><div><p class="wealth-kicker">BUSINESS ACCOUNTS</p><h2>Available accounts</h2></div><a href="/accounts/new?type=business">Open another ↗</a></div><% accounts.forEach(account => { %><a class="hub-account-row" href="/accounts/<%= account.id %>"><span><strong><%= account.displayName %></strong><small><%= account.maskedNumber %> · <%= account.status %></small></span><strong><%= account.balanceFormatted %></strong></a><% }) %></section>
        <section class="wealth-panel business-activity"><div class="wealth-panel-heading"><div><p class="wealth-kicker">BUSINESS LEDGER</p><h2>Recent activity</h2></div><a href="/transactions">All transactions ↗</a></div><% if (!activity.length) { %><p class="wealth-empty">No business account activity yet. Transfers and demo ledger entries will appear here.</p><% } else { %><% activity.forEach(item => { %><div class="hub-expense-row"><span><strong><%= item.description || item.type %></strong><small><%= item.created_at.slice(0,10) %> · <%= item.status %></small></span><strong class="<%= item.direction === 'credit' ? 'wealth-up' : '' %>"><%= item.direction === 'credit' ? '+' : '−' %><%= formatCurrency(item.amount) %></strong></div><% }) %><% } %></section>
    <% } %>
    <p class="wealth-footnote">Credits and debits include completed ledger movements, including transfers. They are not accounting revenue or expense reports.</p>
</main></div><%- include('partials/footer') %>