<%- include('partials/header') %>

    <body class="public-page">
        <%- include('partials/public-nav') %>

            <main class="info-page">
                <div class="info-inner">
                    <h1>Savings Account</h1>
                    <p class="info-sub">Grow your money securely. Earn more on every dollar you save with Willow's
                        high-yield savings account.</p>

                    <section class="info-section">
                        <h2>What is a Savings Account?</h2>
                        <p>A Willow Savings Account is designed for the money you want to set aside and grow. Separate
                            your savings from your spending automatically and watch your balance grow over time. There
                            are no lock-in periods — your money is always accessible.</p>
                    </section>

                    <section class="info-section">
                        <h2>Features &amp; Benefits</h2>
                        <div class="info-grid">
                            <div class="info-card">
                                <h3>High-Yield Interest</h3>
                                <p>Competitive interest applied to your balance, credited automatically every month.</p>
                            </div>
                            <div class="info-card">
                                <h3>Always Accessible</h3>
                                <p>No lock-in periods or withdrawal penalties. Your savings are available when life
                                    happens.</p>
                            </div>
                            <div class="info-card">
                                <h3>Automatic Transfers</h3>
                                <p>Set up recurring transfers from your checking account to save consistently —
                                    effortlessly.</p>
                            </div>
                            <div class="info-card">
                                <h3>Goal Tracking</h3>
                                <p>Name your savings goals — holiday fund, emergency reserve, home deposit — and track
                                    progress.</p>
                            </div>
                            <div class="info-card">
                                <h3>FDIC-Style Protection</h3>
                                <p>Demo platform note: in a real deployment, savings balances would be insured up to
                                    applicable limits.</p>
                            </div>
                            <div class="info-card">
                                <h3>Full Statement History</h3>
                                <p>Download PDF statements for any date range, useful for tax records or financial
                                    planning.</p>
                            </div>
                        </div>
                    </section>

                    <section class="info-section">
                        <h2>Savings vs. Checking — What's the Difference?</h2>
                        <div class="info-grid" style="grid-template-columns:1fr 1fr;">
                            <div class="info-card">
                                <h3>Checking Account</h3>
                                <p>For everyday spending — bills, transfers, debit card purchases. Optimised for
                                    frequent access.</p>
                            </div>
                            <div class="info-card">
                                <h3>Savings Account</h3>
                                <p>For money you want to grow. Fewer daily transactions, higher interest, dedicated to
                                    your goals.</p>
                            </div>
                        </div>
                    </section>

                    <section class="info-cta">
                        <h2>Start saving with Willow</h2>
                        <p>Open a savings account alongside your checking account — takes seconds.</p>
                        <a href="/register" class="btn btn-primary btn-lg">Open a Savings Account</a>
                    </section>
                </div>
            </main>

            <%- include('partials/public-footer') %>
    </body>

    </html>