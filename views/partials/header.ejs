<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="<%= typeof description !== 'undefined' ? description : 'Willow Banking Corp. — Secure, modern financial services' %>">
  <title>
    <%= typeof title !=='undefined' ? title : 'Willow Banking Corp.' %>
  </title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Inter:wght@400;500;600;700&family=Newsreader:opsz,wght@6..72,400;6..72,500;6..72,600&family=JetBrains+Mono:wght@400;500&display=swap"
    rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <% if (typeof currentPath !== 'undefined' && currentPath === '/') { %>
    <link rel="stylesheet" href="/css/hero-blend.css">
  <% } %>
  <% if (typeof csrfToken !=='undefined' ) { %>
    <meta name="csrf-token" content="<%= csrfToken %>">
    <% } %>
      <script>
        (function () {
          var t = localStorage.getItem('willow-theme');
          if (t === 'dark') document.documentElement.setAttribute('data-theme', 'dark');
        })();
      </script>
</head>
