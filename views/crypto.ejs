<%- include('partials/header') %>
<body class="account-overview-page wealth-page">
<div class="app-layout"><%- include('partials/sidebar') %><main class="main-content wealth-main crypto-main">
    <header class="wealth-heading"><div><p class="wealth-kicker">WILLOW / CRYPTO</p><h1>A wallet for the demo economy.</h1><p>Review BTC and ETH holdings and move demo units between Willow profiles.</p></div><span class="wealth-demo-label">SIMULATED ASSETS</span></header>
    <div class="wealth-disclosure" role="note">This is an internal portfolio simulation. There are no public wallet addresses, private keys, blockchain networks or real crypto assets. Wallet sends stay in the Willow demo ledger.</div>
    <section class="crypto-wallet-overview" aria-labelledby="walletTitle"><div class="crypto-wallet-total"><p class="wealth-kicker">DEMO WALLET</p><h2 id="walletTitle">Your crypto holdings</h2><p id="cryptoHoldingCount">Loading assets…</p><a href="/wealth">Explore demo markets ↗</a></div><div id="cryptoHoldings" class="crypto-holding-list"><p class="wealth-loading">Loading wallet…</p></div></section>
    <div class="crypto-columns">
        <section class="wealth-panel crypto-send" aria-labelledby="cryptoSendTitle"><p class="wealth-kicker">INTERNAL DEMO ONLY</p><h2 id="cryptoSendTitle">Send crypto</h2><p>Send available demo units to another active Willow demo profile.</p>
            <form id="cryptoSendForm"><label for="cryptoRecipient">Recipient demo email</label><input id="cryptoRecipient" name="recipientEmail" type="email" maxlength="255" autocomplete="email" required placeholder="customer@example.test"><label for="cryptoSymbol">Asset</label><select id="cryptoSymbol" name="symbol"><option value="BTC">Bitcoin · BTC</option><option value="ETH">Ethereum · ETH</option></select><label for="cryptoQuantity">Quantity</label><input id="cryptoQuantity" name="quantity" type="number" min="0.00000001" max="1000000" step="0.00000001" inputmode="decimal" required placeholder="0.00000000"><p class="crypto-available" id="cryptoAvailable">Available demo units: —</p><button type="submit" class="wealth-submit">Review demo send</button></form>
            <section id="cryptoReview" class="scheduled-review" aria-labelledby="cryptoReviewTitle" tabindex="-1" hidden><h3 id="cryptoReviewTitle">Review demo transfer</h3><p id="cryptoReviewSummary"></p><div class="scheduled-review-actions"><button id="cryptoEdit" type="button" class="wealth-refresh">Edit</button><button id="cryptoConfirm" type="button" class="wealth-submit">Confirm demo send</button></div></section>
            <p id="cryptoStatus" class="wealth-trade-message" role="status" aria-live="polite"></p>
        </section>
        <section class="wealth-panel crypto-receive" aria-labelledby="cryptoReceiveTitle"><p class="wealth-kicker">RECEIVE FROM A WILLOW PROFILE</p><h2 id="cryptoReceiveTitle">Your demo handle</h2><p>Share this email with another Willow demo customer. They can send BTC or ETH to your in-app wallet.</p><div class="crypto-handle"><code id="cryptoDemoHandle">Loading profile…</code><button type="button" id="copyCryptoHandle" class="wealth-refresh">Copy</button></div><p id="copyCryptoStatus" class="wealth-trade-message" role="status" aria-live="polite"></p><div class="crypto-security-note"><strong>Wallet security</strong><p>Transfers require an authenticated Willow session and verified demo recipient. This is not a blockchain address; assets cannot be withdrawn to an external wallet.</p></div></section>
    </div>
    <section class="wealth-panel crypto-history" aria-labelledby="cryptoHistoryTitle"><div class="wealth-panel-heading"><div><p class="wealth-kicker">INTERNAL LEDGER</p><h2 id="cryptoHistoryTitle">Wallet activity</h2></div><span class="wealth-cash-label">Most recent 50</span></div><div id="cryptoHistoryRows"><p class="wealth-loading">Loading wallet activity…</p></div></section>
    <section class="wealth-panel crypto-learning" aria-labelledby="cryptoLearningTitle"><p class="wealth-kicker">LEARN BEFORE YOU INVEST</p><h2 id="cryptoLearningTitle">Crypto carries substantial risk.</h2><p>Prices can change quickly and losses can be total. This simulation is not investment advice and does not provide access to a real digital-asset network.</p></section>
</main></div><script src="/js/crypto.js" defer></script><%- include('partials/footer') %>