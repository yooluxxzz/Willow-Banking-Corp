<%- include('partials/header') %>

<body class="auth-experience-page">
    <a class="skip-link" href="#authMain">Skip to password reset support</a>
    <div class="auth-layout">
        <aside class="auth-visual" aria-label="Willow customer support illustration">
            <img src="https://images.unsplash.com/photo-1522202176988-66273c2fd55f?auto=format&fit=crop&w=1200&q=80" alt="" aria-hidden="true" fetchpriority="high" decoding="async">
            <div class="auth-visual-shade" aria-hidden="true"></div>
            <div class="auth-visual-copy">
                <p class="auth-visual-kicker">Willow Banking Corp. <span>Customer care</span></p>
                <p class="auth-visual-slogan">Need a reset? We can help.</p>
                <p>We keep account security simple, clear, and human when something needs a second look.</p>
            </div>
        </aside>

        <main class="auth-main" id="authMain">
            <div class="auth-topline">
                <a href="/" class="auth-brand">
                    <img src="/images/logo.svg" alt="" class="nav-logo-img">
                    <span>Willow Banking Corp.</span>
                </a>
                <a href="/" class="auth-back-link">Back to Willow</a>
            </div>

            <section class="auth-form-wrapper" aria-labelledby="recoveryTitle">
                <p class="auth-eyebrow">Account access</p>
                <h1 id="recoveryTitle">Reset your access</h1>
                <p class="auth-sub">If you’re locked out of your Willow account, start with our support team. We’ll verify your identity and help you back in securely.</p>

                <div class="auth-message auth-message-info" role="status" aria-live="polite">
                    <strong>Tip:</strong> Our demo platform does not send password reset emails. For account recovery, reach out to Willow support directly.
                </div>

                <div class="auth-support-card" aria-label="Support options">
                    <h2>Support options</h2>
                    <ul>
                        <li><strong>Email:</strong> <a href="mailto:support@willowbanking.test">support@willowbanking.test</a></li>
                        <li><strong>Phone:</strong> <a href="tel:+18005550133">(800) 555-0133</a></li>
                        <li><strong>Hours:</strong> Monday–Friday, 8:00 AM–8:00 PM ET</li>
                    </ul>
                </div>

                <div class="auth-step-actions auth-center-actions">
                    <a href="/login" class="auth-submit auth-link-button">Return to sign in</a>
                    <a href="/contact" class="auth-back-button auth-link-button">Contact support</a>
                </div>

                <p class="auth-switch">Need a new account? <a href="/register">Open an account</a></p>
            </section>

            <footer class="auth-bottomline">
                <a href="/contact">Help and support</a>
                <a href="/privacy">Privacy</a>
                <a href="/terms">Terms</a>
            </footer>
        </main>
    </div>
    <%- include('partials/footer') %>
</body>
