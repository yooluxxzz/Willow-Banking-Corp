<%- include('partials/head', { css: ['auth'], bodyClass: 'auth-page' }) %>
<div class="auth-shell">
    <%- include('partials/auth-visual', { scenes: ['wealth', 'everyday'] }) %>

    <main class="auth-main" id="main">
        <header class="auth-top">
            <span class="auth-top-brand"><%- include('partials/brand') %></span>
            <span class="demo-badge" title="Willow is a fictional bank. No real money moves.">Demo</span>
            <a class="auth-top-link" href="/login"><%- icon('arrow-left', 'icon-sm') %> Back to sign in</a>
        </header>

        <div class="auth-panel" data-recovery>
            <section class="auth-view is-active" data-auth-view="reset" aria-labelledby="recoveryTitle">
                <span class="auth-hero-icon"><%- icon('key') %></span>
                <h1 class="auth-title" id="recoveryTitle" tabindex="-1">Reset your password.</h1>
                <p class="auth-sub">Use your email and one of the recovery codes you saved in Settings. Each code works once.</p>
                <div class="notice notice-error auth-notice" id="recoveryStatus" data-auth-alert role="alert" tabindex="-1" hidden><%- icon('alert') %><div data-auth-alert-text></div></div>
                <form id="recoveryForm" class="auth-form" novalidate>
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <div class="field">
                        <label for="email">Email</label>
                        <input class="input input-lg" id="email" name="email" type="email" autocomplete="email" autocapitalize="none" spellcheck="false" required maxlength="255">
                    </div>
                    <div class="field">
                        <label for="recoveryCode">Recovery code</label>
                        <input class="input input-lg code-input is-text" id="recoveryCode" name="recoveryCode" autocomplete="off" spellcheck="false" autocapitalize="characters" required maxlength="64" placeholder="XXXX-XXXX" aria-describedby="codeHelp">
                        <p id="codeHelp" class="field-help">Enter one unused code from the set you saved.</p>
                    </div>
                    <div class="field">
                        <label for="newPassword">New password</label>
                        <div class="input-group">
                            <input class="input input-lg" id="newPassword" name="newPassword" type="password" autocomplete="new-password" minlength="8" maxlength="72" required aria-describedby="passwordHelp">
                            <button class="input-action pw-toggle" type="button" data-password-toggle aria-controls="newPassword" aria-label="Show password" aria-pressed="false"><%- icon('eye', 'pw-show') %><%- icon('eye-off', 'pw-hide') %></button>
                        </div>
                        <p id="passwordHelp" class="field-help">At least 8 characters, with an uppercase letter, a lowercase letter and a number.</p>
                    </div>
                    <div class="field">
                        <label for="confirmPassword">Confirm new password</label>
                        <input class="input input-lg" id="confirmPassword" name="confirmPassword" type="password" autocomplete="new-password" minlength="8" maxlength="72" required>
                    </div>
                    <button class="btn btn-primary btn-lg btn-block auth-submit" type="submit"><span class="btn-label">Reset password</span></button>
                </form>
                <div class="auth-help-card">
                    <h2>No recovery code?</h2>
                    <p>If you’re still signed in somewhere, create new codes in <a class="text-link" href="/settings#recovery">Settings</a> using your current password.</p>
                    <p>Willow Demo doesn’t send reset emails, so without a code, self-service recovery isn’t possible. Ask whoever runs your demo instance — or <a class="text-link" href="/register">open a new account</a>.</p>
                </div>
            </section>

            <section class="auth-view auth-success" data-auth-view="success" aria-labelledby="resetDoneTitle" hidden>
                <div class="success-mark"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg></div>
                <h1 class="auth-title" id="resetDoneTitle" tabindex="-1">Password reset.</h1>
                <p class="auth-sub" role="status">That recovery code is now used up, and any other sessions were signed out. Taking you to sign in…</p>
                <a class="btn btn-primary btn-lg btn-block" href="/login?reset=success">Sign in</a>
            </section>
        </div>

        <footer class="auth-foot">
            <p class="auth-safety"><%- icon('shield', 'icon-sm') %> Willow will never ask for your recovery codes by message or phone.</p>
            <nav aria-label="Legal"><a href="/help/security">Security help</a><a href="/privacy">Privacy</a><a href="/terms">Terms</a></nav>
        </footer>
    </main>
</div>
<%- include('partials/foot', { js: ['auth'] }) %>
