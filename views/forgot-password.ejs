<%- include('partials/header') %>

<body class="auth-experience-page">
    <a class="skip-link" href="#authMain">Skip to password recovery</a>
    <div class="auth-layout">
        <aside class="auth-visual" aria-label="Willow customer support illustration">
            <img src="https://images.unsplash.com/photo-1522202176988-66273c2fd55f?auto=format&fit=crop&w=1200&q=80" alt="" aria-hidden="true" fetchpriority="high" decoding="async">
            <div class="auth-visual-shade" aria-hidden="true"></div>
            <div class="auth-visual-copy">
                <p class="auth-visual-kicker">Willow Banking Corp. <span>Customer care</span></p>
                <p class="auth-visual-slogan">Need a reset? We can help.</p>
                <p>We keep account security simple, clear, and human when something needs a second look.</p>
            </div>
        </aside>

        <main class="auth-main" id="authMain">
            <div class="auth-topline">
                <a href="/" class="auth-brand">
                    <img src="/images/logo.svg" alt="" class="nav-logo-img">
                    <span>Willow Banking Corp.</span>
                </a>
                <a href="/" class="auth-back-link">Back to Willow</a>
            </div>

            <section class="auth-form-wrapper" aria-labelledby="recoveryTitle">
                <p class="auth-eyebrow">Account access</p>
                <h1 id="recoveryTitle">Reset your access</h1>
                <p class="auth-sub">Use your email and one of the backup codes you saved in account settings.</p>
                <div id="recoveryStatus" class="auth-message auth-message-error" role="status" tabindex="-1" hidden></div>
                <form id="recoveryForm">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <div class="auth-field"><label for="email">Email address</label><input class="form-control" id="email" name="email" type="email" autocomplete="email" required maxlength="255"></div>
                    <div class="auth-field"><label for="recoveryCode">One-time recovery code</label><input class="form-control font-mono" id="recoveryCode" name="recoveryCode" autocomplete="off" spellcheck="false" autocapitalize="characters" required maxlength="64" aria-describedby="codeHelp"><p id="codeHelp" class="form-hint">Enter one unused code from your saved set.</p></div>
                    <div class="auth-field"><label for="newPassword">New password</label><input class="form-control" id="newPassword" name="newPassword" type="password" autocomplete="new-password" minlength="8" maxlength="72" required aria-describedby="passwordHelp"><p id="passwordHelp" class="form-hint">At least 8 characters, including uppercase, lowercase and a number.</p></div>
                    <div class="auth-field"><label for="confirmPassword">Confirm new password</label><input class="form-control" id="confirmPassword" name="confirmPassword" type="password" autocomplete="new-password" minlength="8" maxlength="72" required></div>
                    <button class="auth-submit" type="submit">Reset password</button>
                </form>
                <div class="auth-support-card">
                    <h2>No recovery code?</h2>
                    <p>Still signed in on another device? Generate codes in <a href="/settings#recovery">account settings</a> using your current password.</p>
                    <p>This demo does not send reset emails. If you have forgotten your password and have no saved code, self-service recovery is unavailable. Contact the person running your demo.</p>
                </div>
                <p class="auth-switch"><a href="/login">Return to sign in</a></p>
                <p class="auth-switch">Need a new account? <a href="/register">Open an account</a></p>
            </section>

            <footer class="auth-bottomline">
                <a href="/contact">Help and support</a>
                <a href="/privacy">Privacy</a>
                <a href="/terms">Terms</a>
            </footer>
        </main>
    </div>
    <script src="/js/password-recovery.js" defer></script>
    <%- include('partials/footer') %>
</body>
