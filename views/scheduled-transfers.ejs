<%- include('partials/header') %>
<body class="account-overview-page wealth-page">
<div class="app-layout"><%- include('partials/sidebar') %><main class="main-content wealth-main scheduled-main">
    <header class="wealth-heading"><div><p class="wealth-kicker">WILLOW / MOVE MONEY</p><h1>Plan a transfer for later.</h1><p>Schedule a one-time movement between your own active USD demo accounts.</p></div><span class="wealth-demo-label">DEMO · NO REAL PAYMENTS</span></header>
    <div class="wealth-disclosure" role="note">Nothing moves when you schedule. The demo server attempts the transfer on the selected UTC date, only between accounts you own. It can fail if an account is inactive, funds are insufficient or the daily demo limit is reached. External bill pay and recurring payments are not connected.</div>
    <div class="scheduled-layout">
        <section class="wealth-panel scheduled-create" aria-labelledby="scheduleTitle">
            <p class="wealth-kicker">ONE-TIME TRANSFER</p><h2 id="scheduleTitle">Create a schedule</h2>
            <form id="scheduledForm">
                <label for="scheduleFrom">From account</label><select id="scheduleFrom" name="fromAccountId" required><option value="">Choose an account</option><% accounts.forEach(account => { %><option value="<%= account.id %>"><%= account.displayName %> · <%= account.maskedNumber %> · <%= account.availableBalanceFormatted %> available</option><% }) %></select>
                <label for="scheduleTo">To account</label><select id="scheduleTo" name="toAccountId" required><option value="">Choose an account</option><% accounts.forEach(account => { %><option value="<%= account.id %>"><%= account.displayName %> · <%= account.maskedNumber %></option><% }) %></select>
                <label for="scheduleAmount">Amount · USD</label><input id="scheduleAmount" name="amount" type="number" min="0.01" max="25000" step="0.01" inputmode="decimal" placeholder="0.00" required>
                <label for="scheduleDate">Transfer date · UTC</label><input id="scheduleDate" name="scheduledDate" type="date" min="<%= minScheduleDate %>" required><small>The server checks for due transfers once per minute.</small>
                <label for="scheduleDescription">Description <span>(optional)</span></label><input id="scheduleDescription" name="description" type="text" maxlength="120" placeholder="For example, monthly savings">
                <label class="scheduled-ack"><input id="scheduleAcknowledgement" type="checkbox" required><span>I understand this is a simulated transfer between my own accounts.</span></label>
                <button type="submit" class="wealth-submit">Review scheduled transfer</button>
            </form>
            <section id="scheduleReview" class="scheduled-review" aria-labelledby="scheduleReviewTitle" tabindex="-1" hidden>
                <h3 id="scheduleReviewTitle">Review before scheduling</h3>
                <dl><div><dt>From</dt><dd id="reviewScheduleFrom"></dd></div><div><dt>To</dt><dd id="reviewScheduleTo"></dd></div><div><dt>Amount</dt><dd id="reviewScheduleAmount"></dd></div><div><dt>Date (UTC)</dt><dd id="reviewScheduleDate"></dd></div></dl>
                <div class="scheduled-review-actions"><button id="editSchedule" type="button" class="wealth-refresh">Edit</button><button id="confirmSchedule" type="button" class="wealth-submit">Confirm schedule</button></div>
            </section>
            <p id="scheduleStatus" class="wealth-trade-message" role="status" aria-live="polite"></p>
        </section>
        <section class="wealth-panel scheduled-list" aria-labelledby="scheduledListTitle"><div class="wealth-panel-heading"><div><p class="wealth-kicker">YOUR ACTIVITY</p><h2 id="scheduledListTitle">Scheduled and recent</h2></div><button type="button" id="refreshSchedules" class="wealth-refresh">Refresh</button></div><div id="scheduledRows" aria-live="polite"><p class="wealth-loading">Loading scheduled transfers…</p></div></section>
    </div>
    <p class="wealth-footnote">Amounts remain in the demo account until a due transfer executes. Cancellation is available only while a transfer is pending.</p>
</main></div><script src="/js/scheduled-transfers.js" defer></script><%- include('partials/footer') %>