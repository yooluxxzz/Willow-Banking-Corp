<%- include('partials/header') %>

    <body>
        <div class="app-layout">
            <%- include('partials/sidebar') %>
                <main class="main-content">
                    <div class="page-header">
                        <h1>Your Accounts</h1>
                        <p>View and manage your bank accounts</p>
                    </div>
                    <div id="accountsContainer" class="loading-overlay">
                        <div class="spinner"></div>
                    </div>
                </main>
        </div>
        <script>
            const csrfToken = '<%= csrfToken %>';
            document.addEventListener('DOMContentLoaded', async () => {
                try {
                    const res = await fetch('/api/accounts', { headers: { 'Accept': 'application/json' } });
                    const data = await res.json();
                    if (!res.ok) throw new Error(data.error);
                    const c = document.getElementById('accountsContainer');
                    if (!data.accounts.length) {
                        c.innerHTML = '<div class="empty-state"><h3>No accounts</h3><p>You don\'t have any accounts yet.</p></div>';
                        return;
                    }
                    let html = '<div class="stats-grid">';
                    data.accounts.forEach(a => {
                        html += `<div class="card account-card"><div class="card-body">
          <div class="account-type">${a.account_type}</div>
          <div class="account-number font-mono">${a.maskedNumber}</div>
          <div class="account-balance">${a.balanceFormatted}</div>
          <div class="account-available">Available: ${a.availableBalanceFormatted}</div>
          <div style="margin-top:var(--space-3);font-size:0.75rem;color:var(--gray-500);">
            Account #: ${a.account_number} &bull; Status: <span class="badge badge-${a.status === 'active' ? 'success' : 'warning'}">${a.status}</span>
          </div>
        </div></div>`;
                    });
                    html += '</div>';
                    c.innerHTML = html;
                } catch (e) {
                    document.getElementById('accountsContainer').innerHTML = '<div class="alert alert-danger">' + (e.message || 'Failed to load accounts.') + '</div>';
                }
            });
        </script>
        <%- include('partials/footer') %>