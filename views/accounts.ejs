<%- include('partials/header') %>
<body class="account-overview-page"><div class="app-layout"><%- include('partials/sidebar') %><main class="main-content overview-main">
<header class="overview-heading"><div><p class="overview-eyebrow">YOUR WILLOW / ACCOUNTS</p><h1>A place for every plan.</h1><p class="overview-muted">Everyday spending and future plans, clearly connected.</p></div><a class="overview-utility" href="/dashboard">Back to overview ↗</a></header>
<section class="overview-balance overview-balance-compact" aria-labelledby="accountsBalance"><div><p id="accountsBalance" class="overview-eyebrow">AVAILABLE ACROSS ACTIVE ACCOUNTS</p><p class="overview-total"><%= totals.availableFormatted %></p><p>Total balance <%= totals.totalFormatted %> · USD</p></div><div class="overview-balance-aside"><span class="overview-demo">DEMO · SIMULATED FUNDS</span><div class="overview-balance-actions"><a href="/transfers">Move money ↗</a></div></div></section>
<div class="overview-section-heading"><h2>Your accounts <span class="overview-count"><%= accounts.length %></span></h2><p class="overview-muted">Choose an account to view details or give it a name.</p></div>
<%- include('partials/account-tiles', { accounts }) %>
<section class="overview-account-tip"><div><p class="overview-eyebrow">MAKE IT YOURS</p><h2>Small details. A clearer picture.</h2><p>Name your accounts for what matters to you, then find their activity and statements in one place.</p></div><a href="/statements">Explore statements ↗</a></section>
<p class="overview-footnote">Account totals include active accounts only. No real funds are held or transferred.</p>
</main></div><%- include('partials/footer') %>
