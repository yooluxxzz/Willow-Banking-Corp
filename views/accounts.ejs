<%- include('partials/header') %>
<body><div class="app-layout"><%- include('partials/sidebar') %>
<main class="main-content">
    <div class="page-header"><h1>Your accounts</h1><p>A clear view of your money, with names that make sense to you.</p></div>
    <div class="card mb-6"><div class="card-body"><p class="text-muted">Available across active accounts</p><h2><%= totals.availableFormatted %></h2></div></div>
    <% if (!accounts.length) { %><div class="empty-state"><h2>No accounts yet</h2><p>Your accounts will appear here when available.</p></div><% } %>
    <div class="stats-grid">
    <% accounts.forEach(account => { %>
        <section class="card account-card"><div class="card-body">
            <p class="account-type"><%= account.account_type %> · <%= account.status %></p>
            <h2 class="account-display-name"><a href="/accounts/<%= account.id %>"><%= account.displayName %></a></h2>
            <p class="account-number font-mono"><%= account.maskedNumber %></p>
            <div class="account-balance"><%= account.balanceFormatted %></div>
            <p class="account-available">Available: <%= account.availableBalanceFormatted %></p>
            <div class="settings-actions mt-4"><a class="btn btn-primary" href="/accounts/<%= account.id %>">View account</a><a class="btn btn-secondary" href="/transactions?accountId=<%= account.id %>">Activity</a></div>
        </div></section>
    <% }) %>
    </div>
</main></div><%- include('partials/footer') %>
