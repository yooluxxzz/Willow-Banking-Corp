<%- include('partials/header') %>

    <body class="public-page">
        <%- include('partials/public-nav') %>

            <main class="info-page">
                <div class="info-inner">
                    <h1>Press & Media</h1>
                    <p class="info-sub">Latest news and announcements from Willow Banking Corp.</p>

                    <section class="info-section">
                        <h2>Recent Announcements</h2>
                        <div class="press-list">
                            <article class="press-item">
                                <span class="press-date">September 2024</span>
                                <h3>Willow Banking Launches Redesigned Platform</h3>
                                <p>We're excited to announce our completely redesigned banking platform featuring
                                    enhanced security, real-time transaction tracking, and a modern user experience
                                    built from the ground up.</p>
                            </article>
                            <article class="press-item">
                                <span class="press-date">July 2024</span>
                                <h3>Willow Banking Achieves SOC 2 Type II Compliance</h3>
                                <p>Our commitment to security reaches a new milestone as we complete our SOC 2 Type II
                                    audit, verifying our controls for data security, availability, and confidentiality.
                                </p>
                            </article>
                            <article class="press-item">
                                <span class="press-date">March 2024</span>
                                <h3>Instant Transfers Now Available for All Customers</h3>
                                <p>All Willow Banking customers can now enjoy zero-fee instant transfers between
                                    accounts, with funds available immediately.</p>
                            </article>
                            <article class="press-item">
                                <span class="press-date">January 2024</span>
                                <h3>Willow Banking Named "Best Digital Bank" by FinTech Awards</h3>
                                <p>Our innovative approach to digital banking has been recognized with the prestigious
                                    Best Digital Bank award at the 2024 FinTech Innovation Awards.</p>
                            </article>
                        </div>
                    </section>

                    <section class="info-section">
                        <h2>Media Contact</h2>
                        <div class="info-card" style="max-width:480px;">
                            <h3>Press Inquiries</h3>
                            <p>For media inquiries, interview requests, or press kit access, please contact our
                                communications team.</p>
                            <p style="margin-top:0.75rem;"><strong>Email:</strong> press@willowbank.com</p>
                            <p><strong>Phone:</strong> +1 (555) 012-3456</p>
                        </div>
                    </section>
                </div>
            </main>

