<%- include('partials/header') %>

    <body class="public-page">
        <%- include('partials/public-nav') %>

            <main class="info-page">
                <div class="info-inner info-legal">
                    <h1>Security at Willow Banking</h1>
                    <p class="info-sub">Your security is our top priority. Here's how we protect your accounts and data.
                    </p>

                    <section class="info-section">
                        <h2>How We Protect You</h2>
                        <div class="info-grid">
                            <div class="info-card">
                                <h3>Encrypted Passwords</h3>
                                <p>All passwords are hashed with bcrypt using industry-standard salt rounds. We never
                                    store passwords in plaintext.</p>
                            </div>
                            <div class="info-card">
                                <h3>CSRF Protection</h3>
                                <p>Every state-changing request is protected by anti-forgery tokens, preventing
                                    unauthorized actions on your account.</p>
                            </div>
                            <div class="info-card">
                                <h3>Rate Limiting</h3>
                                <p>Login attempts and sensitive operations are rate-limited to prevent brute-force
                                    attacks and abuse.</p>
                            </div>
                            <div class="info-card">
                                <h3>Secure Sessions</h3>
                                <p>Sessions are managed server-side with secure, HTTP-only cookies that are resistant to
                                    client-side tampering.</p>
                            </div>
                        </div>
                    </section>

                    <section class="info-section">
                        <h2>Transaction Security</h2>
                        <ul>
                            <li>All financial transactions are validated server-side</li>
                            <li>Atomic database operations prevent partial transaction failures</li>
                            <li>Comprehensive audit logging tracks every administrative action</li>
                            <li>Real-time notifications alert you to account activity</li>
                            <li>Daily spending limits on card transactions</li>
                        </ul>
                    </section>

                    <section class="info-section">
                        <h2>Best Practices for Account Safety</h2>
                        <ul>
                            <li>Use a strong, unique password of at least 8 characters</li>
                            <li>Never share your login credentials with anyone</li>
                            <li>Log out of your account when using shared devices</li>
                            <li>Review your transaction history regularly for unauthorized activity</li>
                            <li>Contact us immediately if you suspect unauthorized access</li>
                        </ul>
                    </section>

                    <section class="info-section">
                        <h2>Report a Security Concern</h2>
                        <p>If you discover a security vulnerability or suspect your account has been compromised,
                            contact our security team at <strong>security@willowbank.com</strong> or call <strong>+1
                                (555) 012-3456</strong>.</p>
                    </section>
                </div>
            </main>

            <%- include('partials/public-footer') %>
    </body>

    </html>