<%- include('partials/header') %>

    <body class="public-page">
        <%- include('partials/public-nav') %>

            <main class="info-page">
                <div class="info-inner">
                    <h1>Careers at Willow Banking</h1>
                    <p class="info-sub">Join a team that's redefining what banking can be. We're always looking for
                        talented, driven individuals.</p>

                    <section class="info-section">
                        <h2>Why Work With Us</h2>
                        <div class="info-grid">
                            <div class="info-card">
                                <h3>Competitive Compensation</h3>
                                <p>Market-leading salaries, equity participation, and comprehensive benefits including
                                    health, dental, and vision coverage.</p>
                            </div>
                            <div class="info-card">
                                <h3>Growth Opportunities</h3>
                                <p>Continuous learning programs, mentorship, and clear career progression paths for
                                    every team member.</p>
                            </div>
                            <div class="info-card">
                                <h3>Flexible Work</h3>
                                <p>Remote-first culture with flexible hours and the tools you need to do your best work
                                    from anywhere.</p>
                            </div>
                            <div class="info-card">
                                <h3>Impact</h3>
                                <p>Your work directly shapes how thousands of people manage their finances every day.
                                </p>
                            </div>
                        </div>
                    </section>

                    <section class="info-section">
                        <h2>Open Positions</h2>
                        <div class="job-list">
                            <div class="job-item">
                                <div>
                                    <h4>Senior Full-Stack Engineer</h4>
                                    <p>Engineering · Remote · Full-time</p>
                                </div>
                                <span class="badge badge-success">Open</span>
                            </div>
                            <div class="job-item">
                                <div>
                                    <h4>Product Designer</h4>
                                    <p>Design · Remote · Full-time</p>
                                </div>
                                <span class="badge badge-success">Open</span>
                            </div>
                            <div class="job-item">
                                <div>
                                    <h4>Security Engineer</h4>
                                    <p>Infrastructure · Remote · Full-time</p>
                                </div>
                                <span class="badge badge-success">Open</span>
                            </div>
                            <div class="job-item">
                                <div>
                                    <h4>Customer Success Manager</h4>
                                    <p>Support · Hybrid · Full-time</p>
                                </div>
                                <span class="badge badge-success">Open</span>
                            </div>
                            <div class="job-item">
                                <div>
                                    <h4>Compliance Analyst</h4>
                                    <p>Legal · Remote · Full-time</p>
                                </div>
                                <span class="badge badge-success">Open</span>
                            </div>
                        </div>
                    </section>

                    <section class="info-cta">
                        <h2>Don't see your role?</h2>
                        <p>We're always interested in meeting talented people. Send us your resume.</p>
                        <a href="/contact" class="btn btn-primary btn-lg">Get in Touch</a>
                    </section>
                </div>
            </main>

            <%- include('partials/public-footer') %>
    </body>

    </html>