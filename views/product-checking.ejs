<%- include('partials/header') %>

    <body class="public-page">
        <%- include('partials/public-nav') %>

            <main class="info-page">
                <div class="info-inner">
                    <h1>Checking Account</h1>
                    <p class="info-sub">Everyday banking made effortless. Access your money whenever you need it, with
                        zero hidden fees.</p>

                    <section class="info-section">
                        <h2>What is a Checking Account?</h2>
                        <p>A Willow Checking Account is your primary day-to-day account. Use it to pay bills, make
                            purchases, send money to friends, and receive your paycheck — all from one place. There are
                            no minimum balance requirements and no monthly maintenance fees.</p>
                    </section>

                    <section class="info-section">
                        <h2>Features &amp; Benefits</h2>
                        <div class="info-grid">
                            <div class="info-card">
                                <h3>No Fees</h3>
                                <p>No monthly fees, no overdraft penalty surprises. What you see is what you get.</p>
                            </div>
                            <div class="info-card">
                                <h3>Instant Transfers</h3>
                                <p>Send and receive money in real-time to any other Willow customer, 24/7.</p>
                            </div>
                            <div class="info-card">
                                <h3>Linked Debit Card</h3>
                                <p>Every checking account comes with a Willow Visa debit card, ready to use online and
                                    in store.</p>
                            </div>
                            <div class="info-card">
                                <h3>Transaction History</h3>
                                <p>View, search, and filter every transaction — export statements as PDF at any time.
                                </p>
                            </div>
                            <div class="info-card">
                                <h3>Real-Time Alerts</h3>
                                <p>Instant notifications for every deposit, withdrawal, and transfer so nothing slips
                                    by.</p>
                            </div>
                            <div class="info-card">
                                <h3>Daily Withdrawal Limit</h3>
                                <p>Up to $10,000 per day for withdrawals, keeping your funds secure while remaining
                                    flexible.</p>
                            </div>
                        </div>
                    </section>

                    <section class="info-section">
                        <h2>How It Works</h2>
                        <div class="timeline">
                            <div class="timeline-item">
                                <span class="timeline-year">Step 1</span>
                                <div>
                                    <h4>Open Your Account</h4>
                                    <p>Register in under a minute — just your name, email, and a secure password.</p>
                                </div>
                            </div>
                            <div class="timeline-item">
                                <span class="timeline-year">Step 2</span>
                                <div>
                                    <h4>Make a Deposit</h4>
                                    <p>Fund your account instantly. Up to $50,000 per day via our secure deposit portal.
                                    </p>
                                </div>
                            </div>
                            <div class="timeline-item">
                                <span class="timeline-year">Step 3</span>
                                <div>
                                    <h4>Start Banking</h4>
                                    <p>Pay bills, send transfers, freeze/unfreeze your card — everything in one
                                        dashboard.</p>
                                </div>
                            </div>
                        </div>
                    </section>

                    <section class="info-cta">
                        <h2>Open your Checking Account today</h2>
                        <p>Free to open. No minimum balance. Takes under a minute.</p>
                        <a href="/register" class="btn btn-primary btn-lg">Get Started — It's Free</a>
                    </section>
                </div>
            </main>

            <%- include('partials/public-footer') %>
    </body>

    </html>