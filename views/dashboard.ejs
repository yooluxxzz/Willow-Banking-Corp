<%- include('partials/header') %>
<body class="account-overview-page"><div class="app-layout"><%- include('partials/sidebar') %><main class="main-content overview-main">
<header class="overview-heading"><div><p class="overview-eyebrow">YOUR WILLOW / OVERVIEW</p><h1>Good to see you, <%= user.full_name.split(' ')[0] %>.</h1><p class="overview-muted">Your everyday money, all in one place.</p></div><a class="overview-utility" href="/notifications">Notifications<% if (unreadNotifications) { %><span><%= unreadNotifications %> unread</span><% } %> <span aria-hidden="true">↗</span></a></header>
<section class="overview-balance" aria-labelledby="balanceTitle"><div><p class="overview-eyebrow" id="balanceTitle">AVAILABLE BALANCE</p><p class="overview-total"><%= totals.availableFormatted %></p><p>Across <%= accounts.filter(a => a.status === 'active').length %> active accounts · USD</p><div class="overview-balance-actions"><a href="/transfers">Make a transfer <span aria-hidden="true">↗</span></a><a href="/accounts">View accounts</a></div></div><div class="overview-balance-aside"><img src="/images/logo.svg" alt="" aria-hidden="true"><p>Total balance</p><strong><%= totals.totalFormatted %></strong><small>Across active accounts</small><span class="overview-demo">DEMO · SIMULATED FUNDS</span></div></section>
<nav class="overview-actions" aria-label="Everyday banking"><% [['/deposits','↓','Add demo funds'],['/withdrawals','↑','Withdraw'],['/cards','▤','Manage cards'],['/statements','≡','Statements']].forEach(([url,icon,label]) => { %><a href="<%= url %>"><span aria-hidden="true"><%= icon %></span><%= label %><span class="overview-action-arrow" aria-hidden="true">↗</span></a><% }) %></nav>
<div class="overview-section-heading"><h2>Your accounts</h2><a href="/accounts">Manage accounts →</a></div>
<%- include('partials/account-tiles', { accounts }) %>
<div class="overview-lower"><section class="overview-panel" aria-labelledby="recentTitle"><div class="overview-section-heading"><h2 id="recentTitle">Recent activity</h2><a href="/transactions">View all →</a></div>
<% if (!recentTxns.length) { %><div class="overview-empty"><span class="overview-icon" aria-hidden="true">↔</span><h3>A fresh start</h3><p>Your transactions will appear here. Explore with simulated funds whenever you're ready.</p><a href="/deposits">Add demo funds →</a></div><% } else { %><ul class="overview-activity"><% recentTxns.forEach(txn => { const linked = accounts.find(a => a.id === txn.account_id); %><li><span class="overview-icon" aria-hidden="true"><%= txn.direction === 'credit' ? '↓' : '↑' %></span><div class="overview-activity-copy"><h3><%= txn.description || txn.type %></h3><p><%= txn.created_at.slice(0,10) %> · <%= linked ? linked.displayName : txn.type %> · <%= txn.status %></p></div><strong class="<%= txn.direction === 'credit' ? 'overview-credit' : '' %>"><%= txn.direction === 'credit' ? '+' : '−' %><%= txn.amountFormatted %></strong></li><% }) %></ul><% } %></section>
<aside class="overview-panel overview-help"><p class="overview-eyebrow">A LITTLE PEACE OF MIND</p><h2>Stay in control.</h2><p>Review where you're signed in, save recovery codes and make your account feel like yours.</p><a href="/security">Review your security <span aria-hidden="true">↗</span></a><a href="/settings">Profile and preferences <span aria-hidden="true">↗</span></a><a href="/cards">Your demo cards <span aria-hidden="true">↗</span></a></aside></div>
<p class="overview-footnote">Willow is a fictional banking experience. Balances and transactions are simulated.</p>
</main></div><%- include('partials/footer') %>
