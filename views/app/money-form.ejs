<%
  const deposit = mode === 'deposit';
  const copy = deposit
    ? { label: 'Add money', heading: 'Add demo money', sub: 'Top up an account with simulated funds. No card or bank is charged.', action: 'Add money', done: 'Money added', limit: 'Up to $10,000 a day per account (scaled for other currencies).' }
    : { label: 'Withdraw', heading: 'Withdraw', sub: 'Take simulated money out of an account. No cash is dispensed.', action: 'Withdraw', done: 'Withdrawal complete', limit: 'Daily withdrawal limits apply per account.' };
  const presets = [50, 100, 250, 500];
%><%- include('../partials/app-start', { css: [] }) %>

<a class="back-link" href="/dashboard"><%- icon('arrow-left') %> Home</a>

<div class="flow mt-6" data-money-flow data-mode="<%= mode %>">
    <div class="flow-head">
        <p class="label"><%= copy.label %></p>
        <h1 class="page-head-title mt-2"><%= copy.heading %></h1>
        <p class="page-head-sub mt-2"><%= copy.sub %></p>
        <ol class="stepper mt-6" aria-hidden="true"><li class="is-current" data-flow-dot="0"></li><li data-flow-dot="1"></li><li data-flow-dot="2"></li></ol>
        <p class="flow-step-label"><span data-flow-label>Step 1 of 3 · Amount</span><span class="sim-tag">Simulated</span></p>
    </div>

    <% if (!accounts.length) { %>
    <div class="panel"><div class="empty"><div class="empty-art"><%- icon('wallet') %></div><h3>No active accounts</h3><p>Open an account first.</p><a class="btn btn-primary btn-sm" href="/accounts/new">Open an account</a></div></div>
    <% } else { %>
    <form class="flow-card" id="moneyForm" novalidate>
        <section class="flow-pane" data-flow-pane="0" aria-labelledby="amountTitle">
            <h2 id="amountTitle">How much?</h2>
            <div class="field mt-6">
                <label for="accountId"><%= deposit ? 'Into' : 'From' %></label>
                <select class="select input-lg" id="accountId" name="accountId">
                    <% accounts.forEach(account => { %><option value="<%= account.id %>" data-currency="<%= account.currency %>" data-balance="<%= account.balanceFormatted %>" data-available="<%= account.available_balance %>"<%- account.id === selectedAccountId ? ' selected' : '' %>><%= account.displayName %> · <%= account.balanceFormatted %></option><% }) %>
                </select>
            </div>
            <div class="field">
                <label for="amount">Amount</label>
                <div class="amount-input">
                    <span class="amount-currency" data-amount-symbol>$</span>
                    <input class="input amount-field" id="amount" name="amount" inputmode="decimal" autocomplete="off" placeholder="0.00" aria-describedby="amountHelp amountError">
                </div>
                <div class="cluster mt-3" role="group" aria-label="Quick amounts">
                    <% presets.forEach(value => { %><button type="button" class="chip chip-sm" data-preset="<%= value %>"><span data-amount-symbol>$</span><%= value %></button><% }) %>
                </div>
                <p class="field-help" id="amountHelp"><%= copy.limit %></p>
                <p class="field-error" id="amountError" hidden></p>
            </div>
            <div class="field">
                <label for="description">Note <span class="optional">· optional</span></label>
                <input class="input" id="description" name="description" maxlength="100" placeholder="<%= deposit ? 'e.g. Paycheck' : 'e.g. Cash for the market' %>">
            </div>
            <div class="flow-actions"><button type="button" class="btn btn-primary btn-lg" data-flow-next>Review</button></div>
        </section>

        <section class="flow-pane" data-flow-pane="1" aria-labelledby="reviewTitle" hidden>
            <h2 id="reviewTitle">Review</h2>
            <p class="review-amount figure" data-review-amount data-private></p>
            <dl class="dl-rows mt-6">
                <div><dt><%= deposit ? 'Into' : 'From' %></dt><dd data-review-account></dd></div>
                <div><dt>Note</dt><dd data-review-note></dd></div>
                <div><dt>When</dt><dd>Now</dd></div>
            </dl>
            <div class="notice notice-demo mt-6"><%- icon('info') %><div><%= deposit ? 'These are simulated funds. No card, bank or payment method is charged.' : 'This is a simulated withdrawal. No cash is dispensed and no real money moves.' %></div></div>
            <p class="field-error mt-4" data-submit-error role="alert" tabindex="-1" hidden></p>
            <div class="flow-actions"><button type="button" class="btn btn-ghost" data-flow-back><%- icon('arrow-left', 'icon-sm') %> Edit</button><button type="submit" class="btn btn-primary btn-lg"><%= copy.action %></button></div>
        </section>

        <section class="flow-pane receipt" data-flow-pane="2" aria-labelledby="doneTitle" hidden>
            <div class="success-mark"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg></div>
            <h2 id="doneTitle"><%= copy.done %></h2>
            <p class="receipt-amount" data-receipt-amount data-private></p>
            <p class="receipt-to" data-receipt-to></p>
            <dl class="dl-rows receipt-meta">
                <div><dt>Reference</dt><dd class="mono" data-receipt-ref></dd></div>
                <div><dt>Date</dt><dd data-receipt-date></dd></div>
                <div><dt>Status</dt><dd><span class="status-pill is-completed">Completed</span></dd></div>
            </dl>
            <p class="sim-note"><%- icon('info', 'icon-sm') %> Simulated transaction. No real money moved.</p>
            <div class="flow-actions is-center">
                <a class="btn btn-secondary" data-receipt-account href="/accounts">View account</a>
                <a class="btn btn-primary" href="/dashboard">Done</a>
            </div>
        </section>
    </form>
    <% } %>
</div>

<%- include('../partials/app-end', { js: ['money-form'] }) %>
