<%- include('../partials/app-start', { css: [] }) %>

<header class="page-head">
    <div class="page-head-copy">
        <h1 class="page-head-title">Scheduled transfers</h1>
        <p class="page-head-sub">Set up a one-time transfer between your own accounts for a future date. No real payments — they run on the demo ledger at the start of the scheduled day (UTC).</p>
    </div>
</header>

<div class="layout-main-aside">
    <div class="col-stack">
        <section class="panel" aria-labelledby="upcomingTitle">
            <div class="panel-head"><h2 id="upcomingTitle">Upcoming</h2><button type="button" class="btn btn-ghost btn-sm" id="refreshSchedules"><%- icon('refresh', 'icon-sm') %> Refresh</button></div>
            <div id="scheduledUpcoming" aria-live="polite"></div>
        </section>
        <section class="panel" aria-labelledby="historyTitle">
            <div class="panel-head"><h2 id="historyTitle">History</h2></div>
            <div id="scheduledHistory"></div>
        </section>
    </div>

    <aside>
        <form class="panel" id="scheduledForm" novalidate>
            <div class="panel-head"><h2>Schedule a transfer</h2><span class="sim-tag">No real payments</span></div>
            <% if (accounts.length < 2) { %>
            <p class="muted text-sm">You need two active accounts in the same currency. <a class="text-link" href="/accounts/new?type=savings">Open a savings account</a>.</p>
            <% } else { %>
            <div class="field">
                <label for="scheduleFrom">From</label>
                <select class="select" id="scheduleFrom" name="fromAccountId">
                    <% accounts.forEach(account => { %><option value="<%= account.id %>" data-currency="<%= account.currency %>" data-private-text="<%= account.displayName %>"><%= account.displayName %> · <%= account.balanceFormatted %></option><% }) %>
                </select>
            </div>
            <div class="field">
                <label for="scheduleTo">To</label>
                <select class="select" id="scheduleTo" name="toAccountId">
                    <% accounts.forEach((account, index) => { %><option value="<%= account.id %>" data-currency="<%= account.currency %>"<%= index === 1 ? ' selected' : '' %>><%= account.displayName %> · <%= account.currency %></option><% }) %>
                </select>
            </div>
            <div class="field-grid">
                <div class="field"><label for="scheduleAmount">Amount</label><input class="input" id="scheduleAmount" name="amount" inputmode="decimal" placeholder="0.00" required></div>
                <div class="field"><label for="scheduleDate">Date (UTC)</label><input class="input" id="scheduleDate" name="scheduledDate" type="date" min="<%= minScheduleDate %>" value="<%= minScheduleDate %>" required></div>
            </div>
            <div class="field">
                <label for="scheduleDescription">Description <span class="optional">· optional</span></label>
                <input class="input" id="scheduleDescription" name="description" maxlength="120" placeholder="e.g. Monthly savings">
            </div>
            <p class="field-error mt-3" id="scheduleError" role="alert" hidden></p>
            <div class="form-actions"><button type="submit" class="btn btn-primary">Review</button></div>
            <% } %>
        </form>
    </aside>
</div>

<dialog class="modal" id="scheduleReview" aria-labelledby="scheduleReviewTitle">
    <div class="modal-head"><h2 id="scheduleReviewTitle">Confirm scheduled transfer</h2></div>
    <div class="modal-body">
        <p class="review-amount figure" id="reviewScheduleAmount"></p>
        <dl class="dl-rows mt-5">
            <div><dt>From</dt><dd id="reviewScheduleFrom"></dd></div>
            <div><dt>To</dt><dd id="reviewScheduleTo"></dd></div>
            <div><dt>On</dt><dd id="reviewScheduleDate"></dd></div>
        </dl>
        <p class="text-sm muted mt-4">Money moves on the demo ledger when the day starts in UTC. If there isn’t enough available then, the transfer fails safely and you’ll be notified.</p>
        <p class="field-error mt-3" id="scheduleReviewError" role="alert" hidden></p>
    </div>
    <div class="modal-foot"><button type="button" class="btn btn-secondary" id="editSchedule">Edit</button><button type="button" class="btn btn-primary" id="confirmSchedule">Schedule</button></div>
</dialog>

<%- include('../partials/app-end', { js: ['scheduled-transfers'] }) %>
