<%
  const categories = [['savings', 'Safety net', 'savings'], ['home', 'Home', 'house'], ['travel', 'Travel', 'plane'], ['business', 'Business', 'briefcase'], ['investing', 'Investing', 'trend'], ['other', 'Something else', 'target']];
%><%- include('../partials/app-start', { css: [] }) %>

<header class="page-head">
    <div class="page-head-copy">
        <h1 class="page-head-title">Goals</h1>
        <p class="page-head-sub">Plan for what you’re working toward. Each goal is tied to one of your real personal USD accounts, and progress follows that account’s available balance.</p>
    </div>
    <div class="page-head-actions"><button type="button" class="btn btn-primary" data-goal-new><%- icon('plus') %> New goal</button></div>
</header>

<div class="goal-summary stat-row mb-8" data-goal-summary hidden>
    <div class="stat-tile"><span class="label">Goals</span><span class="figure" data-summary-count>0</span><small>In progress</small></div>
    <div class="stat-tile"><span class="label">Funded so far</span><span class="figure" data-private data-summary-saved>$0</span><small>Actual account funds</small></div>
    <div class="stat-tile"><span class="label">Still to go</span><span class="figure" data-private data-summary-left>$0</span><small>Across all goals</small></div>
    <div class="stat-tile"><span class="label">Overall</span><span class="figure" data-summary-pct>0%</span><small>Of combined targets</small></div>
</div>

<div class="goal-grid" id="goalList" aria-live="polite"></div>

<p class="disclosure-note mt-8"><%- icon('info') %> <span>Goal progress is based only on the available balance of its linked personal USD account. To fund a goal, move real demo funds into that account using <a class="text-link" href="/transfers?mode=own">Move money</a> or <a class="text-link" href="/scheduled-transfers">Scheduled transfers</a>.</span></p>

<dialog class="modal" id="goalDialog" aria-labelledby="goalDialogTitle">
    <form id="goalForm" novalidate>
        <div class="modal-head"><h2 id="goalDialogTitle">New goal</h2><button type="button" class="btn btn-ghost btn-icon" data-dialog-close aria-label="Close"><%- icon('x', 'icon-md') %></button></div>
        <div class="modal-body">
            <input type="hidden" name="id">
            <fieldset class="goal-categories" data-goal-categories>
                <legend class="field-label">What are you working toward?</legend>
                <div class="goal-category-grid">
                    <% categories.forEach(([value, label, iconName], index) => { %>
                    <label class="goal-category"><input type="radio" name="category" value="<%= value %>"<%= index === 0 ? ' checked' : '' %>><span class="icon-tile icon-tile-sm"><%- icon(iconName) %></span><span><%= label %></span></label>
                    <% }) %>
                </div>
            </fieldset>
            <div class="field mt-5"><label for="goalName">Name</label><input class="input" id="goalName" name="name" required minlength="2" maxlength="60" placeholder="e.g. Lisbon in spring"></div>
            <div class="field-grid mt-5">
                <div class="field"><label for="goalTarget">Target</label><div class="input-group has-prefix"><span class="input-prefix">$</span><input class="input num" id="goalTarget" name="targetAmount" inputmode="decimal" required placeholder="5,000"></div></div>
                <div class="field"><label for="goalAccount">Funded by</label><select class="select" id="goalAccount" name="accountId" required></select></div>
            </div>
            <p class="field-error mt-3" data-goal-error role="alert" hidden></p>
        </div>
        <div class="modal-foot"><button type="button" class="btn btn-ghost btn-danger-text" data-goal-delete hidden>Delete goal</button><button type="button" class="btn btn-secondary" data-dialog-close>Cancel</button><button type="submit" class="btn btn-primary">Save goal</button></div>
    </form>
</dialog>

<%- include('../partials/app-end', { js: ['goals'] }) %>
