<%
  const hasAccount = dashboard.accounts.length > 0;
  const profile = dashboard.profile;
  const businessName = profile && profile.name ? profile.name : 'Your business';
  const primary = dashboard.accounts.find(account => account.status === 'active');
  const tabs = [['overview', 'Overview', '/business/dashboard'], ['expenses', 'Expenses & budgets', '/business/expense-log'], ['invoices', 'Invoices', '/business/invoices'], ['team', 'Team', '/business/team']];
  const categoryList = typeof expenseCategories === 'object' && expenseCategories ? Object.entries(expenseCategories) : [];
  const activeUsd = dashboard.accounts.filter(account => account.status === 'active' && account.currency === 'USD');
  const roleText = { admin: 'Full control of accounts, cards and team', approver: 'Approves payments and invoices', cardholder: 'Uses a business card with limits', viewer: 'Read-only access to activity' };
  const today = new Date().toISOString().slice(0, 10);
  const in30 = new Date(Date.now() + 30 * 86400000).toISOString().slice(0, 10);
  const chartData = { months: dashboard.months.map(item => ({ label: item.label, values: { revenue: item.revenueCents / 100, expenses: item.expensesCents / 100 } })), categories: dashboard.categories.slice(0, 6).map(item => ({ label: item.label, value: item.cents / 100, color: item.color })) };
  const openInvoices = dashboard.invoices.filter(item => ['open', 'overdue'].includes(item.displayStatus));
%><%- include('../partials/app-start', { css: [] }) %>

<header class="page-head">
    <div class="page-head-copy">
        <p class="label">Business</p>
        <h1 class="page-head-title" data-business-name><%= businessName %></h1>
        <% if (profile && (profile.industry || profile.country)) { %><p class="page-head-sub"><%= [profile.industry, profile.country].filter(Boolean).join(' · ') %></p><% } %>
    </div>
    <div class="page-head-actions">
        <button type="button" class="btn btn-secondary" data-edit-profile><%- icon('settings') %> Business details</button>
        <% if (section === 'expenses') { %><button type="button" class="btn btn-primary" data-expense-new><%- icon('receipt') %> Log an expense</button><% } else if (!hasAccount) { %><a class="btn btn-primary" href="/business/expense-log#new"><%- icon('receipt') %> Log an expense</a><% } else { %><button type="button" class="btn btn-primary" data-new-invoice><%- icon('invoice') %> New invoice</button><% } %>
    </div>
</header>

<% if (!hasAccount) { %>
<div class="notice notice-info mb-6"><%- icon('briefcase') %><div><strong>No business account yet.</strong> You can log expenses and set budgets now. <a class="text-link" href="/accounts/new?type=business">Open business checking</a> to send invoices, receive payments and pay expenses from the account.</div></div>
<% } %>
<nav class="tabs mb-6" aria-label="Business sections">
    <% tabs.forEach(([key, label, href]) => { %><a href="<%= href %>"<%- section === key ? ' aria-current="page"' : '' %>><%= label %><% if (key === 'invoices' && openInvoices.length) { %> <span class="badge badge-brand"><%= openInvoices.length %></span><% } %></a><% }) %>
</nav>

<% if (section === 'overview') { %>
<div class="stat-row mb-6" data-attention>
    <div class="stat-tile"><span class="label"><%- icon('wallet', 'icon-sm') %> Available</span><span class="figure" data-private><%= money(dashboard.availableCents) %></span><small>USD business accounts</small></div>
    <div class="stat-tile"><span class="label"><%- icon('arrow-down-left', 'icon-sm') %> Money in this month</span><span class="figure positive" data-private><%= money(dashboard.revenueCents) %></span><small>Payments and deposits received</small></div>
    <div class="stat-tile"><span class="label"><%- icon('arrow-up-right', 'icon-sm') %> Money out this month</span><span class="figure" data-private><%= money(dashboard.expensesCents) %></span><small>Logged expenses and account payments</small></div>
    <div class="stat-tile"><span class="label"><%- icon('activity', 'icon-sm') %> Net cash flow</span><span class="figure <%= dashboard.netCents >= 0 ? 'positive' : 'negative' %>" data-private><%= money(dashboard.netCents, 'USD', { sign: true }) %></span><small>This month so far</small></div>
</div>

<div class="layout-main-aside">
    <div class="col-stack">
        <section class="panel" aria-labelledby="cashflowTitle">
            <div class="panel-head"><h2 id="cashflowTitle">Cash flow · six months</h2><span class="legend-inline"><span><i style="background:var(--chart-1)"></i>In</span><span><i style="background:var(--chart-3)"></i>Out</span></span></div>
            <div data-business-chart></div>
        </section>
        <section class="panel" aria-labelledby="expensesTitle">
            <div class="panel-head"><h2 id="expensesTitle">Where the money goes · this month</h2><a class="link-arrow" href="/business/expense-log">Expenses <%- icon('arrow-right') %></a></div>
            <div data-business-categories><% if (!dashboard.categories.length) { %><p class="muted text-sm">No business expenses this month. <a class="text-link" href="/business/expense-log">Log one</a>.</p><% } %></div>
        </section>
        <section class="panel" aria-labelledby="bizActivityTitle">
            <div class="panel-head"><h2 id="bizActivityTitle">Recent activity</h2><% if (primary) { %><a class="link-arrow" href="/transactions?accountId=<%= primary.id %>">All <%- icon('arrow-right') %></a><% } %></div>
            <% if (dashboard.activity.length) { %>
            <ul class="txn-list" role="list">
                <% dashboard.activity.forEach(txn => { %><%- include('../partials/txn-row', { txn, accountName: txn.account_nickname || 'Business' }) %><% }) %>
            </ul>
            <% } else { %><p class="muted text-sm">Activity on your business accounts will appear here.</p><% } %>
        </section>
    </div>
    <aside class="col-stack">
        <section class="panel" aria-labelledby="quickTitle">
            <div class="panel-head"><h2 id="quickTitle">Quick actions</h2></div>
            <div class="quick-actions is-light biz-actions">
                <% if (hasAccount) { %><button type="button" class="quick-action is-primary" data-new-invoice><span class="quick-action-icon"><%- icon('invoice') %></span>Invoice</button><% } %>
                <a class="quick-action<%= hasAccount ? '' : ' is-primary' %>" href="/business/expense-log"><span class="quick-action-icon"><%- icon('receipt') %></span>Expenses</a>
                <% if (hasAccount) { %><a class="quick-action" href="/transfers?from=<%= primary ? primary.id : '' %>"><span class="quick-action-icon"><%- icon('send') %></span>Pay</a><% } %>
                <a class="quick-action" href="/business/team"><span class="quick-action-icon"><%- icon('users') %></span>Team</a>
            </div>
        </section>
        <section class="panel" aria-labelledby="upcomingTitle">
            <div class="panel-head"><h2 id="upcomingTitle">Upcoming</h2></div>
            <% if (dashboard.upcoming.length) { %>
            <ul class="list-plain" role="list">
                <% dashboard.upcoming.slice(0, 6).forEach(item => { %>
                <li class="list-row"><span class="icon-tile icon-tile-sm<%= item.direction === 'in' ? ' is-positive' : '' %>"><%- icon(item.kind === 'invoice' ? 'invoice' : 'calendar') %></span><span class="list-row-main"><span class="list-row-title"><%= item.label %></span><span class="list-row-sub"><%= item.direction === 'in' ? 'Due' : 'Scheduled' %> <%= formatDate(item.date) %><% if (item.overdue) { %> · <span class="status-pill is-overdue">Overdue</span><% } %></span></span><span class="list-row-end"><strong class="<%= item.direction === 'in' ? 'positive' : '' %>" data-private><%= item.direction === 'in' ? '+' : '−' %><%= money(item.amountCents, item.currency) %></strong></span></li>
                <% }) %>
            </ul>
            <% } else { %><p class="muted text-sm">No invoices due or payments scheduled.</p><% } %>
        </section>
        <section class="panel" aria-labelledby="bizAccountsTitle">
            <div class="panel-head"><h2 id="bizAccountsTitle">Business accounts</h2></div>
            <% if (hasAccount) { %>
            <ul class="account-rows" role="list">
                <% dashboard.accounts.forEach(account => { %><li><%- include('../partials/account-row', { account }) %></li><% }) %>
            </ul>
            <a class="btn btn-ghost btn-sm mt-3" href="/accounts/new?type=business"><%- icon('plus', 'icon-sm') %> Another business account</a>
            <% } else { %>
            <p class="muted text-sm">None yet.</p>
            <a class="btn btn-secondary btn-sm mt-3" href="/accounts/new?type=business"><%- icon('plus', 'icon-sm') %> Open business checking</a>
            <% } %>
        </section>
    </aside>
</div>
<p class="disclosure-note mt-8"><%- icon('info') %> <span>Figures come from your business accounts and the expenses you log — they aren’t an accounting report. Willow connects to no payroll, tax or accounting service.</span></p>
<% } %>

<% if (section === 'expenses') { %>
<div class="layout-main-aside">
    <section class="panel" aria-labelledby="expenseLogTitle">
        <div class="panel-head"><h2 id="expenseLogTitle">Expense log</h2>
            <div class="cluster"><label class="visually-hidden" for="expenseMonth">Month</label><select class="select select-sm" id="expenseMonth" data-expense-month></select><button type="button" class="btn btn-primary btn-sm" data-expense-new><%- icon('plus', 'icon-sm') %> Log</button></div>
        </div>
        <div class="stat-row is-compact mb-4" data-expense-totals hidden>
            <div class="stat-tile"><span class="label"><%- icon('receipt', 'icon-sm') %> Total</span><span class="figure" data-private data-expense-total>$0</span><small data-expense-count>0 expenses</small></div>
            <div class="stat-tile"><span class="label"><%- icon('tag', 'icon-sm') %> Largest category</span><span class="expense-top" data-expense-top>—</span><small data-expense-top-amount></small></div>
        </div>
        <div data-expense-list aria-live="polite"><div class="skeleton skeleton-block" style="height:180px"></div></div>
    </section>
    <aside class="col-stack">
        <section class="panel" aria-labelledby="bizBudgetsTitle" data-budgets data-scope="business">
            <div class="panel-head"><h2 id="bizBudgetsTitle">Budgets</h2><button type="button" class="btn btn-ghost btn-sm" data-budget-new><%- icon('plus', 'icon-sm') %> New</button></div>
            <div class="budget-grid is-stacked" data-budget-list aria-live="polite"></div>
        </section>
    </aside>
</div>
<p class="disclosure-note mt-8"><%- icon('info') %> <span>Log what the business spends — with or without a Willow account. Choosing “Pay from” takes the amount from that business account now; otherwise the expense is a record only. Business budgets are measured against this log and checked every night.</span></p>
<% } %>

<% if (section === 'invoices') { %>
<section class="panel" aria-labelledby="invoiceListTitle">
    <div class="panel-head"><h2 id="invoiceListTitle">Invoices</h2><button type="button" class="btn btn-primary btn-sm" data-new-invoice><%- icon('plus', 'icon-sm') %> New invoice</button></div>
    <% if (dashboard.invoices.length) { %>
    <div class="table-wrap">
        <table class="table invoice-table">
            <thead><tr><th scope="col">Invoice</th><th scope="col">Customer</th><th scope="col">Due</th><th scope="col">Status</th><th scope="col" class="text-right">Amount</th><th scope="col"><span class="visually-hidden">Actions</span></th></tr></thead>
            <tbody>
                <% dashboard.invoices.forEach(invoice => { %>
                <tr data-invoice-row="<%= invoice.id %>">
                    <td><strong class="mono"><%= invoice.number %></strong><% if (invoice.description) { %><small class="muted block"><%= invoice.description %></small><% } %></td>
                    <td><%= invoice.customer_name %><% if (invoice.customer_email) { %><small class="muted block"><%= invoice.customer_email %></small><% } %></td>
                    <td class="nowrap"><%= formatDate(invoice.due_on) %></td>
                    <td><span class="status-pill is-<%= invoice.displayStatus %>"><%= invoice.displayStatus %></span></td>
                    <td class="num" data-private><%= invoice.amountFormatted %></td>
                    <td class="nowrap text-right"><% if (invoice.status === 'open') { %><button type="button" class="btn btn-secondary btn-sm" data-invoice-pay="<%= invoice.id %>" data-invoice-number="<%= invoice.number %>">Mark paid</button> <button type="button" class="btn btn-ghost btn-sm" data-invoice-void="<%= invoice.id %>" data-invoice-number="<%= invoice.number %>">Void</button><% } %></td>
                </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
    <% } else { %>
    <div class="empty is-compact"><div class="empty-art"><%- icon('invoice') %></div><h3>No invoices yet</h3><p>Create an invoice to track money your customers owe you.</p><button type="button" class="btn btn-primary btn-sm" data-new-invoice>New invoice</button></div>
    <% } %>
    <p class="text-xs muted mt-4">Invoices aren’t sent to anyone. When your customer pays, mark the invoice paid to add the payment to your business account.</p>
</section>
<% } %>

<% if (section === 'team') { %>
<div class="layout-main-aside">
    <section class="panel" aria-labelledby="teamTitle">
        <div class="panel-head"><h2 id="teamTitle">Team</h2></div>
        <ul class="list-plain" role="list">
            <li class="list-row"><span class="avatar"><%= initials(user.full_name) %></span><span class="list-row-main"><span class="list-row-title"><%= user.full_name %> <span class="badge badge-brand">You</span></span><span class="list-row-sub"><%= user.email %></span></span><span class="list-row-end"><strong>Owner</strong></span></li>
            <% dashboard.team.forEach(member => { %>
            <li class="list-row"><span class="avatar"><%= initials(member.name) %></span><span class="list-row-main"><span class="list-row-title"><%= member.name %></span><span class="list-row-sub"><%= member.email %> · <%= (roles[member.role] || member.role) %></span></span><span class="status-pill is-pending">Invited</span><button type="button" class="btn btn-ghost btn-icon btn-sm" data-member-remove="<%= member.id %>" data-member-name="<%= member.name %>" aria-label="Remove <%= member.name %>"><%- icon('x') %></button></li>
            <% }) %>
        </ul>
        <p class="text-xs muted mt-4">Invitations are recorded only. In this demo, invitees receive no email and no access.</p>
    </section>
    <aside>
        <form class="panel" id="inviteForm" novalidate>
            <div class="panel-head"><h2>Invite someone</h2></div>
            <div class="field"><label for="memberName">Name</label><input class="input" id="memberName" name="name" required maxlength="80"></div>
            <div class="field"><label for="memberEmail">Email</label><input class="input" id="memberEmail" name="email" type="email" required maxlength="255" autocapitalize="none"></div>
            <fieldset class="option-stack role-options">
                <legend class="field-label">Role</legend>
                <% Object.entries(roles).forEach(([value, label], index) => { %>
                <label class="option-card is-compact"><input type="radio" name="role" value="<%= value %>"<%= index === 3 ? ' checked' : '' %>><span><strong><%= label %></strong><span class="option-desc"><%= roleText[value] %></span></span><span class="option-card-check" aria-hidden="true"></span></label>
                <% }) %>
            </fieldset>
            <p class="field-error mt-3" data-invite-error role="alert" hidden></p>
            <div class="form-actions"><button type="submit" class="btn btn-primary">Record invitation</button></div>
        </form>
    </aside>
</div>
<% } %>

<dialog class="modal" id="invoiceDialog" aria-labelledby="invoiceDialogTitle">
    <form id="invoiceForm" novalidate>
        <div class="modal-head"><h2 id="invoiceDialogTitle">New invoice</h2><button type="button" class="btn btn-ghost btn-icon" data-dialog-close aria-label="Close"><%- icon('x', 'icon-md') %></button></div>
        <div class="modal-body">
            <div class="field"><label for="invCustomer">Customer name</label><input class="input" id="invCustomer" name="customerName" required maxlength="80"></div>
            <div class="field"><label for="invEmail">Customer email <span class="optional">· optional</span></label><input class="input" id="invEmail" name="customerEmail" type="email" maxlength="255"></div>
            <div class="field"><label for="invDescription">Description</label><input class="input" id="invDescription" name="description" maxlength="160" placeholder="e.g. Brand design — phase 1"></div>
            <div class="field-grid">
                <div class="field"><label for="invAmount">Amount (USD)</label><div class="input-group has-prefix"><span class="input-prefix">$</span><input class="input num" id="invAmount" name="amount" inputmode="decimal" required></div></div>
                <div class="field"><label for="invDue">Due date</label><input class="input" id="invDue" name="dueOn" type="date" min="<%= today %>" value="<%= in30 %>" required></div>
            </div>
            <p class="field-error mt-3" data-invoice-error role="alert" hidden></p>
        </div>
        <div class="modal-foot"><button type="button" class="btn btn-secondary" data-dialog-close>Cancel</button><button type="submit" class="btn btn-primary">Create invoice</button></div>
    </form>
</dialog>

<dialog class="modal" id="profileDialog" aria-labelledby="profileDialogTitle">
    <form id="profileForm" novalidate>
        <div class="modal-head"><h2 id="profileDialogTitle">Business details</h2><button type="button" class="btn btn-ghost btn-icon" data-dialog-close aria-label="Close"><%- icon('x', 'icon-md') %></button></div>
        <div class="modal-body">
            <div class="field"><label for="bizName">Business name</label><input class="input" id="bizName" name="name" required maxlength="80" value="<%= profile ? profile.name : '' %>"></div>
            <div class="field"><label for="bizIndustry">Industry <span class="optional">· optional</span></label><input class="input" id="bizIndustry" name="industry" maxlength="60" value="<%= profile ? profile.industry : '' %>" placeholder="e.g. Design studio"></div>
            <div class="field"><label for="bizCountry">Country <span class="optional">· optional</span></label><input class="input" id="bizCountry" name="country" maxlength="56" value="<%= profile ? profile.country : '' %>"></div>
            <p class="field-error mt-3" data-profile-error role="alert" hidden></p>
        </div>
        <div class="modal-foot"><button type="button" class="btn btn-secondary" data-dialog-close>Cancel</button><button type="submit" class="btn btn-primary">Save</button></div>
    </form>
</dialog>

<dialog class="modal" id="expenseDialog" aria-labelledby="expenseDialogTitle">
    <form id="expenseForm" novalidate>
        <div class="modal-head"><h2 id="expenseDialogTitle">Log an expense</h2><button type="button" class="btn btn-ghost btn-icon" data-dialog-close aria-label="Close"><%- icon('x', 'icon-md') %></button></div>
        <div class="modal-body">
            <input type="hidden" name="id">
            <div class="field-grid">
                <div class="field"><label for="expVendor">Paid to</label><input class="input" id="expVendor" name="vendor" required maxlength="80" autocomplete="off" placeholder="Supplier or service"></div>
                <div class="field"><label for="expCategory">Category</label><select class="select" id="expCategory" name="category"><% categoryList.forEach(([key, label]) => { %><option value="<%= key %>"><%= label %></option><% }) %></select></div>
            </div>
            <div class="field-grid mt-5">
                <div class="field"><label for="expAmount">Amount (USD)</label><div class="input-group has-prefix"><span class="input-prefix">$</span><input class="input num" id="expAmount" name="amount" inputmode="decimal" required autocomplete="off"></div></div>
                <div class="field"><label for="expDate">Date</label><input class="input" id="expDate" name="spentOn" type="date" max="<%= today %>" value="<%= today %>" required></div>
            </div>
            <div class="field mt-5" data-expense-pay-field><label for="expAccount">Pay from</label><select class="select" id="expAccount" name="payFromAccountId">
                <option value="">Don’t take money from an account (record only)</option>
                <% activeUsd.forEach(account => { %><option value="<%= account.id %>"><%= account.displayName %> · <%= money(account.available_balance, account.currency) %> available</option><% }) %>
            </select></div>
            <div class="field mt-5"><label for="expNote">Note <span class="optional">· optional</span></label><input class="input" id="expNote" name="note" maxlength="200" autocomplete="off"></div>
            <p class="field-error mt-3" data-expense-error role="alert" hidden></p>
        </div>
        <div class="modal-foot"><button type="button" class="btn btn-ghost btn-danger-text" data-expense-delete hidden>Delete</button><button type="button" class="btn btn-secondary" data-dialog-close>Cancel</button><button type="submit" class="btn btn-primary">Save expense</button></div>
    </form>
</dialog>

<% if (section === 'expenses') { %><%- include('../partials/budget-dialog', { scope: 'business' }) %><% } %>

<script type="application/json" id="businessData"><%- JSON.stringify(chartData).replace(/</g, '\\u003c') %></script>
<%- include('../partials/app-end', { js: section === 'expenses' ? ['business', 'budgets', 'business-expenses'] : ['business'] }) %>
