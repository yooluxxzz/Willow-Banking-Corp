<%- include('../partials/app-start', { css: [] }) %>

<header class="page-head">
    <div class="page-head-copy">
        <h1 class="page-head-title">Notifications</h1>
        <p class="page-head-sub">Payments, card changes, security and portfolio updates. Choose what you get in <a class="text-link" href="/settings#alerts">Settings</a>.</p>
    </div>
    <div class="page-head-actions"><button type="button" class="btn btn-secondary" data-read-all disabled><%- icon('check', 'icon-sm') %> Mark all as read</button></div>
</header>

<div class="segmented mb-6" role="tablist" aria-label="Filter notifications">
    <button type="button" role="tab" aria-selected="true" aria-controls="notificationsPanel" data-filter="all">All</button>
    <button type="button" role="tab" aria-selected="false" aria-controls="notificationsPanel" data-filter="unread" tabindex="-1">Unread</button>
</div>

<section class="panel" id="notificationsPanel" role="tabpanel" aria-labelledby="listTitle">
    <h2 class="visually-hidden" id="listTitle">Notification list</h2>
    <div data-notification-list aria-live="polite"></div>
    <div class="pagination" data-notification-more hidden><button type="button" data-load-more>Show more</button></div>
</section>

<%- include('../partials/app-end', { js: ['notifications'] }) %>
