<%
  const groups = [
    { key: 'everyday', title: 'Everyday', text: 'Checking accounts for spending, bills and payments.', match: account => account.kind === 'checking' },
    { key: 'savings', title: 'Savings', text: 'Money set aside, kept apart from everyday spending.', match: account => account.kind === 'savings' },
    { key: 'currency', title: 'Currencies', text: 'Hold and spend in EUR, GBP, MZN and ZAR.', match: account => account.kind === 'currency' },
    { key: 'business', title: 'Business', text: 'Operating accounts for your business.', match: account => account.kind === 'business' },
  ];
  const open = accounts.filter(account => account.status === 'active' || account.status === 'frozen');
  const closed = accounts.filter(account => !open.includes(account));
  const savingsTotal = accounts.filter(account => account.kind === 'savings' && account.status === 'active').reduce((sum, account) => sum + account.balance, 0);
%><%- include('../partials/app-start', { css: [] }) %>

<header class="page-head">
    <div class="page-head-copy">
        <h1 class="page-head-title">Accounts</h1>
        <p class="page-head-sub">Everything you hold with Willow, in one place.</p>
    </div>
    <div class="page-head-actions">
        <a class="btn btn-secondary" href="/statements"><%- icon('file') %> Statements</a>
        <a class="btn btn-primary" href="/accounts/new"><%- icon('plus') %> Open an account</a>
    </div>
</header>

<div class="stat-row mb-8">
    <div class="stat-tile"><span class="label"><%- icon('wallet', 'icon-sm') %> Total in USD</span><span class="figure" data-private><%= totals.totalFormatted %></span><small data-private><%= totals.availableFormatted %> available</small></div>
    <div class="stat-tile"><span class="label"><%- icon('savings', 'icon-sm') %> Savings</span><span class="figure" data-private><%= money(savingsTotal) %></span><small>Across USD savings accounts</small></div>
    <div class="stat-tile"><span class="label"><%- icon('globe', 'icon-sm') %> Other currencies</span>
        <% if (totals.foreign.length) { %><span class="figure" data-private><%= totals.foreign[0].totalFormatted %></span><small data-private><%= totals.foreign.slice(1).map(row => row.totalFormatted).join(' · ') || totals.foreign[0].currency + ' balance' %></small>
        <% } else { %><span class="figure muted">—</span><small><a class="text-link" href="/accounts/new?type=currency">Open a currency account</a></small><% } %>
    </div>
    <div class="stat-tile"><span class="label"><%- icon('layers', 'icon-sm') %> Accounts</span><span class="figure"><%= open.length %></span><small><%= 10 - accounts.length > 0 ? `${10 - accounts.length} more available in the demo` : 'Demo account limit reached' %></small></div>
</div>

<% if (!accounts.length) { %>
<div class="panel"><div class="empty"><div class="empty-art"><%- icon('wallet') %></div><h3>No accounts yet</h3><p>Open a checking account to start using Willow.</p><a class="btn btn-primary btn-sm" href="/accounts/new">Open an account</a></div></div>
<% } %>

<div class="account-groups">
<% groups.forEach(group => { const items = open.filter(group.match); if (!items.length) return; const groupTotal = items.filter(item => item.status === 'active').reduce((sum, item) => sum + item.balance, 0); const groupCurrency = items[0].currency; const mixed = items.some(item => item.currency !== groupCurrency); %>
<section class="panel account-group-panel" aria-labelledby="group-<%= group.key %>">
    <div class="panel-head">
        <div><h2 id="group-<%= group.key %>"><%= group.title %></h2><p class="text-sm muted"><%= group.text %></p></div>
        <% if (!mixed) { %><strong class="num" data-private><%= money(groupTotal, groupCurrency) %></strong><% } %>
    </div>
    <ul class="account-rows" role="list">
        <% items.forEach(account => { %><li><%- include('../partials/account-row', { account }) %></li><% }) %>
    </ul>
</section>
<% }) %>
</div>

<section class="account-group" aria-labelledby="group-new">
    <div class="section-heading"><h2 id="group-new">Add an account</h2></div>
    <div class="product-picks">
        <a class="product-pick" href="/accounts/new?type=checking"><span class="icon-tile"><%- icon('wallet') %></span><span><strong>Checking</strong><small>For everyday spending</small></span></a>
        <a class="product-pick" href="/accounts/new?type=savings"><span class="icon-tile"><%- icon('savings') %></span><span><strong>Savings</strong><small>Keep money apart for later</small></span></a>
        <a class="product-pick" href="/accounts/new?type=currency"><span class="icon-tile"><%- icon('globe') %></span><span><strong>Currency account</strong><small>EUR, GBP, MZN or ZAR</small></span></a>
        <a class="product-pick" href="/accounts/new?type=business"><span class="icon-tile"><%- icon('briefcase') %></span><span><strong>Business checking</strong><small>Invoices, expenses, team</small></span></a>
    </div>
</section>

<% if (closed.length) { %>
<section class="account-group" aria-labelledby="group-closed">
    <div class="section-heading"><h2 id="group-closed">Closed</h2></div>
    <ul class="account-rows panel" role="list">
        <% closed.forEach(account => { %><li><%- include('../partials/account-row', { account }) %></li><% }) %>
    </ul>
</section>
<% } %>

<p class="disclosure-note mt-8"><%- icon('info') %> <span>All Willow accounts are simulated. Balances aren’t deposits, earn no real interest and have no deposit insurance.</span></p>

<%- include('../partials/app-end') %>
