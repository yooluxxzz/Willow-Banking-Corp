<%
  const code = typeof status !== 'undefined' ? status : 404;
  const headingText = typeof heading !== 'undefined' ? heading : (typeof title !== 'undefined' ? title : 'Something went wrong.');
  const bodyText = typeof message !== 'undefined' ? message : 'An unexpected error occurred.';
  const signedIn = typeof user !== 'undefined' && user;
%><%- include('partials/head', { css: ['site'], bodyClass: 'error-body', noIndex: true }) %>
<main id="main" class="error-page">
    <div class="error-card">
        <%- include('partials/brand', { href: signedIn ? '/dashboard' : '/', inverse: false, label: 'Willow home' }) %>
        <p class="error-code num" aria-hidden="true"><%= code %></p>
        <h1 class="h3"><%= headingText %></h1>
        <p class="secondary"><%= bodyText %></p>
        <div class="cluster error-actions">
            <% if (signedIn) { %>
                <a class="btn btn-primary" href="/dashboard">Back to Willow <%- icon('arrow-right', 'icon-arrow') %></a>
            <% } else { %>
                <a class="btn btn-primary" href="/">Willow home <%- icon('arrow-right', 'icon-arrow') %></a>
            <% } %>
            <a class="btn btn-secondary" href="/help">Help center</a>
        </div>
        <p class="error-note"><span class="demo-badge">Demo</span> Willow is a fictional bank. No real money was affected.</p>
    </div>
</main>
<%- include('partials/foot') %>
