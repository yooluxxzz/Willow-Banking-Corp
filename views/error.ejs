<%- include('partials/header') %>

    <body style="background:var(--off-white);display:flex;align-items:center;justify-content:center;min-height:100vh;">
        <div style="text-align:center;max-width:400px;padding:var(--space-6);">
            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none"
                stroke="var(--gray-400)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"
                style="margin:0 auto var(--space-4);">
                <circle cx="12" cy="12" r="10" />
                <line x1="12" x2="12" y1="8" y2="12" />
                <line x1="12" x2="12.01" y1="16" y2="16" />
            </svg>
            <h1 style="font-size:1.375rem;margin-bottom:var(--space-2);">
                <%= typeof title !=='undefined' ? title : 'Error' %>
            </h1>
            <p style="color:var(--gray-600);margin-bottom:var(--space-6);">
                <%= typeof message !=='undefined' ? message : 'An unexpected error occurred.' %>
            </p>
            <a href="/" class="btn btn-primary">Go Home</a>
        </div>
    </body>

    </html>