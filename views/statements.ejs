<%- include('partials/header') %>
<body class="banking-workspace"><div class="app-layout"><%- include('partials/sidebar') %><main class="main-content workspace-main"><p class="workspace-eyebrow">YOUR WILLOW / YOUR RECORDS</p>
<div class="page-header"><h1>Account statements</h1><p>Review completed transactions and download a PDF for your records.</p></div>
<div class="card"><div class="card-body"><p class="mb-4 text-muted">Demo statements show simulated funds, not proof of real funds. Dates use UTC; pending and failed transactions are excluded.</p>
<form id="statementForm"><div class="form-row"><div class="form-group"><label for="stmtAccount">Account</label><select id="stmtAccount" name="accountId" class="form-control" required><% accounts.forEach(a => { %><option value="<%= a.id %>" <%= a.id === selectedAccountId ? 'selected' : '' %>><%= a.displayName %> (<%= a.maskedNumber %>)</option><% }) %></select></div>
<div class="form-group"><label for="statementPreset">Date range</label><select id="statementPreset" class="form-control"><option value="current">This month</option><option value="previous">Last month</option><option value="year">This year</option><option value="custom">Custom dates</option></select></div></div>
<div class="form-row"><div class="form-group"><label for="stmtFrom">From date</label><input type="date" name="dateFrom" id="stmtFrom" class="form-control" required></div><div class="form-group"><label for="stmtTo">To date</label><input type="date" name="dateTo" id="stmtTo" class="form-control" required></div></div>
<p class="text-sm text-muted mb-4">Choose up to 366 days. For more than 5,000 transactions, use a shorter range.</p>
<div class="settings-actions"><button class="btn btn-primary" type="submit" <%= accounts.length ? '' : 'disabled' %>>View statement</button><button class="btn btn-secondary" id="downloadStatement" type="button" <%= accounts.length ? '' : 'disabled' %>>Download PDF</button></div>
</form><p id="statementStatus" role="status" aria-live="polite" class="mt-4"><%= accounts.length ? '' : 'No accounts available for statements.' %></p></div></div>
<div id="stmtResult" class="mt-6"></div>
</main></div><script src="/js/statements.js" defer></script><%- include('partials/footer') %>
