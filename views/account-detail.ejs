<%- include('partials/header') %>
<body class="banking-workspace"><div class="app-layout"><%- include('partials/sidebar') %>
<main class="main-content workspace-main"><p class="workspace-eyebrow">YOUR WILLOW / ACCOUNT DETAILS</p>
    <div class="page-header"><a href="/accounts">← All accounts</a><h1 id="accountName"><%= account.displayName %></h1><p><%= account.account_type %> · <%= account.maskedNumber %> · <%= account.status %></p></div>
    <div class="settings-grid mb-6">
        <section class="card account-detail-balance"><div class="card-header"><h2>Account overview</h2></div><div class="card-body">
            <p class="text-muted">Current balance</p><div class="account-balance"><%= account.balanceFormatted %></div>
            <p>Available: <strong><%= account.availableBalanceFormatted %></strong></p>
            <p class="text-sm text-muted">Currency: <%= account.currency %> · Opened <%= account.created_at.slice(0,10) %></p>
            <details class="mt-4"><summary>Show account number</summary><p class="font-mono"><%= account.account_number %></p></details>
            <p class="mt-4"><a href="/transactions?accountId=<%= account.id %>">View all activity →</a> · <a href="/statements?accountId=<%= account.id %>">Statements →</a></p>
        </div></section>
        <section class="card"><div class="card-header"><h2>Make it yours</h2></div><div class="card-body">
            <form id="accountNameForm" data-account-id="<%= account.id %>">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="form-group"><label for="nickname">Account name</label><input class="form-control" id="nickname" name="nickname" maxlength="40" value="<%= account.nickname || '' %>" placeholder="For example, Everyday spending" aria-describedby="nicknameHelp"><p id="nicknameHelp" class="form-hint">Up to 40 characters. Leave blank to restore the default name.</p></div>
                <p id="accountNameStatus" class="settings-feedback" role="status" tabindex="-1" hidden></p>
                <button class="btn btn-primary" type="submit">Save account name</button>
            </form>
        </div></section>
    </div>
    <section class="card"><div class="card-header"><h2>Recent activity</h2><a href="/transactions?accountId=<%= account.id %>">All <%= recent.total %> transactions →</a></div>
    <% if (!recent.transactions.length) { %><div class="empty-state"><h3>No activity yet</h3><p>Transactions for this account will appear here.</p></div><% } else { %>
    <div class="table-responsive"><table aria-label="Recent account activity"><thead><tr><th>Date</th><th>Description</th><th>Status</th><th class="text-right">Amount</th></tr></thead><tbody>
    <% recent.transactions.forEach(t => { %><tr><td><%= t.created_at.slice(0,10) %></td><td><%= t.description || t.type %></td><td><%= t.status %></td><td class="text-right"><%= t.direction === 'credit' ? '+' : '−' %><%= t.amountFormatted %></td></tr><% }) %>
    </tbody></table></div><% } %></section>
</main></div><script src="/js/account-detail.js" defer></script><%- include('partials/footer') %>
