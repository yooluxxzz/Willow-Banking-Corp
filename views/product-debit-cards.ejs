<%- include('partials/header') %>

    <body class="public-page">
        <%- include('partials/public-nav') %>

            <main class="info-page">
                <div class="info-inner">
                    <h1>Debit Cards</h1>
                    <p class="info-sub">One card, total control. Your Willow Visa debit card puts your money to work in
                        the real world — safely.</p>

                    <section class="info-section">
                        <h2>About the Willow Debit Card</h2>
                        <p>Every Willow account comes with a Visa debit card linked directly to your checking account.
                            Use it anywhere Visa is accepted — online, at the point of sale, or at ATMs. You're always
                            in control: freeze it, unfreeze it, or report it lost from your dashboard in seconds.</p>
                    </section>

                    <section class="info-section">
                        <h2>Features &amp; Benefits</h2>
                        <div class="info-grid">
                            <div class="info-card">
                                <h3>Instant Freeze &amp; Unfreeze</h3>
                                <p>Lost your card in the sofa? Freeze it immediately from the Cards page. Found it?
                                    Unfreeze in one click.</p>
                            </div>
                            <div class="info-card">
                                <h3>Accepted Worldwide</h3>
                                <p>Accepted wherever Visa is — millions of merchants worldwide and all major online
                                    retailers.</p>
                            </div>
                            <div class="info-card">
                                <h3>Real-Time Notifications</h3>
                                <p>Get an instant alert every time your card is used, keeping you aware of every
                                    transaction.</p>
                            </div>
                            <div class="info-card">
                                <h3>Report Lost or Stolen</h3>
                                <p>Report a lost or stolen card directly from your dashboard. A replacement will be
                                    dispatched immediately.</p>
                            </div>
                            <div class="info-card">
                                <h3>Secure by Default</h3>
                                <p>3D Secure authentication on all online purchases. Your card details are never stored
                                    unsafely.</p>
                            </div>
                            <div class="info-card">
                                <h3>No Annual Fee</h3>
                                <p>Your Willow debit card is completely free — no annual fees, no replacement fees, no
                                    surprise charges.</p>
                            </div>
                        </div>
                    </section>

                    <section class="info-section">
                        <h2>Managing your card</h2>
                        <div class="timeline">
                            <div class="timeline-item">
                                <span class="timeline-year">View</span>
                                <div>
                                    <h4>See your card details</h4>
                                    <p>View your card number, expiry, and type from the Cards section of your dashboard.
                                    </p>
                                </div>
                            </div>
                            <div class="timeline-item">
                                <span class="timeline-year">Control</span>
                                <div>
                                    <h4>Freeze or unfreeze</h4>
                                    <p>Temporarily disable all card transactions with one button — no call centre
                                        required.</p>
                                </div>
                            </div>
                            <div class="timeline-item">
                                <span class="timeline-year">Replace</span>
                                <div>
                                    <h4>Request a replacement</h4>
                                    <p>If your card is lost or damaged, request a replacement from within the app
                                        instantly.</p>
                                </div>
                            </div>
                        </div>
                    </section>

                    <section class="info-cta">
                        <h2>Get your Willow Debit Card</h2>
                        <p>Open an account and your card is included — completely free.</p>
                        <a href="/register" class="btn btn-primary btn-lg">Open an Account</a>
                    </section>
                </div>
            </main>

            <%- include('partials/public-footer') %>
    </body>

    </html>