# Willow Banking Corp — Environment Variables
# Copy this file to .env and fill in values

# Server
PORT=3000
NODE_ENV=development

# Session secret — generate a long random string
SESSION_SECRET=change-me-to-a-random-secret-at-least-32-characters

# Admin account — set these before first run to create the admin user
ADMIN_EMAIL=admin@willowbank.com
ADMIN_PASSWORD=change-me-to-a-strong-password

# Database path (relative to project root)
DATABASE_PATH=./data/willow.db

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=10
