# Willow — example configuration. Copy to .env and fill in your own values.
# Never commit a real .env file. All money in Willow is simulated, and every balance
# starts at zero until the customer adds money.

PORT=3000
NODE_ENV=development

# Required in production. Use a long random value, e.g. `openssl rand -hex 32`.
SESSION_SECRET=change-me
# Signed-in sessions end after this many idle minutes (0 disables). Default 30.
SESSION_IDLE_MINUTES=30
# Guest profiles unused for this many days are deleted (0 keeps them). Default 7.
GUEST_RETENTION_DAYS=7
# Optional separate key for encrypting two-step verification secrets (defaults to SESSION_SECRET).
TWO_FACTOR_KEY=

# The admin account is created on first start from these values.
ADMIN_EMAIL=admin@example.test
ADMIN_PASSWORD=

DATABASE_PATH=./data/willow.db
# SQL snapshot that can be committed to Git (`npm run db:save` / `npm run db:restore -- --force`).
# It holds hashed passwords and everything customers entered: keep the repository private.
DATABASE_SNAPSHOT_PATH=./data/willow-snapshot.sql
# Restore the snapshot automatically when no database file exists yet.
SNAPSHOT_AUTO_RESTORE=true
# Local time (24-hour HH:MM) for the nightly budget check and net-worth snapshot.
# Missed days are caught up when Willow starts.
NIGHTLY_CHECK_TIME=23:55
OPEN_BROWSER=false

# Rate limits (per IP, per window)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=10
API_RATE_LIMIT_MAX=240
PUBLIC_API_RATE_LIMIT_MAX=60

# Demo ledger limits, in cents (USD; other currencies are scaled)
DAILY_DEPOSIT_LIMIT_CENTS=1000000
DAILY_WITHDRAWAL_LIMIT_CENTS=1000000
DAILY_TRANSFER_LIMIT_CENTS=2500000

# Market data: auto (yfinance service, then Yahoo chart fallback) | service | yahoo-chart
MARKET_DATA_PROVIDER=auto
MARKET_DATA_SERVICE_URL=http://127.0.0.1:8765
MARKET_DATA_TIMEOUT_MS=12000
# Shared secret sent to the Python market-data service. Generated automatically when
# Willow starts the service itself; set it only if you run the service separately.
MARKET_DATA_TOKEN=
# Start the Python service with Willow when it isn't already running (local URLs only).
MARKET_SERVICE_AUTOSTART=true
# Python interpreter to use (default: python3, then python). It needs yfinance:
#   python3 -m pip install -r market-data-service/requirements.txt
PYTHON=
# Set to "quiet" to hide the service's log lines in Willow's console.
MARKET_SERVICE_LOG=

# Python market-data service (market-data-service/server.py)
MARKET_DATA_HOST=127.0.0.1
MARKET_DATA_PORT=8765
MARKET_DATA_LOG_LEVEL=WARNING

# Local assistant through Ollama (https://ollama.com), e.g. `ollama pull llama3.2`.
# It only appears while Ollama is reachable. Nothing is sent off this computer.
ASSISTANT_ENABLED=true
OLLAMA_URL=http://127.0.0.1:11434
# Empty: the first model installed in Ollama.
OLLAMA_MODEL=
OLLAMA_TIMEOUT_MS=120000
