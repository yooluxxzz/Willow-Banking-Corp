{
    "name": "willow-banking-corp",
    "version": "1.0.0",
    "description": "Willow Banking Corp — Full-stack fictional banking system",
    "main": "server.js",
    "scripts": {
        "start": "node server.js",
        "dev": "node --watch server.js",
        "market-service": "python3 market-data-service/server.py",
        "seed": "node src/seed.js",
        "test": "node --test tests/*.test.js",
        "test:python": "python3 -m unittest discover -s market-data-service/tests",
        "test:all": "npm test && npm run test:python"
    },
    "keywords": [
        "banking",
        "finance",
        "demo"
    ],
    "license": "MIT",
    "dependencies": {
        "bcryptjs": "^2.4.3",
        "dotenv": "^16.4.7",
        "ejs": "^3.1.10",
        "express": "^4.21.2",
        "express-rate-limit": "^7.5.0",
        "express-session": "^1.18.1",
        "pdfkit": "^0.16.0",
        "qrcode": "^1.5.4",
        "sql.js": "^1.12.0",
        "uuid": "^11.1.0"
    },
    "devDependencies": {
        "jsdom": "^24.1.3",
        "supertest": "^7.0.0"
    }
}
