{
    "name": "willow-banking-corp",
    "version": "1.0.0",
    "private": true,
    "description": "Willow Banking Corp — a full-stack demo bank: accounts, payments, budgets, net worth, investing and a local AI assistant. No real money moves.",
    "main": "server.js",
    "engines": {
        "node": ">=20.19"
    },
    "scripts": {
        "start": "node server.js",
        "dev": "node --watch server.js",
        "test": "node --test",
        "test:coverage": "node --test --experimental-test-coverage --test-coverage-exclude=\"tests/**\"",
        "test:python": "node scripts/python.js -m unittest discover -s market-data-service/tests",
        "test:all": "npm test && npm run test:python",
        "lint": "eslint .",
        "check": "npm run lint && npm test",
        "setup:python": "node scripts/python.js -m pip install -r market-data-service/requirements.txt",
        "market-service": "node scripts/python.js market-data-service/server.py",
        "assistant:check": "node scripts/assistant-check.js",
        "db:save": "node scripts/db.js save",
        "db:restore": "node scripts/db.js restore"
    },
    "keywords": [
        "banking",
        "finance",
        "demo"
    ],
    "license": "MIT",
    "dependencies": {
        "bcryptjs": "^2.4.3",
        "dotenv": "^16.4.7",
        "ejs": "^3.1.10",
        "express": "^4.21.2",
        "express-rate-limit": "^7.5.0",
        "express-session": "^1.18.1",
        "pdfkit": "^0.20.2",
        "qrcode": "^1.5.4",
        "sql.js": "^1.12.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "eslint": "^10.12.0",
        "globals": "^17.13.0",
        "jsdom": "^29.1.1",
        "supertest": "^7.0.0"
    }
}
